+interface BarTuning {
+  /** Angle of this bar around the focus circle, in radians. */
+  angle: number;
+  /** Relative share of the budget. Above 1 sits taller on average. */
+  bias: number;
+  /** Wobble period in ms. The three are non-harmonic. */
+  wobblePeriod: number;
+  wobblePhase: number;
+}
+
+// One mic, one volume. Volume sets a height budget for the three bars and a
+// drifting focus decides how the budget is shared, so when one bar rises the
+// others drop and the peak travels between bars. Bars sit 120 degrees apart, so
+// the cosine weights always sum to 3 before the bias is normalized out.
+const BARS: readonly [BarTuning, BarTuning, BarTuning] = [
+  { angle: 0, bias: 1, wobblePeriod: 230, wobblePhase: 0 },
+  { angle: (Math.PI * 2) / 3, bias: 1.15, wobblePeriod: 310, wobblePhase: 2.1 },
+  { angle: (Math.PI * 4) / 3, bias: 1, wobblePeriod: 270, wobblePhase: 4.2 },
+];
+const BIAS_SUM = BARS[0].bias + BARS[1].bias + BARS[2].bias;
+/** Average multiplier on the volume part of a bar's height. */
+const VOLUME_GAIN = 1.05;
+/** How strongly the focus bar takes the budget from the others, 0..1. */
+const MAX_SHARE = 0.8;
+/** Peak per-bar wobble as a fraction of the bar's height. */
+const MAX_WOBBLE = 0.08;
+/** Volume at which share and wobble reach their maximum. */
+const MOTION_FULL_AT = 0.3;
+/** Focus drift speed in radians per second: calm when quiet, quicker when loud. */
+const DRIFT_BASE = 2.5;
+const DRIFT_PER_VOLUME = 9;
+/** A second, slower phase bends the drift so it reverses and never visibly repeats. */
+const DRIFT_SWAY_RATIO = 0.618;
+const DRIFT_SWAY = 1.4;
+/** Below this volume the idle pulse fades in. */
+const IDLE_PULSE_FADE = 0.05;
+const TWO_PI = Math.PI * 2;
+
+interface BarStyleInput {
+  bar: BarTuning;
+  size: MeterSize;
+  volume: SharedValue<number>;
+  /** Frame timestamp in ms, for the wobble. */
+  clock: SharedValue<number>;
+  /** Accumulated focus drift phase in radians. */
+  drift: SharedValue<number>;
+  idlePulse: SharedValue<number>;
+  isMuted: boolean;
+  isSpeaking: boolean;
+  reduceMotion: boolean;
+}
+
+function useBarStyle({
+  bar,
+  size,
+  volume,
+  clock,
+  drift,
+  idlePulse,
+  isMuted,
+  isSpeaking,
+  reduceMotion,
+}: BarStyleInput) {
+  return useAnimatedStyle(() => {
+    let baseOpacity: number;
+    if (isMuted) baseOpacity = 0.3;
+    else if (isSpeaking) baseOpacity = 0.9;
+    else baseOpacity = 0.5;
+    const currentVolume = isMuted ? 0 : volume.value;
+    const volumeHeight = size.volumeRange * currentVolume * VOLUME_GAIN;
+
+    let height = size.minHeight + volumeHeight;
+    if (!isMuted && !reduceMotion) {
+      const phase = drift.value;
+      const strength = Math.min(1, currentVolume / MOTION_FULL_AT);
+      const focus = phase + DRIFT_SWAY * Math.sin(phase * DRIFT_SWAY_RATIO);
+      const share =
+        ((1 + MAX_SHARE * strength * Math.cos(focus - bar.angle)) * bar.bias * 3) / BIAS_SUM;
+      const wobble =
+        1 +
+        MAX_WOBBLE *
+          strength *
+          Math.sin((TWO_PI * clock.value) / bar.wobblePeriod + bar.wobblePhase);
+      const idleWeight = Math.max(0, 1 - currentVolume / IDLE_PULSE_FADE);
+      const idle = 1 + (idlePulse.value - 1) * idleWeight;
+      height = (size.minHeight + volumeHeight * share) * wobble * idle;
+    }
+
+    const volumeBoost = isMuted || !isSpeaking ? 0 : currentVolume * 0.3;
+    return {
+      height: Math.min(size.maxHeight, Math.max(size.minHeight, height)),
+      opacity: baseOpacity + volumeBoost,
+    };
+  });
+}
+
+function startIdlePulse(pulse: SharedValue<number>, delay: number, peak: number, duration: number) {
+  pulse.value = withRepeat(
+    withSequence(
+      withTiming(1, { duration: delay }),
+      withTiming(peak, { duration, easing: Easing.inOut(Easing.ease) }),
+      withTiming(1, { duration, easing: Easing.inOut(Easing.ease) }),
+    ),
+    -1,
+    false,
+  );
+}
