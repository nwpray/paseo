+interface Syllable {
+  startedAt: number;
+  duration: number;
+  peak: number;
+  /** Silence after this syllable: a short dip, or a word gap. */
+  gap: number;
+}
+
+function randomBetween(min: number, max: number): number {
+  return min + Math.random() * (max - min);
+}
+
+function nextSyllable(startedAt: number, level: number): Syllable {
+  const endsWord = Math.random() < 0.3;
+  return {
+    startedAt,
+    duration: randomBetween(110, 260),
+    peak: level * randomBetween(0.55, 1.35),
+    gap: endsWord ? randomBetween(220, 520) : randomBetween(30, 90),
+  };
+}
+
+// Fast attack, slower decay, like a voiced syllable.
+function syllableEnvelope(progress: number): number {
+  if (progress < 0.2) return progress / 0.2;
+  return Math.max(0, 1 - (progress - 0.2) / 0.8) ** 0.7;
+}
+
+function speechLevel(syllable: Syllable, now: number, level: number): number {
+  const elapsed = now - syllable.startedAt;
+  const floor = level * 0.06;
+  if (elapsed >= syllable.duration) return floor;
+  const flutter = 1 + (Math.random() - 0.5) * 0.25;
+  return floor + syllable.peak * syllableEnvelope(elapsed / syllable.duration) * flutter;
+}
 
