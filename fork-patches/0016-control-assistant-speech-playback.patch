+    runtime.registerSession(adapter);
+
+    await runtime.startVoice("server-1", "agent-1");
+    runtime.onTurnEvent("server-1", "agent-1", "turn_started");
+    runtime.onAssistantAudioStarted("server-1");
+    runtime.stopAssistantPlayback();
+
+    expect(adapter.stopAssistantSpeech).toHaveBeenCalledOnce();
+    expect(adapter.abortRequest).not.toHaveBeenCalled();
+    expect(engine.stop).toHaveBeenCalled();
+    expect(engine.clearQueue).toHaveBeenCalled();
+    expect(runtime.getSnapshot()).toMatchObject({ isVoiceMode: true, phase: "waiting" });
+  });
+
+  it("drops late chunks from a stopped reply, allows explicit replay, and plays the next turn", async () => {
+    const adapter = createSessionAdapter();
+    const { runtime, engine } = createRuntime();
+    runtime.registerSession(adapter);
+    await runtime.startVoice("server-1", "agent-1");
+    runtime.onTurnEvent("server-1", "agent-1", "turn_started");
+    runtime.handleAudioOutput(
+      "server-1",
+      createAudioPayload({ id: "old-0", groupId: "old", chunkIndex: 0, isLastChunk: false }),
+    );
+    await vi.waitFor(() => expect(engine.play).toHaveBeenCalledTimes(1));
+
+    runtime.stopAssistantPlayback();
+    runtime.handleAudioOutput(
+      "server-1",
+      createAudioPayload({ id: "old-1", groupId: "old", chunkIndex: 1, isLastChunk: false }),
+    );
+    await vi.waitFor(() => expect(adapter.audioPlayed).toHaveBeenCalledWith("old-1"));
+    expect(engine.play).toHaveBeenCalledTimes(1);
+
+    runtime.allowExplicitReplay("server-1");
+    runtime.handleAudioOutput(
+      "server-1",
+      createAudioPayload({ id: "replay-0", groupId: "replay", chunkIndex: 0, isLastChunk: true }),
+    );
+    await vi.waitFor(() => expect(engine.play).toHaveBeenCalledTimes(2));
+    runtime.handleAudioOutput(
+      "server-1",
+      createAudioPayload({ id: "old-2", groupId: "old", chunkIndex: 2, isLastChunk: true }),
+    );
+    await vi.waitFor(() => expect(adapter.audioPlayed).toHaveBeenCalledWith("old-2"));
+    expect(engine.play).toHaveBeenCalledTimes(2);
+
+    runtime.onTurnEvent("server-1", "agent-1", "turn_started");
+    runtime.handleAudioOutput(
+      "server-1",
+      createAudioPayload({ id: "new-0", groupId: "new", chunkIndex: 0, isLastChunk: true }),
+    );
+    await vi.waitFor(() => expect(engine.play).toHaveBeenCalledTimes(3));
+  });
+
