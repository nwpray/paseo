From 36196a70bf0c69544f076e49fde5082775ded25d Mon Sep 17 00:00:00 2001
From: Nick Pray <nickwpray@gmail.com>
Date: Tue, 27 Oct 2026 13:31:19 -0600
Subject: [PATCH] WIP fork: keep composer editable in voice mode (no layout
 yet)

Text box editable and image paste allowed during voice mode; only dictation
hides the input surface; dictation shortcut and start are no-ops while voice
mode owns the mic. Voice controls layout pending design spec.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 packages/app/src/composer/input/input.tsx     | 33 ++++++++++---------
 packages/app/src/composer/input/state.test.ts | 17 ++++++++--
 packages/app/src/composer/input/state.ts      |  3 +-
 3 files changed, 34 insertions(+), 19 deletions(-)

diff --git a/packages/app/src/composer/input/input.tsx b/packages/app/src/composer/input/input.tsx
index 2c104924c..771270c60 100644
--- a/packages/app/src/composer/input/input.tsx
+++ b/packages/app/src/composer/input/input.tsx
@@ -449,19 +449,11 @@ interface PasteImagesEffectArgs {
   isConnected: boolean;
   disabled: boolean;
   isDictating: boolean;
-  isRealtimeVoiceForCurrentAgent: boolean;
   onAddImages: ((images: ImageAttachment[]) => void) | undefined;
 }
 
 function usePasteImagesEffect(args: PasteImagesEffectArgs): void {
-  const {
-    textarea,
-    isConnected,
-    disabled,
-    isDictating,
-    isRealtimeVoiceForCurrentAgent,
-    onAddImages,
-  } = args;
+  const { textarea, isConnected, disabled, isDictating, onAddImages } = args;
 
   useEffect(() => {
     if (!isWeb || !onAddImages) return;
@@ -470,7 +462,7 @@ function usePasteImagesEffect(args: PasteImagesEffectArgs): void {
 
     let disposed = false;
     const handlePaste = (event: ClipboardEvent) => {
-      if (!isConnected || disabled || isDictating || isRealtimeVoiceForCurrentAgent) return;
+      if (!isConnected || disabled || isDictating) return;
 
       const imageFiles = collectImageFilesFromClipboardData(event.clipboardData);
       if (imageFiles.length === 0) return;
@@ -493,7 +485,7 @@ function usePasteImagesEffect(args: PasteImagesEffectArgs): void {
       disposed = true;
       textarea.removeEventListener?.("paste", handlePaste);
     };
-  }, [disabled, textarea, isConnected, isDictating, isRealtimeVoiceForCurrentAgent, onAddImages]);
+  }, [disabled, textarea, isConnected, isDictating, onAddImages]);
 }
 
 function useAutoFocusOnWebEffect(
@@ -894,6 +886,7 @@ function toggleRealtimeVoiceImpl(ctx: ToggleRealtimeVoiceContext): void {
 }
 
 interface StartDictationContext {
+  isRealtimeVoiceActive: boolean;
   dictationUnavailableMessage: string | null | undefined;
   canStartDictation: () => boolean;
   toast: { error: (msg: string) => void };
@@ -902,6 +895,7 @@ interface StartDictationContext {
 }
 
 async function startDictationIfAvailableImpl(ctx: StartDictationContext): Promise<void> {
+  if (ctx.isRealtimeVoiceActive) return;
   if (ctx.dictationUnavailableMessage) {
     ctx.toast.error(ctx.dictationUnavailableMessage);
     return;
@@ -1528,7 +1522,8 @@ export const MessageInput = forwardRef<MessageInputRef, MessageInputProps>(
     );
     const showRealtimeOverlay = isRealtimeVoiceForCurrentAgent;
     const showOverlay = showDictationOverlay || showRealtimeOverlay;
-    const surfacePresentation = resolveComposerSurfacePresentation(showOverlay);
+    // Only dictation takes over the input surface; voice mode leaves the draft editable.
+    const surfacePresentation = resolveComposerSurfacePresentation(showDictationOverlay);
 
     useEffect(() => {
       if (isDictating || isDictationProcessing) {
@@ -1540,13 +1535,21 @@ export const MessageInput = forwardRef<MessageInputRef, MessageInputProps>(
     const startDictationIfAvailable = useCallback(
       () =>
         startDictationIfAvailableImpl({
+          isRealtimeVoiceActive: isRealtimeVoiceForCurrentAgent,
           dictationUnavailableMessage,
           canStartDictation,
           toast,
           startDictation,
           exitFullscreen,
         }),
-      [canStartDictation, dictationUnavailableMessage, startDictation, toast, exitFullscreen],
+      [
+        canStartDictation,
+        dictationUnavailableMessage,
+        isRealtimeVoiceForCurrentAgent,
+        startDictation,
+        toast,
+        exitFullscreen,
+      ],
     );
 
     const handleVoicePress = useCallback(
@@ -1706,7 +1709,6 @@ export const MessageInput = forwardRef<MessageInputRef, MessageInputProps>(
       isConnected,
       disabled,
       isDictating,
-      isRealtimeVoiceForCurrentAgent,
       onAddImages,
     });
 
@@ -2001,7 +2003,7 @@ export const MessageInput = forwardRef<MessageInputRef, MessageInputProps>(
             onChangeText={handleInputChange}
             onFocus={handleInputFocus}
             onBlur={handleInputBlur}
-            editable={!isDictating && !isRealtimeVoiceForCurrentAgent && !disabled}
+            editable={!isDictating && !disabled}
             scrollEnabled={isComposerScrollEnabled}
             autoFocus={false}
             onKeyPress={shouldHandleWebKeyPress ? handleDesktopKeyPress : undefined}
@@ -2032,7 +2034,6 @@ export const MessageInput = forwardRef<MessageInputRef, MessageInputProps>(
         handleInputFocus,
         handleInputBlur,
         isDictating,
-        isRealtimeVoiceForCurrentAgent,
         disabled,
         isComposerScrollEnabled,
         shouldHandleWebKeyPress,
diff --git a/packages/app/src/composer/input/state.test.ts b/packages/app/src/composer/input/state.test.ts
index 6f2cdef74..9e8000832 100644
--- a/packages/app/src/composer/input/state.test.ts
+++ b/packages/app/src/composer/input/state.test.ts
@@ -16,7 +16,13 @@ import {
 const connected = { isConnected: true } as never;
 const disconnected = { isConnected: false } as never;
 
-function createDictationKeyboard({ startsRecording }: { startsRecording: boolean }) {
+function createDictationKeyboard({
+  startsRecording,
+  isRealtimeVoiceActive = false,
+}: {
+  startsRecording: boolean;
+  isRealtimeVoiceActive?: boolean;
+}) {
   let isRecording = false;
   const actions: string[] = [];
 
@@ -37,7 +43,7 @@ function createDictationKeyboard({ startsRecording }: { startsRecording: boolean
         },
         cancelDictation: () => undefined,
         toggleRealtimeVoice: () => undefined,
-        isRealtimeVoiceActive: false,
+        isRealtimeVoiceActive,
         toggleRealtimeVoiceMute: () => undefined,
       }),
   };
@@ -166,6 +172,13 @@ describe("dictation keyboard behavior", () => {
 
     expect(keyboard.actions).toEqual(["start", "start"]);
   });
+
+  it("does not open a second mic capture while voice mode owns the mic", () => {
+    const keyboard = createDictationKeyboard({ startsRecording: true, isRealtimeVoiceActive: true });
+
+    expect(keyboard.pressDictationShortcut()).toBe(true);
+    expect(keyboard.actions).toEqual([]);
+  });
 });
 
 describe("dictation transcript behavior", () => {
diff --git a/packages/app/src/composer/input/state.ts b/packages/app/src/composer/input/state.ts
index 698965b5a..fcc41978b 100644
--- a/packages/app/src/composer/input/state.ts
+++ b/packages/app/src/composer/input/state.ts
@@ -172,7 +172,8 @@ export function runMessageInputKeyboardAction(
     if (actions.isDictationRecording()) {
       actions.markTranscriptForSend();
       void actions.confirmDictation();
-    } else {
+    } else if (!actions.isRealtimeVoiceActive) {
+      // Voice mode already owns the mic; a second capture would fight it.
       void actions.startDictation();
     }
     return true;
-- 
