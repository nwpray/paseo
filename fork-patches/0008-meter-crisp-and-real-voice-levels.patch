+import { describe, expect, it } from "vitest";
+import { shouldPublishDisplayVolume, smoothDisplayVolume } from "./display-volume";
+
+describe("smoothDisplayVolume", () => {
+  it("reaches most of a syllable's level within one capture buffer", () => {
+    expect(smoothDisplayVolume(0, 0.6)).toBeGreaterThan(0.4);
+  });
+
+  it("falls slower than it rises, but clears a word gap of three buffers", () => {
+    let level = 0.6;
+    for (let i = 0; i < 3; i += 1) level = smoothDisplayVolume(level, 0);
+    expect(level).toBeLessThan(0.2);
+    expect(0.6 - smoothDisplayVolume(0.6, 0)).toBeLessThan(smoothDisplayVolume(0, 0.6));
+  });
+
+  it("stays in 0..1", () => {
+    expect(smoothDisplayVolume(0.9, 5)).toBeLessThanOrEqual(1);
+    expect(smoothDisplayVolume(0.1, -5)).toBeGreaterThanOrEqual(0);
+  });
+});
+
+describe("shouldPublishDisplayVolume", () => {
+  it("publishes a real change at once", () => {
+    expect(
+      shouldPublishDisplayVolume({ previous: 0.2, next: 0.3, nowMs: 1010, lastPublishMs: 1000 }),
+    ).toBe(true);
+  });
+
+  it("holds a steady level until the interval passes", () => {
+    const steady = { previous: 0.2, next: 0.205, lastPublishMs: 1000 };
+    expect(shouldPublishDisplayVolume({ ...steady, nowMs: 1050 })).toBe(false);
+    expect(shouldPublishDisplayVolume({ ...steady, nowMs: 1120 })).toBe(true);
+  });
+});
