@@ -0,0 +1,27 @@
+// Smoothing for the voice-mode meter level. Web capture delivers a level every 4096 frames
+// (85ms at 48kHz), so a syllable spans two or three samples; native taps are smaller.
+// Attack is fast enough for a syllable to reach most of its peak; release eases the dips
+// between syllables without holding the bars up through word gaps.
+
+const DISPLAY_VOLUME_PUBLISH_INTERVAL_MS = 120;
+const DISPLAY_VOLUME_CHANGE_EPSILON = 0.02;
+const DISPLAY_VOLUME_ATTACK = 0.7;
+const DISPLAY_VOLUME_RELEASE = 0.35;
+
+export function smoothDisplayVolume(previous: number, level: number): number {
+  const smoothing = level >= previous ? DISPLAY_VOLUME_ATTACK : DISPLAY_VOLUME_RELEASE;
+  return Math.max(0, Math.min(1, previous + (level - previous) * smoothing));
+}
+
+/** Publishes on a real change, or on the interval so a steady level still lands. */
+export function shouldPublishDisplayVolume(input: {
+  previous: number;
+  next: number;
+  nowMs: number;
+  lastPublishMs: number;
+}): boolean {
+  return (
+    input.nowMs - input.lastPublishMs >= DISPLAY_VOLUME_PUBLISH_INTERVAL_MS ||
+    Math.abs(input.next - input.previous) >= DISPLAY_VOLUME_CHANGE_EPSILON
+  );
+}
