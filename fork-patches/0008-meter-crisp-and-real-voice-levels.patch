+import { describe, expect, it } from "vitest";
+import { meterLevelFromRms, rmsOf } from "./meter-level";
+
+const fromDbfs = (db: number) => meterLevelFromRms(10 ** (db / 20));
+
+describe("meterLevelFromRms", () => {
+  it("reads silence and the suppressed noise floor as zero", () => {
+    expect(meterLevelFromRms(0)).toBe(0);
+    expect(meterLevelFromRms(Number.NaN)).toBe(0);
+    expect(fromDbfs(-70)).toBe(0);
+    expect(fromDbfs(-55)).toBe(0);
+  });
+
+  it("puts captured conversational speech in the meter's full-motion range", () => {
+    // p25, p50 and p95 per-buffer RMS of speech through Chrome's auto gain.
+    expect(fromDbfs(-30)).toBeGreaterThan(0.35);
+    expect(fromDbfs(-25)).toBeGreaterThan(0.5);
+    expect(fromDbfs(-18)).toBeLessThan(0.8);
+  });
+
+  it("keeps quiet speech above the meter's full-motion point", () => {
+    // MOTION_FULL_AT in components/volume-meter.tsx.
+    expect(fromDbfs(-35)).toBeGreaterThanOrEqual(0.29);
+  });
+
+  it("rises monotonically and clamps at full scale", () => {
+    const levels = [-50, -40, -30, -20, -10].map(fromDbfs);
+    for (let i = 1; i < levels.length; i += 1) {
+      expect(levels[i]).toBeGreaterThan(levels[i - 1]);
+    }
+    expect(fromDbfs(-10)).toBe(1);
+    expect(meterLevelFromRms(1)).toBe(1);
+  });
+});
+
+describe("rmsOf", () => {
+  it("computes RMS of a buffer", () => {
+    expect(rmsOf(new Float32Array([0.5, -0.5, 0.5, -0.5]))).toBeCloseTo(0.5);
+    expect(rmsOf(new Float32Array(0))).toBe(0);
+  });
+});
diff --git a/packages/app/src/audio/meter-level.ts b/packages/app/src/audio/meter-level.ts
new file mode 100644
index 000000000..b453d27c1
--- /dev/null
+++ b/packages/app/src/audio/meter-level.ts
@@ -0,0 +1,33 @@
+// Mic level for meters, 0..1 on a loudness scale. Web capture computes linear RMS per
+// 4096-frame buffer. With Chrome's auto gain, speech lands at p25 -30, p50 -25 and p95 -18
+// dBFS per buffer, which the old linear RMS * 2 mapped to 0.06..0.25, so meters barely moved.
+// This curve puts that range at 0.4..0.75 and the dips between syllables near 0.2. Native
+// engines already report a dB-based level (packages/expo-two-way-audio, calculateRMSLevel),
+// so web maps RMS through decibels too.
+
+/** Room noise after noise suppression sits below this. It reads as silence. */
+const NOISE_FLOOR_DBFS = -55;
+/** Loud, close speech. Anything above reads as full scale. */
+const FULL_SCALE_DBFS = -10;
+/** Above 1 keeps soft sounds low so normal speech carries most of the range. */
+const CURVE = 1.5;
+
+/** Maps a linear RMS (0..1 full scale) to a 0..1 meter level. */
+export function meterLevelFromRms(rms: number): number {
+  if (!(rms > 0)) return 0;
+  const dbfs = 20 * Math.log10(rms);
+  const t = (dbfs - NOISE_FLOOR_DBFS) / (FULL_SCALE_DBFS - NOISE_FLOOR_DBFS);
+  if (t <= 0) return 0;
+  if (t >= 1) return 1;
+  return t ** CURVE;
+}
+
+/** RMS of one capture buffer. */
+export function rmsOf(samples: Float32Array): number {
+  let sumSquares = 0;
+  for (let i = 0; i < samples.length; i += 1) {
+    const sample = samples[i];
+    sumSquares += sample * sample;
+  }
+  return Math.sqrt(sumSquares / Math.max(1, samples.length));
+}
