@@ -0,0 +1,122 @@
+import { useEffect, useState } from "react";
+import { meterLevelFromRms } from "@/audio/meter-level";
+import { shouldPublishDisplayVolume, smoothDisplayVolume } from "@/voice/display-volume";
+
+// A mic trace shaped like live web capture, for design states that should move like the
+// real meter. It models what the web engine sees: one RMS per 4096-frame buffer at 48kHz,
+// a noise-suppressed floor near -62 dBFS, and phrases with pauses. Per-buffer speech RMS
+// matches a capture of speech through Chrome's getUserMedia with the app's constraints
+// (noise suppression, echo cancellation, auto gain): p25 -30, p50 -25, p95 -18 dBFS, one
+// buffer every 85 to 90ms. The samples then go through the real meter curve and the
+// runtime's display smoothing and publish gate, so the meter gets what it would get live.
+
+/** One web capture buffer: 4096 frames at 48kHz. */
+const CAPTURE_INTERVAL_MS = (4096 / 48000) * 1000;
+const TRACE_MS = 16_000;
+const STEP_MS = 5;
+
+/** Deterministic, so every replay of the state shows the same take. */
+function mulberry32(seed: number): () => number {
+  let a = seed;
+  return () => {
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+function dbToLinear(db: number): number {
+  return 10 ** (db / 20);
+}
+
+// Fast attack, slower decay, like a voiced syllable.
+function syllableEnvelope(progress: number): number {
+  if (progress < 0.2) return progress / 0.2;
+  return Math.max(0, 1 - (progress - 0.2) / 0.8) ** 0.7;
+}
+
+/** Speech signal RMS at 5ms steps across the whole take. */
+function buildSignal(random: () => number): Float32Array {
+  const between = (min: number, max: number) => min + random() * (max - min);
+  const signal = new Float32Array(Math.ceil(TRACE_MS / STEP_MS));
+  let at = 400;
+  while (at < TRACE_MS) {
+    const phraseEnd = at + between(1500, 3500);
+    while (at < phraseEnd) {
+      const duration = between(110, 260);
+      const peak = dbToLinear(between(-27, -14));
+      const start = Math.floor(at / STEP_MS);
+      const steps = Math.floor(duration / STEP_MS);
+      for (let i = 0; i < steps && start + i < signal.length; i += 1) {
+        const flutter = 1 + (random() - 0.5) * 0.25;
+        signal[start + i] = peak * syllableEnvelope(i / steps) * flutter;
+      }
+      at += duration + (random() < 0.3 ? between(180, 420) : between(30, 90));
+    }
+    at += between(600, 1500);
+  }
+  return signal;
+}
+
+/** One RMS per capture buffer, mixing in the noise floor. Exported for the calibration test. */
+export function buildCaptureRms(seed: number): number[] {
+  const random = mulberry32(seed);
+  const signal = buildSignal(random);
+  const perBuffer = CAPTURE_INTERVAL_MS / STEP_MS;
+  const samples: number[] = [];
+  for (let start = 0; start + perBuffer <= signal.length; start += perBuffer) {
+    const noise = dbToLinear(-62 + (random() - 0.5) * 6);
+    let sumSquares = 0;
+    const from = Math.floor(start);
+    const to = Math.floor(start + perBuffer);
+    for (let i = from; i < to; i += 1) sumSquares += signal[i] * signal[i] + noise * noise;
+    samples.push(Math.sqrt(sumSquares / Math.max(1, to - from)));
+  }
+  return samples;
+}
+
+export type VoiceTraceCalibration = "current" | "original";
+
+// The calibration before the meter curve: linear RMS doubled, with the runtime's original
+// smoothing. Kept so the frame can show why the meter looked still on real input.
+function originalLevel(rms: number): number {
+  return Math.min(1, rms * 2);
+}
+function originalSmoothing(previous: number, level: number): number {
+  const smoothing = level >= previous ? 0.35 : 0.18;
+  return previous + (level - previous) * smoothing;
+}
+
+/** Replays a recorded-style mic trace, looping, at the real capture cadence. */
+export function useRecordedVoiceTrace(
+  calibration: VoiceTraceCalibration,
+  enabled: boolean,
+): number {
+  const [volume, setVolume] = useState(0);
+  useEffect(() => {
+    if (!enabled) {
+      setVolume(0);
+      return;
+    }
+    const samples = buildCaptureRms(7);
+    const toLevel = calibration === "current" ? meterLevelFromRms : originalLevel;
+    const smooth = calibration === "current" ? smoothDisplayVolume : originalSmoothing;
+    let index = 0;
+    let published = 0;
+    let lastPublishMs = 0;
+    const handle = setInterval(() => {
+      const nowMs = Date.now();
+      const next = smooth(published, toLevel(samples[index]));
+      index = (index + 1) % samples.length;
+      if (!shouldPublishDisplayVolume({ previous: published, next, nowMs, lastPublishMs })) {
+        return;
+      }
+      lastPublishMs = nowMs;
+      published = Number(next.toFixed(3));
+      setVolume(published);
+    }, CAPTURE_INTERVAL_MS);
+    return () => clearInterval(handle);
+  }, [calibration, enabled]);
+  return volume;
+}
