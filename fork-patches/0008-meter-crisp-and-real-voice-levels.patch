diff --git a/packages/app/src/design/recorded-voice-trace.test.ts b/packages/app/src/design/recorded-voice-trace.test.ts
new file mode 100644
index 000000000..b14558256
--- /dev/null
+++ b/packages/app/src/design/recorded-voice-trace.test.ts
@@ -0,0 +1,17 @@
+import { expect, it } from "vitest";
+import { buildCaptureRms } from "./recorded-voice-trace";
+
+// Measured per-buffer RMS of speech through Chrome's getUserMedia with the app's constraints:
+// p25 -30, p50 -25, p95 -18 dBFS. The trace has to stay near that or the frame stops
+// predicting how the meter moves on real input.
+it("matches the speech level range of real web capture", () => {
+  const dbfs = buildCaptureRms(7).map((rms) => 20 * Math.log10(rms));
+  const speech = dbfs.filter((db) => db > -50).sort((a, b) => a - b);
+  const at = (q: number) => speech[Math.floor(q * (speech.length - 1))];
+  expect(at(0.5)).toBeGreaterThan(-29);
+  expect(at(0.5)).toBeLessThan(-22);
+  expect(at(0.95)).toBeGreaterThan(-21);
+  expect(at(0.95)).toBeLessThan(-14);
+  // Phrase pauses, so the idle wave shows between phrases.
+  expect(dbfs.length - speech.length).toBeGreaterThan(dbfs.length / 4);
+});
