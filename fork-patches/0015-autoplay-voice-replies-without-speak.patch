+describe("VoiceSession automatic voice playback (fork)", () => {
+  test("reads every streamed assistant delta and final suffix when speak was not used", async () => {
+    const spoken: string[] = [];
+    const tts: TextToSpeechProvider = {
+      async synthesizeSpeech(text) {
+        spoken.push(text);
+        return { stream: Readable.from([Buffer.from("audio")]), format: "pcm;rate=24000" };
+      },
+    };
+    const { voiceSession, host } = createVoiceSession(tts);
+    host.emit = (message) => {
+      host.emitted.push(message);
+      if (message.type === "audio_output") voiceSession.handleAudioPlayed(message.payload.id);
+    };
+    await voiceSession.handleSetVoiceMode(true, VOICE_AGENT_ID);
+    voiceSession.handleAgentStreamEvent({ type: "turn_started", provider: "codex" });
+    voiceSession.handleAgentStreamEvent({
+      type: "timeline",
+      provider: "codex",
+      item: { type: "assistant_message", messageId: "m1", text: "**Hello" },
+    });
+    voiceSession.handleAgentStreamEvent({
+      type: "timeline",
+      provider: "codex",
+      item: { type: "assistant_message", messageId: "m1", text: "**, Nick" },
+    });
+    voiceSession.handleAgentStreamEvent({
+      type: "timeline",
+      provider: "codex",
+      item: { type: "assistant_message", messageId: "m1", text: "." },
+    });
+    voiceSession.handleAgentStreamEvent({ type: "turn_completed", provider: "codex" });
+
+    await vi.waitFor(() => expect(spoken).toEqual(["Hello, Nick."]));
+    await waitForAudioOutput(host);
+    expect(
+      host.emitted.some(
+        (message) => message.type === "audio_output" && message.payload.isVoiceMode,
+      ),
+    ).toBe(true);
+    await voiceSession.cleanup();
+  });
+
+  test("starting the next turn cancels a previous automatic reply", async () => {
+    const tts: TextToSpeechProvider = {
+      async synthesizeSpeech() {
+        return { stream: Readable.from([Buffer.from("audio")]), format: "pcm;rate=24000" };
+      },
+    };
+    const { voiceSession, host } = createVoiceSession(tts);
+    await voiceSession.handleSetVoiceMode(true, VOICE_AGENT_ID);
+    voiceSession.handleAgentStreamEvent({ type: "turn_started", provider: "codex" });
+    voiceSession.handleAgentStreamEvent({
+      type: "timeline",
+      provider: "codex",
+      item: { type: "assistant_message", messageId: "m1", text: "Old reply." },
+    });
+    voiceSession.handleAgentStreamEvent({ type: "turn_completed", provider: "codex" });
+    await waitForAudioOutput(host);
+
+    voiceSession.handleAgentStreamEvent({ type: "turn_started", provider: "codex" });
+    await vi.waitFor(() => expect(host.emitted.some(isCanceledReplay)).toBe(true));
+    voiceSession.handleAgentStreamEvent({
+      type: "timeline",
+      provider: "codex",
+      item: { type: "assistant_message", messageId: "m2", text: "New reply." },
+    });
+    voiceSession.handleAgentStreamEvent({ type: "turn_completed", provider: "codex" });
+    await vi.waitFor(() => expect(host.emitted.filter(isAudioOutput)).toHaveLength(2));
+    await voiceSession.cleanup();
+  });
+
+  test("does not read a turn again after the speak tool was used", async () => {
+    const spoken: string[] = [];
+    const tts: TextToSpeechProvider = {
+      async synthesizeSpeech(text) {
+        spoken.push(text);
+        return { stream: Readable.from([Buffer.from("audio")]), format: "pcm;rate=24000" };
+      },
+    };
+    const { voiceSession, host, speak } = createVoiceSession(tts);
+    host.emit = (message) => {
+      host.emitted.push(message);
+      if (message.type === "audio_output") voiceSession.handleAudioPlayed(message.payload.id);
+    };
+    await voiceSession.handleSetVoiceMode(true, VOICE_AGENT_ID);
+    voiceSession.handleAgentStreamEvent({ type: "turn_started", provider: "codex" });
+    await speak({ text: "I said this aloud." });
+    voiceSession.handleAgentStreamEvent({
+      type: "timeline",
+      provider: "codex",
+      item: { type: "assistant_message", text: "I said this aloud." },
+    });
+    voiceSession.handleAgentStreamEvent({ type: "turn_completed", provider: "codex" });
+    await settle();
+
+    expect(spoken).toEqual(["I said this aloud."]);
+    await voiceSession.cleanup();
+  });
+});
+
