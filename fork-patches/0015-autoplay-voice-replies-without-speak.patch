+  /** Read a completed voice turn if its agent never used the speak tool. */
+  handleAgentStreamEvent(event: AgentStreamEvent): void {
+    if (!this.isVoiceMode || !this.voiceModeAgentId) return;
+    if (event.type === "turn_started") {
+      this.cancelSpeechReplay(undefined, "new agent turn");
+      this.assistantTurn = { messages: new Map(), nextMessage: 0, spoke: false };
+      return;
+    }
+    const turn = this.assistantTurn;
+    if (!turn) return;
+    if (event.type === "timeline" && event.item.type === "assistant_message") {
+      const key = event.item.messageId ?? `message-${turn.nextMessage++}`;
+      turn.messages.set(key, (turn.messages.get(key) ?? "") + event.item.text);
+      return;
+    }
+    if (event.type === "turn_completed") {
+      this.assistantTurn = null;
+      const text = [...turn.messages.values()].join("\n\n");
+      if (!turn.spoke && text.trim()) {
+        this.sessionLogger.info(
+          { agentId: this.voiceModeAgentId, textLength: text.length },
+          "Reading assistant turn without a speak tool call",
+        );
+        void this.handleSpeechReplay(uuidv4(), text);
+      }
+    } else if (event.type === "turn_canceled" || event.type === "turn_failed") {
+      this.assistantTurn = null;
+    }
+  }
+
   handleDictationChunk(params: {
     dictationId: string;
     seq: number;
