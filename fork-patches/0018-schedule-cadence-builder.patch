+    expect(formatRunTime(first.at, DENVER)).toBe("1:30 AM MDT");
+    expect(formatRunTime(second.at, DENVER)).toBe("1:30 AM MST");
+    expect(third).toMatchObject({ kind: "run", repeat: false });
+  });
+
+  it("shows a skipped run when clocks spring forward past the wall time", () => {
+    const preview = computeCadencePreview({
+      source: cron("30 2 * * *"),
