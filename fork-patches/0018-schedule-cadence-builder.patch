index 000000000..5aaed7f8c
--- /dev/null
+++ b/packages/app/src/schedules/cadence-preview.ts
@@ -0,0 +1,550 @@
+import { parseCronExpression } from "@getpaseo/protocol/schedule/cron-expression";
+import {
+  createCronDatePartsReader,
+  findNextCronMatch,
+  type CronDateParts,
+  type CronDatePartsReader,
+} from "@getpaseo/protocol/schedule/cron-next-run";
+import { formatClockTime, type CadenceTime } from "./cadence-builder";
+
+// Upcoming runs for the cadence preview. Cron runs come from the daemon's own
+// matcher (`findNextCronMatch`), so the list shows what the daemon will do,
+// including its DST behavior: a repeated fall-back wall time runs twice and a
+// spring-forward wall time that does not exist is skipped.
+
+const MS_PER_MINUTE = 60_000;
+const MS_PER_DAY = 86_400_000;
+export const PREVIEW_LIST_LENGTH = 5;
+export const PREVIEW_STRIP_DAYS = 14;
+// A column is 144px tall. More than one ordinary mark per ten wall minutes
+// cannot add detail, so keep the count exact while sampling the drawing.
+const STRIP_MARK_SPACING = 10 * MS_PER_MINUTE;
+
+export type CadencePreviewSource =
+  | { type: "cron"; expression: string; timezone: string }
+  | { type: "every"; everyMs: number; nextRunAt: number | null; timezone: string };
+
+export interface CadencePreviewInput {
+  source: CadencePreviewSource;
+  now: number;
+  /** Runs at or after this instant do not happen. */
+  expiresAt: number | null;
+  /** Runs left before the schedule completes; null is unlimited. */
+  remainingRuns: number | null;
+  /** Wall-clock times of a clock-time builder mode, for spring-forward notes. */
+  clockTimes: readonly CadenceTime[];
+}
+
+export type CadencePreviewEntry =
+  | { kind: "run"; at: number; repeat: boolean; last: boolean }
+  | { kind: "skipped"; at: number; wallTime: CadenceTime };
+
+export interface CadencePreviewMark {
+  minuteOfDay: number;
+  tone: "next" | "run" | "repeat" | "skipped";
+}
+
+export interface CadencePreviewDay {
+  year: number;
+  month: number;
+  day: number;
+  weekday: number;
+  isToday: boolean;
+  pastEnd: boolean;
+  marks: CadencePreviewMark[];
+}
+
+export interface CadencePreview {
+  /** never: no minute in the next 366 days matches; ended: the end comes first. */
+  status: "upcoming" | "never" | "ended";
+  nextRunAt: number | null;
+  entries: CadencePreviewEntry[];
+  days: CadencePreviewDay[];
+  stripRunCount: number;
+}
+
+const readerCache = new Map<string, CronDatePartsReader>();
+
+function reader(timezone: string): CronDatePartsReader {
+  let read = readerCache.get(timezone);
+  if (!read) {
+    read = createCronDatePartsReader(timezone);
+    readerCache.set(timezone, read);
+  }
+  return read;
+}
+
+function dayKey(parts: Pick<CronDateParts, "year" | "month" | "dayOfMonth">): number {
+  return Date.UTC(parts.year, parts.month - 1, parts.dayOfMonth) / MS_PER_DAY;
+}
+
+function wallClockUtc(parts: CronDateParts): number {
+  return Date.UTC(parts.year, parts.month - 1, parts.dayOfMonth, parts.hour, parts.minute);
+}
+
+/**
+ * Every instant whose wall time in `timezone` is the given local time: none
+ * inside a spring-forward gap, two inside a repeated fall-back hour.
+ */
+export function wallTimeInstants(input: {
+  year: number;
+  month: number;
+  day: number;
+  hour: number;
+  minute: number;
+  timezone: string;
+}): number[] {
+  const read = reader(input.timezone);
+  const wall = Date.UTC(input.year, input.month - 1, input.day, input.hour, input.minute);
+  const offsetAt = (t: number) => wallClockUtc(read(new Date(t))) - t;
+  const offsets = new Set([
+    offsetAt(wall - 2 * MS_PER_DAY),
+    offsetAt(wall),
+    offsetAt(wall + 2 * MS_PER_DAY),
+  ]);
+  const instants = new Set<number>();
+  for (const offset of offsets) {
+    const candidate = wall - offset;
+    if (wallClockUtc(read(new Date(candidate))) === wall) {
+      instants.add(candidate);
+    }
+  }
+  return [...instants].sort((a, b) => a - b);
+}
+
+/** Midnight that starts `date` (YYYY-MM-DD) in `timezone`, or the first instant after it. */
+export function startOfLocalDay(
+  date: { year: number; month: number; day: number },
+  timezone: string,
+): number {
+  for (let minute = 0; minute < 24 * 60; minute += 30) {
+    const instants = wallTimeInstants({
+      ...date,
+      hour: Math.floor(minute / 60),
+      minute: minute % 60,
+      timezone,
+    });
+    if (instants.length > 0) {
+      return instants[0];
+    }
+  }
+  return Date.UTC(date.year, date.month - 1, date.day);
+}
+
+export function readLocalParts(at: number, timezone: string): CronDateParts {
+  return reader(timezone)(new Date(at));
+}
+
+/** Offset of `timezone` from UTC at `at`, like "UTC−6" or "UTC+5:30". */
+export function formatUtcOffset(timezone: string, at: number): string {
+  const minuteStart = Math.floor(at / MS_PER_MINUTE) * MS_PER_MINUTE;
+  const offsetMinutes = Math.round(
+    (wallClockUtc(reader(timezone)(new Date(minuteStart))) - minuteStart) / MS_PER_MINUTE,
+  );
+  if (offsetMinutes === 0) {
+    return "UTC+0";
+  }
+  const sign = offsetMinutes < 0 ? "−" : "+";
+  const absolute = Math.abs(offsetMinutes);
+  const hours = Math.floor(absolute / 60);
+  const minutes = absolute % 60;
+  return `UTC${sign}${hours}${minutes ? `:${String(minutes).padStart(2, "0")}` : ""}`;
+}
+
+interface RunCollector {
+  next: (after: number) => number | null;
+}
+
+function createCollector(source: CadencePreviewSource, now: number): RunCollector {
+  if (source.type === "every") {
+    // The daemon schedules each rolling run from the one before it.
+    const first = source.nextRunAt ?? now + source.everyMs;
+    return {
+      next: (after) => {
+        if (after < first) {
+          return first;
+        }
+        return first + (Math.floor((after - first) / source.everyMs) + 1) * source.everyMs;
+      },
+    };
+  }
+  const cron = parseCronExpression(source.expression);
+  const readDateParts = reader(source.timezone);
+  return {
+    next: (after) =>
+      findNextCronMatch({ cron, readDateParts, after: new Date(after) })?.getTime() ?? null,
+  };
+}
+
+function collectRuns(input: {
+  collector: RunCollector;
+  now: number;
+  limit: number;
+  until: number;
+  expiresAt: number | null;
+  remainingRuns: number | null;
+}): { runs: number[]; hasAny: boolean } {
+  const runs: number[] = [];
+  const first = input.collector.next(input.now);
+  const cap = Math.min(input.limit, input.remainingRuns ?? Number.POSITIVE_INFINITY);
+  let next = first;
+  while (runs.length < cap && next !== null) {
+    if (next > input.until || (input.expiresAt !== null && next >= input.expiresAt)) {
+      break;
+    }
+    runs.push(next);
+    next = input.collector.next(next);
+  }
+  return { runs, hasAny: first !== null };
+}
+
+function isRepeat(previous: CronDateParts | null, parts: CronDateParts): boolean {
+  return (
+    previous !== null &&
+    dayKey(previous) === dayKey(parts) &&
+    previous.hour === parts.hour &&
+    previous.minute === parts.minute
+  );
+}
+
+interface SkippedWallTime {
+  at: number;
+  dayKey: number;
+  wallTime: CadenceTime;
+}
+
+/** Clock times the cadence asks for on days where the wall time does not exist. */
+function findSkippedWallTimes(input: {
+  source: CadencePreviewSource;
+  clockTimes: readonly CadenceTime[];
+  fromDay: { year: number; month: number; day: number };
+  dayCount: number;
+}): SkippedWallTime[] {
+  if (input.source.type !== "cron" || input.clockTimes.length === 0) {
+    return [];
+  }
+  const { timezone } = input.source;
+  const cron = parseCronExpression(input.source.expression);
+  const skipped: SkippedWallTime[] = [];
+  for (let offset = 0; offset < input.dayCount; offset += 1) {
+    const date = new Date(
+      Date.UTC(input.fromDay.year, input.fromDay.month - 1, input.fromDay.day + offset),
+    );
+    const year = date.getUTCFullYear();
+    const month = date.getUTCMonth() + 1;
+    const day = date.getUTCDate();
+    if (
+      !cron.month.matches(month) ||
+      !cron.dayOfMonth.matches(day) ||
+      !cron.dayOfWeek.matches(date.getUTCDay())
+    ) {
+      continue;
+    }
+    for (const time of input.clockTimes) {
+      if (!cron.hour.matches(time.hour) || !cron.minute.matches(time.minute)) {
+        continue;
+      }
+      if (wallTimeInstants({ year, month, day, ...time, timezone }).length > 0) {
+        continue;
+      }
+      const after =
+        wallTimeInstants({
+          year,
+          month,
+          day,
+          hour: Math.min(23, time.hour + 1),
+          minute: 0,
+          timezone,
+        })[0] ??
+        startOfLocalDay({ year, month, day }, timezone) +
+          (time.hour * 60 + time.minute) * MS_PER_MINUTE;
+      skipped.push({ at: after, dayKey: dayKey({ year, month, dayOfMonth: day }), wallTime: time });
+    }
+  }
+  return skipped;
+}
+
+function collectRollingStrip(input: {
+  source: Extract<CadencePreviewSource, { type: "every" }>;
+  collector: RunCollector;
+  now: number;
+  until: number;
+  remainingRuns: number | null;
+  timezone: string;
+  days: CadencePreviewDay[];
+  dayStarts: number[];
+}): { count: number; lastRunAt: number | null } {
+  const { source, collector, now, until, remainingRuns, timezone, days, dayStarts } = input;
+  const first = collector.next(now);
+  if (first === null || first >= until) {
+    return { count: 0, lastRunAt: null };
+  }
+  const available = Math.floor((until - 1 - first) / source.everyMs) + 1;
+  const count = Math.min(available, remainingRuns ?? Number.POSITIVE_INFINITY);
+  const spacing = Math.max(1, Math.ceil(STRIP_MARK_SPACING / source.everyMs));
+  for (let dayIndex = 0; dayIndex < days.length; dayIndex += 1) {
+    const firstIndex = Math.max(0, Math.ceil((dayStarts[dayIndex] - first) / source.everyMs));
+    const dayEnd = Math.min(dayStarts[dayIndex + 1] ?? until, until);
+    const endIndex = Math.min(count, Math.ceil((dayEnd - first) / source.everyMs));
+    for (let index = firstIndex; index < endIndex; index += spacing) {
+      const at = first + index * source.everyMs;
+      const parts = readLocalParts(at, timezone);
+      days[dayIndex].marks.push({
+        minuteOfDay: parts.hour * 60 + parts.minute,
+        tone: index === 0 ? "next" : "run",
+      });
+    }
+  }
+  return { count, lastRunAt: first + (count - 1) * source.everyMs };
+}
+
+function collectStrip(input: {
+  source: CadencePreviewSource;
+  collector: RunCollector;
+  now: number;
+  until: number;
+  remainingRuns: number | null;
+  timezone: string;
+  todayKey: number;
+  days: CadencePreviewDay[];
+}): { count: number; lastRunAt: number | null } {
+  const { source, collector, now, until, remainingRuns, timezone, todayKey, days } = input;
+  let count = 0;
+  let lastRunAt: number | null = null;
+  if (remainingRuns === 0) {
+    return { count, lastRunAt };
+  }
+  const dayStarts = days.map((day) => startOfLocalDay(day, timezone));
+  if (source.type === "every") {
+    return collectRollingStrip({
+      source,
+      collector,
+      now,
+      until,
+      remainingRuns,
+      timezone,
+      days,
+      dayStarts,
+    });
+  }
+
+  // Cron has at most one run per absolute minute. The 14-day window bounds
+  // this scan even for `* * * * *`; only sampled marks are retained.
+  let lastMarkedAt = Number.NEGATIVE_INFINITY;
+  let next = collector.next(now);
+  let nextDayIndex = 1;
+  const maxCount = remainingRuns ?? Number.POSITIVE_INFINITY;
+  while (next !== null && next < until && count < maxCount) {
+    count += 1;
+    let crossedDay = false;
+    while (nextDayIndex < dayStarts.length && next >= dayStarts[nextDayIndex]) {
+      nextDayIndex += 1;
+      crossedDay = true;
+    }
+    if (crossedDay || next - lastMarkedAt >= STRIP_MARK_SPACING) {
+      const parts = readLocalParts(next, timezone);
+      const day = days[dayKey(parts) - todayKey];
+      if (day) {
+        let tone: CadencePreviewMark["tone"] = count === 1 ? "next" : "run";
+        if (lastRunAt !== null && isRepeat(readLocalParts(lastRunAt, timezone), parts)) {
+          tone = "repeat";
+        }
+        day.marks.push({ minuteOfDay: parts.hour * 60 + parts.minute, tone });
+      }
+      lastMarkedAt = next;
+    }
+    lastRunAt = next;
+    next = collector.next(next);
+  }
+  return { count, lastRunAt };
+}
+
+export function computeCadencePreview(input: CadencePreviewInput): CadencePreview {
+  const { source, now } = input;
+  const timezone = source.timezone;
+  const collector = createCollector(source, now);
+  const todayParts = readLocalParts(now, timezone);
+  const today = { year: todayParts.year, month: todayParts.month, day: todayParts.dayOfMonth };
+  const todayKey = dayKey(todayParts);
+  const stripEnd = startOfLocalDay(
+    (() => {
+      const end = new Date(Date.UTC(today.year, today.month - 1, today.day + PREVIEW_STRIP_DAYS));
+      return { year: end.getUTCFullYear(), month: end.getUTCMonth() + 1, day: end.getUTCDate() };
+    })(),
+    timezone,
+  );
+
+  const list = collectRuns({
+    collector,
+    now,
+    limit: PREVIEW_LIST_LENGTH,
+    until: Number.POSITIVE_INFINITY,
+    expiresAt: input.expiresAt,
+    remainingRuns: input.remainingRuns,
+  });
+
+  let status: CadencePreview["status"] = "upcoming";
+  if (!list.hasAny) {
+    status = "never";
+  } else if (list.runs.length === 0) {
+    status = "ended";
+  }
+
+  const lastDayKey =
+    list.runs.length > 0
+      ? dayKey(readLocalParts(list.runs[list.runs.length - 1], timezone))
+      : todayKey;
+  const skipped = findSkippedWallTimes({
+    source,
+    clockTimes: input.clockTimes,
+    fromDay: today,
+    dayCount: Math.max(PREVIEW_STRIP_DAYS, lastDayKey - todayKey + 1),
+  }).filter((entry) => entry.at > now && (input.expiresAt === null || entry.at < input.expiresAt));
+
+  const runsExhausted =
+    input.remainingRuns !== null && list.runs.length >= input.remainingRuns && list.runs.length > 0;
+  const runEntries: CadencePreviewEntry[] = [];
+  let previous: CronDateParts | null = null;
+  list.runs.forEach((at, index) => {
+    const parts = readLocalParts(at, timezone);
+    runEntries.push({
+      kind: "run",
+      at,
+      repeat: isRepeat(previous, parts),
+      last: runsExhausted && index === list.runs.length - 1,
+    });
+    previous = parts;
+  });
+  const listEnd = list.runs.at(-1) ?? now;
+  const entries = [
+    ...runEntries,
+    ...skipped
+      .filter((entry) => entry.at <= listEnd)
+      .map(
+        (entry): CadencePreviewEntry => ({
+          kind: "skipped",
+          at: entry.at,
+          wallTime: entry.wallTime,
+        }),
+      ),
+  ]
+    .sort((a, b) => a.at - b.at)
+    .slice(0, PREVIEW_LIST_LENGTH);
+
+  const endDayKey =
+    input.expiresAt !== null
+      ? dayKey(readLocalParts(input.expiresAt - 1, timezone)) + 1
+      : Number.POSITIVE_INFINITY;
+  const days: CadencePreviewDay[] = Array.from({ length: PREVIEW_STRIP_DAYS }, (_, offset) => {
+    const date = new Date(Date.UTC(today.year, today.month - 1, today.day + offset));
+    return {
+      year: date.getUTCFullYear(),
+      month: date.getUTCMonth() + 1,
+      day: date.getUTCDate(),
+      weekday: date.getUTCDay(),
+      isToday: offset === 0,
+      pastEnd: false,
+      marks: [],
+    };
+  });
+  const until = Math.min(stripEnd, input.expiresAt ?? Number.POSITIVE_INFINITY);
+  const strip = collectStrip({
+    source,
+    collector,
+    now,
+    until,
+    remainingRuns: input.remainingRuns,
+    timezone,
+    todayKey,
+    days,
+  });
+  let runsEndDayKey = Number.POSITIVE_INFINITY;
+  if (input.remainingRuns === 0) {
+    runsEndDayKey = todayKey;
+  } else if (
+    input.remainingRuns !== null &&
+    strip.count >= input.remainingRuns &&
+    strip.lastRunAt !== null
+  ) {
+    runsEndDayKey = dayKey(readLocalParts(strip.lastRunAt, timezone)) + 1;
+  }
+  const firstEndKey = Math.min(endDayKey, runsEndDayKey);
+  days.forEach((day, offset) => {
+    day.pastEnd = todayKey + offset >= firstEndKey;
+  });
+  for (const entry of skipped) {
+    const day = days[entry.dayKey - todayKey];
+    if (day && !day.pastEnd) {
+      day.marks.push({
+        minuteOfDay: entry.wallTime.hour * 60 + entry.wallTime.minute,
+        tone: "skipped",
+      });
+    }
+  }
+
+  return {
+    status,
+    nextRunAt: list.runs[0] ?? null,
+    entries,
+    days,
+    stripRunCount: strip.count,
+  };
+}
+
+// ---------------------------------------------------------------- formatting
+
+const formatterCache = new Map<string, Intl.DateTimeFormat>();
+
+function formatter(timezone: string, kind: "date" | "time"): Intl.DateTimeFormat {
+  const key = `${kind}:${timezone}`;
+  let cached = formatterCache.get(key);
+  if (!cached) {
+    cached = new Intl.DateTimeFormat(
+      "en-US",
+      kind === "date"
+        ? { timeZone: timezone, weekday: "short", month: "short", day: "numeric" }
+        : { timeZone: timezone, hour: "numeric", minute: "2-digit", timeZoneName: "short" },
+    );
+    formatterCache.set(key, cached);
+  }
+  return cached;
+}
+
+export function formatRunDate(at: number, timezone: string): string {
+  return formatter(timezone, "date").format(new Date(at));
+}
+
+/** Wall time with the zone abbreviation, like "1:00 PM MDT". */
+export function formatRunTime(at: number, timezone: string): string {
+  return formatter(timezone, "time").format(new Date(at)).replace(/ /g, " ");
+}
+
+export function formatRelative(at: number, now: number): string {
+  const minutes = Math.round((at - now) / MS_PER_MINUTE);
+  if (minutes < 1) {
+    return "now";
+  }
+  if (minutes < 60) {
+    return `in ${minutes} min`;
+  }
+  const hours = Math.round(minutes / 60);
+  if (hours < 36) {
+    return `in ${hours} h`;
+  }
+  return `in ${Math.round(hours / 24)} days`;
+}
+
+export function formatRunDay(at: number, now: number, timezone: string): string {
+  const diff = dayKey(readLocalParts(at, timezone)) - dayKey(readLocalParts(now, timezone));
+  if (diff === 0) {
+    return "today";
+  }
+  if (diff === 1) {
+    return "tomorrow";
+  }
+  return formatRunDate(at, timezone);
+}
+
+export function formatSkippedWallTime(time: CadenceTime): string {
+  return formatClockTime(time);
+}
