+++ b/packages/app/src/schedules/cadence-builder.ts
@@ -0,0 +1,791 @@
+import type { ScheduleCadence } from "@getpaseo/protocol/schedule/types";
+import { everyMsToFiveFieldCron } from "@getpaseo/protocol/schedule/cadence";
+import { parseCronExpression } from "@getpaseo/protocol/schedule/cron-expression";
+
+// The cadence builder: plain data plus pure reducers, owned by the schedule
+// form model. Every builder mode compiles to one five-field cron expression
+// the daemon already runs. A saved expression opens in a builder mode only
+// when compiling that mode reproduces the exact expression; anything else
+// opens as Cron, so editing never rewrites a schedule the user did not touch.
+
+export type CronCadence = Extract<ScheduleCadence, { type: "cron" }>;
+export type CadenceMode = "interval" | "daily" | "weekly" | "monthly" | "cron";
+export type IntervalUnit = "minutes" | "hours";
+export type MonthlyKind = "day" | "nth";
+
+export interface CadenceTime {
+  hour: number;
+  minute: number;
+}
+
+export interface CadenceTimeEntry {
+  /** Stable identity for the row, so editing one time never remounts another. */
+  id: number;
+  text: string;
+  value: CadenceTime | null;
+}
+
+export interface IntervalDraft {
+  every: number;
+  unit: IntervalUnit;
+  /** Minute past the hour for hour intervals. */
+  offset: number;
+  windowed: boolean;
+  fromHour: number;
+  /** Exclusive end hour, 1–24. */
+  toHour: number;
+  days: number[];
+}
+
+export interface MonthlyDraft {
+  kind: MonthlyKind;
+  day: number;
+  nth: number;
+  weekday: number;
+}
+
+export interface CadenceDraft {
+  mode: CadenceMode;
+  interval: IntervalDraft;
+  times: CadenceTimeEntry[];
+  weekDays: number[];
+  monthly: MonthlyDraft;
+  cronText: string;
+  /** The user typed the cron text, so switching to Cron must not overwrite it. */
+  cronEdited: boolean;
+  /** A builder control changed since the cron text was last filled in. */
+  builderChanged: boolean;
+  /** Bumped when the builder fills the cron text, so the input shows the new text. */
+  cronRevision: number;
+  timezone: string;
+  /** A legacy rolling interval the user has not changed. */
+  legacyEveryMs: number | null;
+}
+
+export interface CadenceErrors {
+  interval?: string;
+  times?: string;
+  weekDays?: string;
+  cron?: string;
+}
+
+export interface CompiledCadence {
+  expression: string | null;
+  summary: string | null;
+  errors: CadenceErrors;
+  /** Wall-clock times of the clock modes, for DST notes in the preview. */
+  clockTimes: CadenceTime[];
+}
+
+export const CADENCE_MODES: readonly CadenceMode[] = [
+  "interval",
+  "daily",
+  "weekly",
+  "monthly",
+  "cron",
+];
+export const MINUTE_STEPS: readonly number[] = [1, 2, 3, 4, 5, 6, 10, 12, 15, 20, 30];
+export const HOUR_STEPS: readonly number[] = [1, 2, 3, 4, 6, 8, 12];
+export const MAX_TIMES = 6;
+/** Monday-first display order of cron weekdays (Sunday is 0). */
+export const WEEKDAY_ORDER: readonly number[] = [1, 2, 3, 4, 5, 6, 0];
+export const WEEKDAY_NAMES = [
+  "Sunday",
+  "Monday",
+  "Tuesday",
+  "Wednesday",
+  "Thursday",
+  "Friday",
+  "Saturday",
+] as const;
+export const WEEKDAY_SHORT = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"] as const;
+export const NTH_LABELS: Record<number, string> = {
+  1: "first",
+  2: "second",
+  3: "third",
+  4: "fourth",
+};
+const WEEKDAYS = [1, 2, 3, 4, 5];
+const WEEKENDS = [0, 6];
+const ALL_DAYS = [0, 1, 2, 3, 4, 5, 6];
+
+// ---------------------------------------------------------------- formatting
+
+export function ordinal(value: number): string {
+  const suffixes = ["th", "st", "nd", "rd"];
+  const mod = value % 100;
+  return `${value}${suffixes[(mod - 20) % 10] ?? suffixes[mod] ?? suffixes[0]}`;
+}
+
+export function formatClockTime(time: CadenceTime): string {
+  const period = time.hour < 12 ? "AM" : "PM";
+  const hour = time.hour % 12 === 0 ? 12 : time.hour % 12;
+  return `${hour}:${String(time.minute).padStart(2, "0")} ${period}`;
+}
+
+export function formatHourLabel(hour: number): string {
+  if (hour === 24) {
+    return "Midnight";
+  }
+  return formatClockTime({ hour, minute: 0 });
+}
+
+function joinList(items: readonly string[]): string {
+  if (items.length <= 1) {
+    return items.join("");
+  }
+  if (items.length === 2) {
+    return `${items[0]} and ${items[1]}`;
+  }
+  return `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}`;
+}
+
+function sortedUnique(values: readonly number[]): number[] {
+  return [...new Set(values)].sort((a, b) => a - b);
+}
+
+/** Compress sorted values into cron list syntax: runs of 3+ become ranges. */
+export function compressCronList(values: readonly number[]): string {
+  const sorted = sortedUnique(values);
+  const parts: string[] = [];
+  let index = 0;
+  while (index < sorted.length) {
+    let end = index;
+    while (end + 1 < sorted.length && sorted[end + 1] === sorted[end] + 1) {
+      end += 1;
+    }
+    if (end - index >= 2) {
+      parts.push(`${sorted[index]}-${sorted[end]}`);
+    } else {
+      for (let i = index; i <= end; i += 1) {
+        parts.push(String(sorted[i]));
+      }
+    }
+    index = end + 1;
+  }
+  return parts.join(",");
+}
+
+export function describeDays(days: readonly number[]): string {
+  const key = sortedUnique(days).join(",");
+  if (key === ALL_DAYS.join(",")) {
+    return "Every day";
+  }
+  if (key === WEEKDAYS.join(",")) {
+    return "Weekdays";
+  }
+  if (key === WEEKENDS.join(",")) {
+    return "Weekends";
+  }
+  return joinList(
+    WEEKDAY_ORDER.filter((day) => days.includes(day)).map((day) => `${WEEKDAY_NAMES[day]}s`),
+  );
+}
+
+function describeTimes(times: readonly CadenceTime[]): string {
+  return joinList(
+    [...times]
+      .sort((a, b) => a.hour * 60 + a.minute - (b.hour * 60 + b.minute))
+      .map(formatClockTime),
+  );
+}
+
+// ---------------------------------------------------------------- time text
+
+/** Parse "9", "9:30", "9:30 pm", "21:30" or "0930". Returns null when unreadable. */
+export function parseClockTime(text: string): CadenceTime | null {
+  const match = text
+    .trim()
+    .toLowerCase()
+    .match(/^(\d{1,2})(?::?(\d{2}))?\s*(a|am|p|pm)?$/);
+  if (!match) {
+    return null;
+  }
+  let hour = Number.parseInt(match[1], 10);
+  const minute = match[2] === undefined ? 0 : Number.parseInt(match[2], 10);
+  const period = match[3];
+  if (minute > 59) {
+    return null;
+  }
+  if (period) {
+    if (hour < 1 || hour > 12) {
+      return null;
+    }
+    hour = (hour % 12) + (period.startsWith("p") ? 12 : 0);
+  } else if (hour > 23) {
+    return null;
+  }
+  return { hour, minute };
+}
+
+function timeEntry(id: number, value: CadenceTime): CadenceTimeEntry {
+  return { id, text: formatClockTime(value), value };
+}
+
+function nextTimeId(times: readonly CadenceTimeEntry[]): number {
+  return times.reduce((max, entry) => Math.max(max, entry.id), 0) + 1;
+}
+
+// ---------------------------------------------------------------- compile
+
+function compileClockTimes(input: {
+  times: readonly CadenceTimeEntry[];
+  dayOfMonth: string;
+  dayOfWeek: string;
+  errors: CadenceErrors;
+}): { expression: string | null; times: CadenceTime[] } {
+  if (input.times.length === 0) {
+    input.errors.times = "Add at least one time";
+    return { expression: null, times: [] };
+  }
+  if (input.times.some((entry) => entry.value === null)) {
+    input.errors.times = "Use a time like 9:00 AM";
+    return { expression: null, times: [] };
+  }
+  const times = input.times.map((entry) => entry.value as CadenceTime);
+  const minutes = new Set(times.map((time) => time.minute));
+  if (minutes.size > 1) {
+    input.errors.times = "All times need the same minute, like 9:00 AM and 5:00 PM";
+    return { expression: null, times };
+  }
+  const minute = times[0].minute;
+  const hours = compressCronList(times.map((time) => time.hour));
+  return {
+    expression: `${minute} ${hours} ${input.dayOfMonth} * ${input.dayOfWeek}`,
+    times,
+  };
+}
+
+function compileInterval(draft: CadenceDraft, errors: CadenceErrors): CompiledCadence {
+  const interval = draft.interval;
+  if (interval.windowed && interval.toHour <= interval.fromHour) {
+    errors.interval = "End hour must be after start hour";
+  } else if (interval.windowed && interval.days.length === 0) {
+    errors.interval = "Pick at least one day";
+  }
+  if (errors.interval) {
+    return { expression: null, summary: null, errors, clockTimes: [] };
+  }
+
+  const hourRange = interval.windowed ? `${interval.fromHour}-${interval.toHour - 1}` : "*";
+  const dayOfWeek = interval.windowed ? compressCronList(interval.days) : "*";
+  let expression: string;
+  let summary: string;
+  if (interval.unit === "minutes") {
+    const minute = interval.every === 1 ? "*" : `*/${interval.every}`;
+    expression = `${minute} ${hourRange} * * ${dayOfWeek}`;
+    summary = interval.every === 1 ? "Every minute" : `Every ${interval.every} minutes`;
+  } else {
+    let hour: string;
+    if (interval.every === 1) {
+      hour = hourRange;
+    } else if (interval.windowed) {
+      hour = `${hourRange}/${interval.every}`;
+    } else {
+      hour = `*/${interval.every}`;
+    }
+    expression = `${interval.offset} ${hour} * * ${dayOfWeek}`;
+    summary = interval.every === 1 ? "Every hour" : `Every ${interval.every} hours`;
+    if (interval.offset) {
+      summary += ` at :${String(interval.offset).padStart(2, "0")}`;
+    }
+  }
+  if (interval.windowed) {
+    summary += ` from ${formatHourLabel(interval.fromHour)} to ${formatHourLabel(interval.toHour)}`;
+    if (interval.days.length < 7) {
+      summary += `, ${describeDays(interval.days).toLowerCase()}`;
+    }
+  }
+  return { expression, summary, errors, clockTimes: [] };
+}
+
+export function compileCadence(draft: CadenceDraft): CompiledCadence {
+  const errors: CadenceErrors = {};
+  switch (draft.mode) {
+    case "interval":
+      return compileInterval(draft, errors);
+    case "daily": {
+      const result = compileClockTimes({
+        times: draft.times,
+        dayOfMonth: "*",
+        dayOfWeek: "*",
+        errors,
+      });
+      return {
+        expression: result.expression,
+        summary: result.expression ? `Every day at ${describeTimes(result.times)}` : null,
+        errors,
+        clockTimes: result.times,
+      };
+    }
+    case "weekly": {
+      if (draft.weekDays.length === 0) {
+        errors.weekDays = "Pick at least one day";
+        return { expression: null, summary: null, errors, clockTimes: [] };
+      }
+      const result = compileClockTimes({
+        times: draft.times,
+        dayOfMonth: "*",
+        dayOfWeek: compressCronList(draft.weekDays),
+        errors,
+      });
+      return {
+        expression: result.expression,
+        summary: result.expression
+          ? `${describeDays(draft.weekDays)} at ${describeTimes(result.times)}`
+          : null,
+        errors,
+        clockTimes: result.times,
+      };
+    }
+    case "monthly": {
+      const monthly = draft.monthly;
+      const nthStart = (monthly.nth - 1) * 7 + 1;
+      const result = compileClockTimes({
+        times: draft.times,
+        dayOfMonth: monthly.kind === "day" ? String(monthly.day) : `${nthStart}-${nthStart + 6}`,
+        dayOfWeek: monthly.kind === "day" ? "*" : String(monthly.weekday),
+        errors,
+      });
+      const day =
+        monthly.kind === "day"
+          ? ordinal(monthly.day)
+          : `${NTH_LABELS[monthly.nth]} ${WEEKDAY_NAMES[monthly.weekday]}`;
+      return {
+        expression: result.expression,
+        summary: result.expression
+          ? `Monthly on the ${day} at ${describeTimes(result.times)}`
+          : null,
+        errors,
+        clockTimes: result.times,
+      };
+    }
+    case "cron": {
+      const expression = normalizeCronText(draft.cronText);
+      if (!expression) {
+        errors.cron = "Enter a cron expression";
+        return { expression: null, summary: null, errors, clockTimes: [] };
+      }
+      try {
+        parseCronExpression(expression);
+      } catch (error) {
+        errors.cron = describeCronError(error instanceof Error ? error.message : "", expression);
+        return { expression: null, summary: null, errors, clockTimes: [] };
+      }
+      return {
+        expression,
+        summary: describeCronExpression(expression) ?? "Custom cron schedule",
+        errors,
+        clockTimes: [],
+      };
+    }
+  }
+}
+
+export function normalizeCronText(text: string): string {
+  return text.trim().split(/\s+/).filter(Boolean).join(" ");
+}
+
+const CRON_FIELD_HELP: Record<string, { label: string; range: string }> = {
+  minute: { label: "Minute", range: "0–59" },
+  hour: { label: "Hour", range: "0–23" },
+  "day-of-month": { label: "Day", range: "1–31" },
+  month: { label: "Month", range: "1–12" },
+  "day-of-week": { label: "Weekday", range: "0–6, Sunday is 0" },
+};
+const CRON_FIELD_ORDER = ["minute", "hour", "day-of-month", "month", "day-of-week"];
+
+/** Turn a parser message into copy that names the field and its allowed values. */
+export function describeCronError(message: string, expression: string): string {
+  const fields = expression.trim().split(/\s+/);
+  if (message.includes("5 fields")) {
+    return `Use 5 fields: minute hour day month weekday. This has ${fields.length}.`;
+  }
+  const field = message.match(/cron (minute|hour|day-of-month|month|day-of-week)/)?.[1];
+  if (!field) {
+    return message || "Invalid cron expression";
+  }
+  const help = CRON_FIELD_HELP[field];
+  const raw = fields[CRON_FIELD_ORDER.indexOf(field)] ?? "";
+  if (/[a-z]/i.test(raw)) {
+    return `${help.label} must use numbers (${help.range}). Names like ${raw.toUpperCase()} aren't supported.`;
+  }
+  if (message.includes("step")) {
+    return `${help.label} step must be a whole number above 0`;
+  }
+  return `${help.label} must be ${help.range}`;
+}
+
+/** Describe the cron shapes the builder can produce; anything else returns null. */
+export function describeCronExpression(expression: string): string | null {
+  const draft = draftFromExpression(expression, "UTC");
+  if (!draft) {
+    return null;
+  }
+  return compileCadence(draft).summary;
+}
+
+// ---------------------------------------------------------------- seed from cron
+
+function parseLiteralList(field: string, min: number, max: number): number[] | null {
+  if (!/^\d+(-\d+)?(,\d+(-\d+)?)*$/.test(field)) {
+    return null;
+  }
+  const values: number[] = [];
+  for (const part of field.split(",")) {
+    const [start, end] = part.split("-").map((value) => Number.parseInt(value, 10));
+    const last = end ?? start;
+    if (start > last || start < min || last > max) {
+      return null;
+    }
+    for (let value = start; value <= last; value += 1) {
+      values.push(value);
+    }
+  }
+  return sortedUnique(values);
+}
+
+function parseHourRange(field: string): { from: number; to: number } | null {
+  const match = field.match(/^(\d+)-(\d+)$/);
+  if (!match) {
+    return null;
+  }
+  const from = Number.parseInt(match[1], 10);
+  const last = Number.parseInt(match[2], 10);
+  return from <= last && last <= 23 ? { from, to: last + 1 } : null;
+}
+
+function minuteIntervalCandidate(input: {
+  minute: string;
+  hour: string;
+  days: number[] | null;
+}): Partial<IntervalDraft> | null {
+  const every = input.minute === "*" ? 1 : Number(input.minute.match(/^\*\/(\d+)$/)?.[1]);
+  if (!MINUTE_STEPS.includes(every)) {
+    return null;
+  }
+  const range = input.hour === "*" ? null : parseHourRange(input.hour);
+  if (input.hour !== "*" && !range) {
+    return null;
+  }
+  return {
+    unit: "minutes",
+    every,
+    windowed: range !== null || input.days !== null,
+    ...(range ? { fromHour: range.from, toHour: range.to } : {}),
+    ...(input.days ? { days: input.days } : {}),
+  };
+}
+
+function hourIntervalCandidate(input: {
+  minute: string;
+  hour: string;
+  days: number[] | null;
+}): Partial<IntervalDraft> | null {
+  const offset = /^\d+$/.test(input.minute) ? Number.parseInt(input.minute, 10) : Number.NaN;
+  const stepMatch = input.hour.match(/^(\*|\d+-\d+)(?:\/(\d+))?$/);
+  if (!(offset <= 59) || !stepMatch) {
+    return null;
+  }
+  const every = stepMatch[2] === undefined ? 1 : Number.parseInt(stepMatch[2], 10);
+  const range = stepMatch[1] === "*" ? null : parseHourRange(stepMatch[1]);
+  if ((stepMatch[1] !== "*" && !range) || !HOUR_STEPS.includes(every)) {
+    return null;
+  }
+  return {
+    unit: "hours",
+    every,
+    offset,
+    windowed: range !== null || input.days !== null,
+    ...(range ? { fromHour: range.from, toHour: range.to } : {}),
+    ...(input.days ? { days: input.days } : {}),
+  };
+}
+
+function intervalCandidate(fields: string[]): Partial<IntervalDraft> | null {
+  const [minute, hour, dayOfMonth, month, dayOfWeek] = fields;
+  if (dayOfMonth !== "*" || month !== "*") {
+    return null;
+  }
+  const days = dayOfWeek === "*" ? null : parseLiteralList(dayOfWeek, 0, 6);
+  if (dayOfWeek !== "*" && !days) {
+    return null;
+  }
+  return (
+    minuteIntervalCandidate({ minute, hour, days }) ?? hourIntervalCandidate({ minute, hour, days })
+  );
+}
+
+function clockTimesCandidate(minute: string, hour: string): CadenceTime[] | null {
+  if (!/^\d+$/.test(minute)) {
+    return null;
+  }
+  const hours = parseLiteralList(hour, 0, 23);
+  if (!hours || hours.length > MAX_TIMES) {
+    return null;
+  }
+  const minuteValue = Number.parseInt(minute, 10);
+  return minuteValue > 59 ? null : hours.map((value) => ({ hour: value, minute: minuteValue }));
+}
+
+function candidateDrafts(expression: string, base: CadenceDraft): CadenceDraft[] {
+  const fields = expression.split(" ");
+  if (fields.length !== 5) {
+    return [];
+  }
+  const [minute, hour, dayOfMonth, month, dayOfWeek] = fields;
+  const drafts: CadenceDraft[] = [];
+  const interval = intervalCandidate(fields);
+  if (interval) {
+    drafts.push({ ...base, mode: "interval", interval: { ...base.interval, ...interval } });
+  }
+  const clock = month === "*" ? clockTimesCandidate(minute, hour) : null;
+  if (!clock) {
+    return drafts;
+  }
+  const times = clock.map((time, index) => timeEntry(index + 1, time));
+  if (dayOfMonth === "*" && dayOfWeek === "*") {
+    drafts.push({ ...base, mode: "daily", times });
+  }
+  const weekDays = dayOfMonth === "*" ? parseLiteralList(dayOfWeek, 0, 6) : null;
+  if (weekDays) {
+    drafts.push({ ...base, mode: "weekly", times, weekDays });
+  }
+  if (/^\d+$/.test(dayOfMonth) && dayOfWeek === "*") {
+    const day = Number.parseInt(dayOfMonth, 10);
+    if (day >= 1 && day <= 31) {
+      drafts.push({
+        ...base,
+        mode: "monthly",
+        times,
+        monthly: { ...base.monthly, kind: "day", day },
+      });
+    }
+  }
+  const nthMatch = dayOfMonth.match(/^(\d+)-(\d+)$/);
+  const nthStart = nthMatch ? Number.parseInt(nthMatch[1], 10) : Number.NaN;
+  const nth = (nthStart - 1) / 7 + 1;
+  if (Number.isInteger(nth) && nth >= 1 && nth <= 4 && /^[0-6]$/.test(dayOfWeek)) {
+    drafts.push({
+      ...base,
+      mode: "monthly",
+      times,
+      monthly: {
+        ...base.monthly,
+        kind: "nth",
+        nth,
+        weekday: Number.parseInt(dayOfWeek, 10),
+      },
+    });
+  }
+  return drafts;
+}
+
+/**
+ * Open a cron expression in the builder mode that reproduces it exactly, or
+ * return null when no builder mode does.
+ */
+export function draftFromExpression(expression: string, timezone: string): CadenceDraft | null {
+  const normalized = normalizeCronText(expression);
+  const base = createDefaultCadenceDraft(timezone);
+  for (const candidate of candidateDrafts(normalized, base)) {
+    if (compileCadence(candidate).expression === normalized) {
+      return { ...candidate, cronText: normalized };
+    }
+  }
+  return null;
+}
+
+// ---------------------------------------------------------------- construct
+
+export function createDefaultCadenceDraft(timezone: string): CadenceDraft {
+  return {
+    mode: "daily",
+    interval: {
+      every: 15,
+      unit: "minutes",
+      offset: 0,
+      windowed: false,
+      fromHour: 9,
+      toHour: 17,
+      days: [...WEEKDAYS],
+    },
+    times: [timeEntry(1, { hour: 9, minute: 0 })],
+    weekDays: [1],
+    monthly: { kind: "day", day: 1, nth: 1, weekday: 1 },
+    cronText: "",
+    cronEdited: false,
+    builderChanged: false,
+    cronRevision: 0,
+    timezone,
+    legacyEveryMs: null,
+  };
+}
+
+/**
+ * Seed the builder from a saved cadence. A cron cadence without a time zone
+ * runs in UTC on the daemon, so it opens in UTC, not the device zone.
+ */
+export function createCadenceDraft(input: {
+  cadence: ScheduleCadence | undefined;
+  deviceTimeZone: string;
+}): CadenceDraft {
+  const { cadence, deviceTimeZone } = input;
+  if (!cadence) {
+    return createDefaultCadenceDraft(deviceTimeZone);
+  }
+  if (cadence.type === "every") {
+    // `*/1` is how the protocol spells every minute; the builder writes `*`.
+    const equivalent = everyMsToFiveFieldCron(cadence.everyMs)?.replace(/^\*\/1 /, "* ");
+    const seeded =
+      (equivalent ? draftFromExpression(equivalent, deviceTimeZone) : null) ??
+      createDefaultCadenceDraft(deviceTimeZone);
+    return { ...seeded, legacyEveryMs: cadence.everyMs };
+  }
+  const timezone = cadence.timezone ?? "UTC";
+  const expression = normalizeCronText(cadence.expression);
+  return (
+    draftFromExpression(expression, timezone) ?? {
+      ...createDefaultCadenceDraft(timezone),
+      mode: "cron",
+      cronText: expression,
+      cronEdited: true,
+    }
+  );
+}
+
+export function cadenceFromDraft(draft: CadenceDraft): CronCadence | null {
+  const { expression } = compileCadence(draft);
+  return expression ? { type: "cron", expression, timezone: draft.timezone } : null;
+}
+
+// ---------------------------------------------------------------- reducers
+
+function touched(draft: CadenceDraft, patch: Partial<CadenceDraft>): CadenceDraft {
+  return { ...draft, ...patch, builderChanged: true, legacyEveryMs: null };
+}
+
+export function setCadenceMode(draft: CadenceDraft, mode: CadenceMode): CadenceDraft {
+  if (mode === draft.mode) {
+    return draft;
+  }
+  if (mode === "cron") {
+    // Carry the builder's expression into the cron field unless the user has
+    // typed their own and the builder has not changed since.
+    const compiled = compileCadence(draft).expression;
+    const refill = compiled && (!draft.cronEdited || draft.builderChanged);
+    return {
+      ...draft,
+      mode,
+      legacyEveryMs: null,
+      ...(refill
+        ? {
+            cronText: compiled,
+            cronEdited: false,
+            builderChanged: false,
+            cronRevision: draft.cronRevision + 1,
+          }
+        : {}),
+    };
+  }
+  // Switching modes is not a builder edit: typed cron text survives a round trip.
+  return { ...draft, mode, legacyEveryMs: null };
+}
+
+export function setIntervalEvery(draft: CadenceDraft, every: number): CadenceDraft {
+  return touched(draft, { interval: { ...draft.interval, every } });
+}
+
+export function setIntervalUnit(draft: CadenceDraft, unit: IntervalUnit): CadenceDraft {
+  if (unit === draft.interval.unit) {
+    return draft;
+  }
+  return touched(draft, {
+    interval: { ...draft.interval, unit, every: unit === "minutes" ? 15 : 1 },
+  });
+}
+
+export function setIntervalOffset(draft: CadenceDraft, offset: number): CadenceDraft {
+  return touched(draft, { interval: { ...draft.interval, offset } });
+}
+
+export function setIntervalWindowed(draft: CadenceDraft, windowed: boolean): CadenceDraft {
+  return touched(draft, { interval: { ...draft.interval, windowed } });
+}
+
+export function setIntervalHours(
+  draft: CadenceDraft,
+  hours: { fromHour?: number; toHour?: number },
+): CadenceDraft {
+  return touched(draft, { interval: { ...draft.interval, ...hours } });
+}
+
+function toggle(days: readonly number[], day: number): number[] {
+  return days.includes(day) ? days.filter((value) => value !== day) : sortedUnique([...days, day]);
+}
+
+export function toggleIntervalDay(draft: CadenceDraft, day: number): CadenceDraft {
+  return touched(draft, {
+    interval: { ...draft.interval, days: toggle(draft.interval.days, day) },
+  });
+}
+
+export function toggleWeekDay(draft: CadenceDraft, day: number): CadenceDraft {
+  return touched(draft, { weekDays: toggle(draft.weekDays, day) });
+}
+
+export type WeekDayPreset = "weekdays" | "weekends" | "all";
+
+export function setWeekDayPreset(draft: CadenceDraft, preset: WeekDayPreset): CadenceDraft {
+  const weekDays = { weekdays: WEEKDAYS, weekends: WEEKENDS, all: ALL_DAYS }[preset];
+  return touched(draft, { weekDays: [...weekDays] });
+}
+
+export function setTimeText(draft: CadenceDraft, id: number, text: string): CadenceDraft {
+  return touched(draft, {
+    times: draft.times.map((entry) =>
+      entry.id === id ? { ...entry, text, value: parseClockTime(text) } : entry,
+    ),
+  });
+}
+
+export function addTime(draft: CadenceDraft): CadenceDraft {
+  if (draft.times.length >= MAX_TIMES) {
+    return draft;
+  }
+  let last: CadenceTime = { hour: 8, minute: 0 };
+  for (const entry of draft.times) {
+    last = entry.value ?? last;
+  }
+  const next = { hour: Math.min(23, last.hour + 4), minute: last.minute };
+  return touched(draft, { times: [...draft.times, timeEntry(nextTimeId(draft.times), next)] });
+}
+
+export function removeTime(draft: CadenceDraft, id: number): CadenceDraft {
+  if (draft.times.length <= 1) {
+    return draft;
+  }
+  return touched(draft, { times: draft.times.filter((entry) => entry.id !== id) });
+}
+
+export function setMonthly(draft: CadenceDraft, patch: Partial<MonthlyDraft>): CadenceDraft {
+  return touched(draft, { monthly: { ...draft.monthly, ...patch } });
+}
+
+export function setCronText(draft: CadenceDraft, cronText: string): CadenceDraft {
+  return { ...draft, cronText, cronEdited: true, legacyEveryMs: null };
+}
+
+export function setCadenceTimezone(draft: CadenceDraft, timezone: string): CadenceDraft {
+  return { ...draft, timezone, legacyEveryMs: null };
+}
+
+export function monthDayHint(monthly: MonthlyDraft): string | null {
+  if (monthly.kind !== "day" || monthly.day < 29) {
+    return null;
+  }
+  if (monthly.day === 29) {
+    return "Skips February except in leap years";
+  }
+  return `Skips months without a ${ordinal(monthly.day)}`;
+}
