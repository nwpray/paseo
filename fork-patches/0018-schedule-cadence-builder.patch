diff --git a/packages/app/src/schedules/schedule-cadence-state.ts b/packages/app/src/schedules/schedule-cadence-state.ts
new file mode 100644
index 000000000..9e987a582
--- /dev/null
+++ b/packages/app/src/schedules/schedule-cadence-state.ts
@@ -0,0 +1,217 @@
+import type { ScheduleCadence } from "@getpaseo/protocol/schedule/types";
+import {
+  cadenceFromDraft,
+  compileCadence,
+  createCadenceDraft,
+  type CadenceDraft,
+  type CompiledCadence,
+  type CronCadence,
+} from "./cadence-builder";
+import { computeCadencePreview, type CadencePreview } from "./cadence-preview";
+import {
+  createEndsDraft,
+  endsError,
+  resolveEndsSubmit,
+  resolveExpiresAt,
+  resolveMaxRuns,
+  type EndsDraft,
+  type EndsSubmit,
+} from "./schedule-ends";
+
+// Cadence + Ends slice of the schedule form model. Pure: the form model owns
+// the instance and calls `deriveCadenceState` on every publish.
+
+export type CompletedRunsStatus = "idle" | "pending" | "complete" | "failed";
+
+export interface CompletedRuns {
+  status: CompletedRunsStatus;
+  count: number | null;
+}
+
+export type CadencePreviewState =
+  | { status: "loading" }
+  | { status: "invalid" }
+  | {
+      status: "ready";
+      preview: CadencePreview;
+      /** False when edit could not load how many runs already happened. */
+      remainingRunsKnown: boolean;
+      maxRuns: number | null;
+      expiresAt: number | null;
+    };
+
+export interface ScheduleCadenceInputs {
+  mode: "create" | "edit";
+  draft: CadenceDraft;
+  /** The user changed the cadence; edit submits a cadence only then. */
+  touched: boolean;
+  ends: EndsDraft;
+  completedRuns: CompletedRuns;
+  savedCadence: ScheduleCadence | null;
+  savedNextRunAt: string | null;
+  now: number;
+}
+
+export interface ScheduleCadenceState extends ScheduleCadenceInputs {
+  compiled: CompiledCadence;
+  /** The cadence the form describes: the untouched saved cadence, or the compiled one. */
+  cadence: ScheduleCadence | null;
+  submitCadence: CronCadence | undefined;
+  submitEnds: EndsSubmit | null;
+  endsError: string | null;
+  preview: CadencePreviewState;
+  /** Why the cadence cannot be saved even though every field parses. */
+  blocker: string | null;
+}
+
+export function createScheduleCadenceInputs(input: {
+  mode: "create" | "edit";
+  schedule:
+    | {
+        cadence: ScheduleCadence;
+        expiresAt: string | null;
+        maxRuns: number | null;
+        nextRunAt: string | null;
+      }
+    | undefined;
+  deviceTimeZone: string;
+  now: number;
+}): ScheduleCadenceInputs {
+  const draft = createCadenceDraft({
+    cadence: input.schedule?.cadence,
+    deviceTimeZone: input.deviceTimeZone,
+  });
+  return {
+    mode: input.mode,
+    draft,
+    touched: false,
+    ends: createEndsDraft({
+      expiresAt: input.schedule?.expiresAt,
+      maxRuns: input.schedule?.maxRuns,
+      timezone: draft.timezone,
+      now: input.now,
+    }),
+    completedRuns:
+      input.mode === "edit" ? { status: "pending", count: null } : { status: "complete", count: 0 },
+    savedCadence: input.schedule?.cadence ?? null,
+    savedNextRunAt: input.schedule?.nextRunAt ?? null,
+    now: input.now,
+  };
+}
+
+function resolveCadence(inputs: ScheduleCadenceInputs): ScheduleCadence | null {
+  if (inputs.draft.legacyEveryMs !== null && inputs.savedCadence?.type === "every") {
+    return inputs.savedCadence;
+  }
+  if (!inputs.touched && inputs.savedCadence && inputs.mode === "edit") {
+    const compiled = cadenceFromDraft(inputs.draft);
+    return compiled ?? inputs.savedCadence;
+  }
+  return cadenceFromDraft(inputs.draft);
+}
+
+function previewKey(inputs: ScheduleCadenceInputs, cadence: ScheduleCadence | null): string {
+  return JSON.stringify([
+    cadence,
+    inputs.draft.timezone,
+    inputs.ends.kind,
+    inputs.ends.dateText,
+    inputs.ends.runsText,
+    inputs.ends.touched,
+    inputs.completedRuns,
+    inputs.savedNextRunAt,
+    Math.floor(inputs.now / 60_000),
+  ]);
+}
+
+export interface CadenceStateCache {
+  key: string | null;
+  preview: CadencePreviewState | null;
+}
+
+export function createCadenceStateCache(): CadenceStateCache {
+  return { key: null, preview: null };
+}
+
+function computePreviewState(input: {
+  inputs: ScheduleCadenceInputs;
+  cadence: ScheduleCadence | null;
+  compiled: CompiledCadence;
+}): CadencePreviewState {
+  const { inputs, cadence, compiled } = input;
+  if (!cadence || endsError(inputs.ends)) {
+    return { status: "invalid" };
+  }
+  const maxRuns = resolveMaxRuns(inputs.ends);
+  if (maxRuns !== null && inputs.completedRuns.status === "pending") {
+    return { status: "loading" };
+  }
+  const timezone = cadence.type === "cron" ? (cadence.timezone ?? "UTC") : inputs.draft.timezone;
+  const expiresAt = resolveExpiresAt(inputs.ends, timezone);
+  const remainingRunsKnown = maxRuns === null || inputs.completedRuns.count !== null;
+  const remainingRuns =
+    maxRuns === null ? null : Math.max(0, maxRuns - (inputs.completedRuns.count ?? 0));
+  const savedNextRunAt = inputs.savedNextRunAt ? Date.parse(inputs.savedNextRunAt) : Number.NaN;
+  const preview = computeCadencePreview({
+    source:
+      cadence.type === "every"
+        ? {
+            type: "every",
+            everyMs: cadence.everyMs,
+            nextRunAt: Number.isFinite(savedNextRunAt) ? savedNextRunAt : null,
+            timezone,
+          }
+        : { type: "cron", expression: cadence.expression, timezone },
+    now: inputs.now,
+    expiresAt,
+    remainingRuns: remainingRunsKnown ? remainingRuns : null,
+    clockTimes: cadence.type === "cron" ? compiled.clockTimes : [],
+  });
+  return { status: "ready", preview, remainingRunsKnown, maxRuns, expiresAt };
+}
+
+export function deriveCadenceState(
+  inputs: ScheduleCadenceInputs,
+  cache: CadenceStateCache,
+): ScheduleCadenceState {
+  const compiled = compileCadence(inputs.draft);
+  const cadence = resolveCadence(inputs);
+  const key = previewKey(inputs, cadence);
+  if (cache.key !== key || !cache.preview) {
+    cache.key = key;
+    cache.preview = computePreviewState({ inputs, cadence, compiled });
+  }
+  const preview = cache.preview;
+  const compiledCadence = cadenceFromDraft(inputs.draft);
+  const submitCadence =
+    inputs.mode === "create" || inputs.touched ? (compiledCadence ?? undefined) : undefined;
+  const blocker =
+    preview.status === "ready" && preview.preview.status === "never"
+      ? "This never runs. No date in the next year matches."
+      : null;
+  return {
+    ...inputs,
+    compiled,
+    cadence,
+    submitCadence,
+    submitEnds: resolveEndsSubmit({
+      draft: inputs.ends,
+      timezone: inputs.draft.timezone,
+      mode: inputs.mode,
+    }),
+    endsError: endsError(inputs.ends),
+    preview,
+    blocker,
+  };
+}
+
+/** Whether the cadence and Ends fields allow submitting. */
+export function cadenceAllowsSubmit(state: ScheduleCadenceState): boolean {
+  if (state.endsError || state.blocker) {
+    return false;
+  }
+  if (state.mode === "edit" && !state.touched) {
+    return state.cadence !== null;
+  }
+  return state.submitCadence !== undefined;
+}
diff --git a/packages/app/src/schedules/schedule-ends.ts b/packages/app/src/schedules/schedule-ends.ts
new file mode 100644
index 000000000..5df28101e
--- /dev/null
+++ b/packages/app/src/schedules/schedule-ends.ts
@@ -0,0 +1,166 @@
+import { readLocalParts, startOfLocalDay } from "./cadence-preview";
+
+// How a schedule ends: never, after a date (expiresAt), or after a number of
+// runs (maxRuns). The daemon counts maxRuns over every finished run, so an
+// edited schedule has `maxRuns - completedRuns` runs left.
+
+export type EndsKind = "never" | "date" | "runs";
+
+export interface EndsDraft {
+  kind: EndsKind;
+  /** YYYY-MM-DD, the last day runs can happen, in the cadence time zone. */
+  dateText: string;
+  runsText: string;
+  /** The user changed Ends; until then edit submits neither field. */
+  touched: boolean;
+  savedExpiresAt: string | null;
+  savedMaxRuns: number | null;
+}
+
+export interface EndsSubmit {
+  expiresAt: string | null;
+  maxRuns: number | null;
+}
+
+export function createEndsDraft(input: {
+  expiresAt: string | null | undefined;
+  maxRuns: number | null | undefined;
+  timezone: string;
+  now: number;
+}): EndsDraft {
+  const savedExpiresAt = input.expiresAt ?? null;
+  const savedMaxRuns = input.maxRuns ?? null;
+  const expiresAt = savedExpiresAt ? Date.parse(savedExpiresAt) : Number.NaN;
+  let kind: EndsKind = "never";
+  if (savedMaxRuns !== null) {
+    kind = "runs";
+  } else if (Number.isFinite(expiresAt)) {
+    kind = "date";
+  }
+  return {
+    kind,
+    dateText: Number.isFinite(expiresAt)
+      ? formatDateText(expiresAt - 1, input.timezone)
+      : defaultEndDate(input.now, input.timezone),
+    runsText: savedMaxRuns !== null ? String(savedMaxRuns) : "10",
+    touched: false,
+    savedExpiresAt,
+    savedMaxRuns,
+  };
+}
+
+function formatDateText(at: number, timezone: string): string {
+  const parts = readLocalParts(at, timezone);
+  return `${parts.year}-${String(parts.month).padStart(2, "0")}-${String(parts.dayOfMonth).padStart(2, "0")}`;
+}
+
+function defaultEndDate(now: number, timezone: string): string {
+  const parts = readLocalParts(now, timezone);
+  const date = new Date(Date.UTC(parts.year, parts.month - 1, parts.dayOfMonth + 30));
+  return formatDateText(
+    Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate(), 12),
+    "UTC",
+  );
+}
+
+export function parseDateText(text: string): { year: number; month: number; day: number } | null {
+  const match = text.trim().match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
+  if (!match) {
+    return null;
+  }
+  const year = Number.parseInt(match[1], 10);
+  const month = Number.parseInt(match[2], 10);
+  const day = Number.parseInt(match[3], 10);
+  const date = new Date(Date.UTC(year, month - 1, day));
+  if (
+    date.getUTCFullYear() !== year ||
+    date.getUTCMonth() !== month - 1 ||
+    date.getUTCDate() !== day
+  ) {
+    return null;
+  }
+  return { year, month, day };
+}
+
+export function parseRunsText(text: string): number | null {
+  const trimmed = text.trim();
+  if (!/^\d+$/.test(trimmed)) {
+    return null;
+  }
+  const value = Number.parseInt(trimmed, 10);
+  return value >= 1 ? value : null;
+}
+
+export function endsError(draft: EndsDraft): string | null {
+  if (draft.kind === "runs" && parseRunsText(draft.runsText) === null) {
+    return "Enter 1 or more runs";
+  }
+  if (draft.kind === "date" && parseDateText(draft.dateText) === null) {
+    return "Use a date like 2026-12-31";
+  }
+  return null;
+}
+
+/** The instant runs stop: midnight after the end date in the cadence time zone. */
+export function resolveExpiresAt(draft: EndsDraft, timezone: string): number | null {
+  if (!draft.touched && draft.savedExpiresAt) {
+    const saved = Date.parse(draft.savedExpiresAt);
+    return Number.isFinite(saved) ? saved : null;
+  }
+  if (draft.kind !== "date") {
+    return null;
+  }
+  const date = parseDateText(draft.dateText);
+  if (!date) {
+    return null;
+  }
+  const next = new Date(Date.UTC(date.year, date.month - 1, date.day + 1));
+  return startOfLocalDay(
+    { year: next.getUTCFullYear(), month: next.getUTCMonth() + 1, day: next.getUTCDate() },
+    timezone,
+  );
+}
+
+export function resolveMaxRuns(draft: EndsDraft): number | null {
+  if (!draft.touched) {
+    return draft.savedMaxRuns;
+  }
+  return draft.kind === "runs" ? parseRunsText(draft.runsText) : null;
+}
+
+/**
+ * Fields to send. Null means leave the saved values alone: an untouched edit
+ * keeps whatever the daemon has, including both limits set from the CLI.
+ */
+export function resolveEndsSubmit(input: {
+  draft: EndsDraft;
+  timezone: string;
+  mode: "create" | "edit";
+}): EndsSubmit | null {
+  const { draft } = input;
+  if (input.mode === "edit" && !draft.touched) {
+    return null;
+  }
+  const expiresAt = resolveExpiresAt(draft, input.timezone);
+  return {
+    expiresAt: expiresAt === null ? null : new Date(expiresAt).toISOString(),
+    maxRuns: resolveMaxRuns(draft),
+  };
+}
+
+/** An end date is a wall date, so a new time zone moves its instant. */
+export function followTimezone(draft: EndsDraft): EndsDraft {
+  return draft.kind === "date" ? { ...draft, touched: true } : draft;
+}
+
+export function setEndsKind(draft: EndsDraft, kind: EndsKind): EndsDraft {
+  return { ...draft, kind, touched: true };
+}
+
+export function setEndsDate(draft: EndsDraft, dateText: string): EndsDraft {
+  return { ...draft, dateText, touched: true };
+}
+
+export function setEndsRuns(draft: EndsDraft, runsText: string): EndsDraft {
+  return { ...draft, runsText, touched: true };
+}
