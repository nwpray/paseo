@@ -0,0 +1,135 @@
+import { describe, expect, it } from "vitest";
+import {
+  addTime,
+  compileCadence,
+  createCadenceDraft,
+  createDefaultCadenceDraft,
+  describeCronError,
+  draftFromExpression,
+  parseClockTime,
+  setCadenceMode,
+  setCronText,
+  setIntervalWindowed,
+  setMonthly,
+  setTimeText,
+  toggleWeekDay,
+} from "./cadence-builder";
+
+describe("cadence builder", () => {
+  it.each([
+    ["* * * * *", "interval", "Every minute"],
+    ["*/15 * * * *", "interval", "Every 15 minutes"],
+    ["*/20 9-16 * * 1-5", "interval", "Every 20 minutes from 9:00 AM to 5:00 PM, weekdays"],
+    ["0 * * * *", "interval", "Every hour"],
+    ["30 */4 * * *", "interval", "Every 4 hours at :30"],
+    ["0 9 * * *", "daily", "Every day at 9:00 AM"],
+    ["0 9,13,17 * * *", "daily", "Every day at 9:00 AM, 1:00 PM and 5:00 PM"],
+    ["30 8 * * 1,3,5", "weekly", "Mondays, Wednesdays and Fridays at 8:30 AM"],
+    ["0 9 * * 1-5", "weekly", "Weekdays at 9:00 AM"],
+    ["0 9 31 * *", "monthly", "Monthly on the 31st at 9:00 AM"],
+    ["0 10 8-14 * 2", "monthly", "Monthly on the second Tuesday at 10:00 AM"],
+  ])("opens %s in %s mode and compiles it back unchanged", (expression, mode, summary) => {
+    const draft = draftFromExpression(expression, "America/Denver");
+    expect(draft?.mode).toBe(mode);
+    const compiled = compileCadence(draft!);
+    expect(compiled.expression).toBe(expression);
+    expect(compiled.summary).toBe(summary);
+  });
+
+  it.each([
+    "5 4 */3 * *",
+    "0 9 * 1 *",
+    "*/7 * * * *",
+    "0 9 2-8 * 2",
+    "0 9 1,15 * *",
+    "7 */5 * * *",
+  ])("keeps %s as custom cron because no builder mode reproduces it", (expression) => {
+    const draft = createCadenceDraft({
+      cadence: { type: "cron", expression, timezone: "UTC" },
+      deviceTimeZone: "America/Denver",
+    });
+    expect(draft.mode).toBe("cron");
+    expect(compileCadence(draft).expression).toBe(expression);
+  });
+
+  it("opens a cron cadence without a time zone in UTC, where the daemon runs it", () => {
+    const draft = createCadenceDraft({
+      cadence: { type: "cron", expression: "0 9 * * *" },
+      deviceTimeZone: "America/Denver",
+    });
+    expect(draft.timezone).toBe("UTC");
+  });
+
+  it("starts new schedules daily at 9:00 AM in the device time zone", () => {
+    const draft = createCadenceDraft({ cadence: undefined, deviceTimeZone: "Europe/Berlin" });
+    expect(compileCadence(draft).expression).toBe("0 9 * * *");
+    expect(draft.timezone).toBe("Europe/Berlin");
+  });
+
+  it("requires one minute across times, which a single cron rule needs", () => {
+    let draft = createDefaultCadenceDraft("UTC");
+    draft = addTime(draft);
+    draft = setTimeText(draft, draft.times[1].id, "5:30 PM");
+    expect(compileCadence(draft).errors.times).toBe(
+      "All times need the same minute, like 9:00 AM and 5:00 PM",
+    );
+    draft = setTimeText(draft, draft.times[1].id, "17:00");
+    expect(compileCadence(draft).expression).toBe("0 9,17 * * *");
+  });
+
+  it("reports unreadable times and empty day choices", () => {
+    let draft = createDefaultCadenceDraft("UTC");
+    draft = setTimeText(draft, draft.times[0].id, "25:00");
+    expect(compileCadence(draft).errors.times).toBe("Use a time like 9:00 AM");
+    draft = setCadenceMode(createDefaultCadenceDraft("UTC"), "weekly");
+    draft = toggleWeekDay(draft, 1);
+    expect(compileCadence(draft).errors.weekDays).toBe("Pick at least one day");
+  });
+
+  it("windows an interval to hours and days", () => {
+    let draft = setCadenceMode(createDefaultCadenceDraft("UTC"), "interval");
+    draft = setIntervalWindowed(draft, true);
+    expect(compileCadence(draft).expression).toBe("*/15 9-16 * * 1-5");
+  });
+
+  it("compiles the nth weekday as day-of-month AND weekday", () => {
+    let draft = setCadenceMode(createDefaultCadenceDraft("UTC"), "monthly");
+    draft = setMonthly(draft, { kind: "nth", nth: 4, weekday: 5 });
+    expect(compileCadence(draft).expression).toBe("0 9 22-28 * 5");
+  });
+
+  it("fills the cron field from the builder but keeps typed cron text", () => {
+    let draft = setCadenceMode(createDefaultCadenceDraft("UTC"), "cron");
+    expect(draft.cronText).toBe("0 9 * * *");
+    draft = setCronText(draft, "5 4 */3 * *");
+    draft = setCadenceMode(setCadenceMode(draft, "daily"), "cron");
+    expect(draft.cronText).toBe("5 4 */3 * *");
+    draft = setCadenceMode(addTime(setCadenceMode(draft, "daily")), "cron");
+    expect(draft.cronText).toBe("0 9,13 * * *");
+  });
+
+  it("explains cron errors by field", () => {
+    expect(describeCronError("Invalid cron day-of-week value", "0 9 * * MON-FRI")).toBe(
+      "Weekday must use numbers (0–6, Sunday is 0). Names like MON-FRI aren't supported.",
+    );
+    expect(describeCronError("Cron expressions must have 5 fields", "0 9 * *")).toBe(
+      "Use 5 fields: minute hour day month weekday. This has 4.",
+    );
+    expect(describeCronError("Invalid cron hour value", "0 24 * * *")).toBe("Hour must be 0–23");
+    expect(describeCronError("Invalid cron minute step", "*/0 * * * *")).toBe(
+      "Minute step must be a whole number above 0",
+    );
+  });
+
+  it.each([
+    ["9", { hour: 9, minute: 0 }],
+    ["9:30 pm", { hour: 21, minute: 30 }],
+    ["12:00 AM", { hour: 0, minute: 0 }],
+    ["21:05", { hour: 21, minute: 5 }],
+    ["0930", { hour: 9, minute: 30 }],
+    ["13 pm", null],
+    ["9:60", null],
+  ])("reads %s as a clock time", (text, expected) => {
+    expect(parseClockTime(text)).toEqual(expected);
+  });
+});
