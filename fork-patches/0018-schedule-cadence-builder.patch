+      now: NOW,
+      expiresAt: null,
+      remainingRuns: null,
+      clockTimes: [],
+    });
+    expect(preview.entries.slice(0, 2).map((entry) => iso(entry.at))).toEqual([
+      "2026-10-29T16:25:00.000Z",
+      "2026-10-29T17:55:00.000Z",
+    ]);
+  });
+
+  it("formats UTC offsets, including half hours", () => {
+    expect(formatUtcOffset(DENVER, NOW)).toBe("UTC−6");
+    expect(formatUtcOffset("Asia/Kolkata", NOW)).toBe("UTC+5:30");
+    expect(formatUtcOffset("UTC", NOW)).toBe("UTC+0");
+  });
