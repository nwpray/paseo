new file mode 100644
index 000000000..6341dde3c
--- /dev/null
+++ b/packages/app/src/schedules/use-schedule-cadence-inputs.ts
@@ -0,0 +1,56 @@
+import { useEffect } from "react";
+import { useFetchQuery } from "@/data/query";
+import { useHostRuntimeClient, useHostRuntimeIsConnected } from "@/runtime/host-runtime";
+import type { ScheduleFormModel } from "./schedule-form-model";
+
+const PREVIEW_REFRESH_MS = 60_000;
+
+/**
+ * Late inputs of the cadence preview: how many runs the edited schedule has
+ * finished (maxRuns counts them), and a minute clock for relative times.
+ */
+export function useScheduleCadenceInputs(input: {
+  model: ScheduleFormModel;
+  mode: "create" | "edit";
+  serverId: string;
+  scheduleId: string | null;
+}): void {
+  const { model, mode, serverId, scheduleId } = input;
+  const client = useHostRuntimeClient(serverId);
+  const isConnected = useHostRuntimeIsConnected(serverId);
+  const enabled = mode === "edit" && Boolean(scheduleId && client && isConnected);
+  const query = useFetchQuery({
+    queryKey: ["schedule-completed-runs", serverId, scheduleId],
+    enabled,
+    dataShape: "value",
+    staleTimeMs: 0,
+    retry: 1,
+    queryFn: async () => {
+      if (!client || !scheduleId) {
+        throw new Error("Host is not connected");
+      }
+      const payload = await client.scheduleInspect({ id: scheduleId });
+      if (payload.error || !payload.schedule) {
+        throw new Error(payload.error ?? "Schedule not found");
+      }
+      // The daemon counts every finished run toward maxRuns.
+      return payload.schedule.runs.filter((run) => run.status !== "running").length;
+    },
+  });
+
+  useEffect(() => {
+    if (mode !== "edit") {
+      return;
+    }
+    if (query.status === "success") {
+      model.applyCompletedRuns(query.data);
+    } else if (query.status === "error" || (!isConnected && query.status === "pending")) {
+      model.applyCompletedRuns(null);
+    }
+  }, [isConnected, mode, model, query.data, query.status]);
+
+  useEffect(() => {
+    const timer = setInterval(() => model.refreshPreview(), PREVIEW_REFRESH_MS);
+    return () => clearInterval(timer);
+  }, [model]);
+}
diff --git a/packages/protocol/src/schedule/cron-next-run.test.ts b/packages/protocol/src/schedule/cron-next-run.test.ts
new file mode 100644
index 000000000..ba5865a2b
--- /dev/null
+++ b/packages/protocol/src/schedule/cron-next-run.test.ts
@@ -0,0 +1,108 @@
+import { describe, expect, it } from "vitest";
+import { parseCronExpression } from "./cron-expression.js";
+import {
+  computeNextCronRunAt,
+  createCronDatePartsReader,
+  CRON_SEARCH_LIMIT_MINUTES,
+} from "./cron-next-run.js";
+
+// The daemon's original matcher: test every minute in turn.
+function walkEveryMinute(expression: string, timezone: string | undefined, after: Date) {
+  const cron = parseCronExpression(expression);
+  const read = createCronDatePartsReader(timezone);
+  let t = Math.floor(after.getTime() / 60_000) * 60_000 + 60_000;
+  for (let i = 0; i < CRON_SEARCH_LIMIT_MINUTES; i += 1) {
+    const p = read(new Date(t));
+    if (
+      cron.minute.matches(p.minute) &&
+      cron.hour.matches(p.hour) &&
+      cron.dayOfMonth.matches(p.dayOfMonth) &&
+      cron.month.matches(p.month) &&
+      cron.dayOfWeek.matches(p.dayOfWeek)
+    ) {
+      return new Date(t);
+    }
+    t += 60_000;
+  }
+  return null;
+}
+
+function nextRuns(expression: string, timezone: string | undefined, from: string, count: number) {
+  const runs: string[] = [];
+  let after = new Date(from);
+  for (let i = 0; i < count; i += 1) {
+    const next = computeNextCronRunAt({ expression, timezone, after });
+    if (!next) {
+      break;
+    }
+    runs.push(next.toISOString());
+    after = next;
+  }
+  return runs;
+}
+
+describe("computeNextCronRunAt", () => {
+  const cases: Array<[string, string | undefined, string]> = [
+    ["30 1 * * *", "America/New_York", "2026-10-31T12:00:00.000Z"],
+    ["30 2 * * *", "America/New_York", "2027-03-13T12:00:00.000Z"],
+    ["0 9 31 * *", "Europe/Berlin", "2026-01-15T00:00:00.000Z"],
+    ["0 10 8-14 * 2", "America/Denver", "2026-10-29T16:15:00.000Z"],
+    ["*/20 9-16 * * 1-5", "Asia/Kolkata", "2026-10-29T16:15:00.000Z"],
+    ["0 0 29 2 *", "UTC", "2026-03-01T00:00:00.000Z"],
+    ["5 4 */3 * *", undefined, "2026-10-29T16:15:00.000Z"],
+    ["0 */4 * * 0,6", "Australia/Lord_Howe", "2026-10-02T00:00:00.000Z"],
+    ["15 0 * * *", "America/Sao_Paulo", "2026-10-29T16:15:00.000Z"],
+  ];
+
+  it.each(cases)("matches the minute walk for %s in %s", (expression, timezone, from) => {
+    let after = new Date(from);
+    for (let i = 0; i < 6; i += 1) {
+      const expected = walkEveryMinute(expression, timezone, after);
+      const actual = computeNextCronRunAt({ expression, timezone, after });
+      expect(actual?.toISOString()).toBe(expected?.toISOString());
+      if (!actual) {
+        break;
+      }
+      after = actual;
+    }
+  });
+
+  it("runs a repeated fall-back wall time twice", () => {
+    expect(nextRuns("30 1 * * *", "America/New_York", "2026-10-31T12:00:00.000Z", 3)).toEqual([
+      "2026-11-01T05:30:00.000Z",
+      "2026-11-01T06:30:00.000Z",
+      "2026-11-02T06:30:00.000Z",
+    ]);
+  });
+
+  it("skips a spring-forward wall time that does not exist", () => {
+    expect(nextRuns("30 2 * * *", "America/New_York", "2027-03-13T12:00:00.000Z", 2)).toEqual([
+      "2027-03-15T06:30:00.000Z",
+      "2027-03-16T06:30:00.000Z",
+    ]);
+  });
+
+  it("skips months without the requested day", () => {
+    expect(nextRuns("0 9 31 * *", "UTC", "2027-01-01T00:00:00.000Z", 3)).toEqual([
+      "2027-01-31T09:00:00.000Z",
+      "2027-03-31T09:00:00.000Z",
+      "2027-05-31T09:00:00.000Z",
+    ]);
+  });
+
+  it("returns null when nothing matches within the search limit", () => {
+    expect(
+      computeNextCronRunAt({
+        expression: "0 9 30 2 *",
+        timezone: "UTC",
+        after: new Date("2026-10-29T00:00:00.000Z"),
+      }),
+    ).toBeNull();
+  });
+
+  it("rejects invalid time zones", () => {
+    expect(() =>
+      computeNextCronRunAt({ expression: "0 9 * * *", timezone: "Not/AZone", after: new Date() }),
+    ).toThrow("Invalid cron time zone: Not/AZone");
+  });
+});
diff --git a/packages/protocol/src/schedule/cron-next-run.ts b/packages/protocol/src/schedule/cron-next-run.ts
new file mode 100644
index 000000000..d597c351b
--- /dev/null
+++ b/packages/protocol/src/schedule/cron-next-run.ts
@@ -0,0 +1,143 @@
+import { parseCronExpression, type ParsedCronExpression } from "./cron-expression.js";
+
+/** Wall-clock fields of one instant, read in the cadence time zone. */
+export interface CronDateParts {
+  year: number;
+  minute: number;
+  hour: number;
+  dayOfMonth: number;
+  month: number;
+  dayOfWeek: number;
+}
+
+export type CronDatePartsReader = (date: Date) => CronDateParts;
+
+const MS_PER_MINUTE = 60_000;
+const MINUTES_PER_DAY = 24 * 60;
+
+/** How far ahead the daemon looks for a match before it rejects a cron cadence. */
+export const CRON_SEARCH_LIMIT_MINUTES = 366 * MINUTES_PER_DAY;
+
+export function isValidCronTimeZone(timeZone: string): boolean {
+  try {
+    new Intl.DateTimeFormat("en-US", { timeZone }).format(new Date(0));
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Read wall-clock parts in `timeZone`. A cadence without a time zone runs in
+ * UTC, so `undefined` reads UTC fields.
+ */
+export function createCronDatePartsReader(timeZone: string | undefined): CronDatePartsReader {
+  if (timeZone === undefined) {
+    return (date) => ({
+      year: date.getUTCFullYear(),
+      minute: date.getUTCMinutes(),
+      hour: date.getUTCHours(),
+      dayOfMonth: date.getUTCDate(),
+      month: date.getUTCMonth() + 1,
+      dayOfWeek: date.getUTCDay(),
+    });
+  }
+
+  if (!isValidCronTimeZone(timeZone)) {
+    throw new Error(`Invalid cron time zone: ${timeZone}`);
+  }
+
+  const formatter = new Intl.DateTimeFormat("en-US", {
+    timeZone,
+    hourCycle: "h23",
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+    hour: "2-digit",
+    minute: "2-digit",
+  });
+
+  return (date) => {
+    const values: Record<string, string> = {};
+    for (const part of formatter.formatToParts(date)) {
+      if (part.type !== "literal") {
+        values[part.type] = part.value;
+      }
+    }
+
+    const year = Number.parseInt(values.year, 10);
+    const month = Number.parseInt(values.month, 10);
+    const dayOfMonth = Number.parseInt(values.day, 10);
+
+    return {
+      year,
+      // Some ICU builds report midnight as "24" even with hourCycle h23.
+      minute: Number.parseInt(values.minute, 10),
+      hour: Number.parseInt(values.hour, 10) % 24,
+      dayOfMonth,
+      month,
+      dayOfWeek: new Date(Date.UTC(year, month - 1, dayOfMonth)).getUTCDay(),
+    };
+  };
+}
+
+function matchesDay(cron: ParsedCronExpression, parts: CronDateParts): boolean {
+  // Day-of-month AND day-of-week: every field must match, unlike Vixie cron.
+  return (
+    cron.month.matches(parts.month) &&
+    cron.dayOfMonth.matches(parts.dayOfMonth) &&
+    cron.dayOfWeek.matches(parts.dayOfWeek)
+  );
+}
+
+/**
+ * First minute strictly after `after` that matches `cron`, searching
+ * `CRON_SEARCH_LIMIT_MINUTES` ahead. Returns null when nothing matches.
+ *
+ * Same result as testing every minute in turn. It skips ahead only across
+ * spans that cannot match: the rest of an hour whose hour field does not
+ * match, and most of a day whose date fields do not match. The day skip stops
+ * an hour before midnight so a DST shift cannot carry it past the next day.
+ */
+export function findNextCronMatch(input: {
+  cron: ParsedCronExpression;
+  readDateParts: CronDatePartsReader;
+  after: Date;
+}): Date | null {
+  const { cron, readDateParts } = input;
+  const start = Math.floor(input.after.getTime() / MS_PER_MINUTE) + 1;
+  const limit = start + CRON_SEARCH_LIMIT_MINUTES;
+  let minuteIndex = start;
+
+  while (minuteIndex < limit) {
+    const cursor = new Date(minuteIndex * MS_PER_MINUTE);
+    const parts = readDateParts(cursor);
+    if (!matchesDay(cron, parts)) {
+      const minuteOfDay = parts.hour * 60 + parts.minute;
+      minuteIndex += Math.max(1, MINUTES_PER_DAY - minuteOfDay - 60);
+      continue;
+    }
+    if (!cron.hour.matches(parts.hour)) {
+      minuteIndex += Math.max(1, 60 - parts.minute);
+      continue;
+    }
+    if (cron.minute.matches(parts.minute)) {
+      return cursor;
+    }
+    minuteIndex += 1;
+  }
+
+  return null;
+}
+
+export function computeNextCronRunAt(input: {
+  expression: string;
+  timezone: string | undefined;
+  after: Date;
+}): Date | null {
+  return findNextCronMatch({
+    cron: parseCronExpression(input.expression),
+    readDateParts: createCronDatePartsReader(input.timezone),
+    after: input.after,
+  });
+}
