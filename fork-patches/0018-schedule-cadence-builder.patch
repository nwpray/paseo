+
+const NOW = Date.parse("2026-10-29T16:15:00.000Z"); // Thu Oct 29 2026, 10:15 AM in Denver
+const DENVER = "America/Denver";
+
+function cron(expression: string, timezone = DENVER) {
+  return { type: "cron" as const, expression, timezone };
+}
+
+function iso(at: number) {
+  return new Date(at).toISOString();
+}
+
+describe("cadence preview", () => {
+  it("lists the next runs the daemon will make", () => {
+    const preview = computeCadencePreview({
+      source: cron("0 9,13,17 * * *"),
+      now: NOW,
+      expiresAt: null,
+      remainingRuns: null,
+      clockTimes: [],
+    });
+    expect(preview.status).toBe("upcoming");
+    expect(preview.entries.map((entry) => iso(entry.at))).toEqual([
+      "2026-10-29T19:00:00.000Z",
+      "2026-10-29T23:00:00.000Z",
+      "2026-10-30T15:00:00.000Z",
+      "2026-10-30T19:00:00.000Z",
+      "2026-10-30T23:00:00.000Z",
+    ]);
+    expect(preview.days).toHaveLength(14);
+    expect(preview.days[0]).toMatchObject({ month: 10, day: 29, isToday: true });
+    expect(preview.days[0].marks.map((mark) => mark.tone)).toEqual(["next", "run"]);
+    expect(preview.stripRunCount).toBe(41);
+  });
+
+  it.each([
+    ["* * * * *", 19_544],
+    ["*/2 * * * *", 9_772],
+    ["*/5 * * * *", 3_908],
+  ])("covers all 14 days of dense %s without storing every mark", (expression, count) => {
+    const preview = computeCadencePreview({
+      source: cron(expression, "UTC"),
+      now: Date.parse("2026-10-29T10:15:00.000Z"),
+      expiresAt: null,
+      remainingRuns: null,
+      clockTimes: [],
+    });
+    expect(preview.stripRunCount).toBe(count);
+    expect(preview.days.every((day) => day.marks.length > 0)).toBe(true);
+    expect(preview.days.every((day) => day.marks.length <= 144)).toBe(true);
+  });
+
+  it("counts the extra fall-back hour and obeys a dense run limit", () => {
+    const now = Date.parse("2026-10-29T16:15:00.000Z");
+    const full = computeCadencePreview({
+      source: cron("* * * * *"),
+      now,
+      expiresAt: null,
+      remainingRuns: null,
+      clockTimes: [],
+    });
+    expect(full.days[3].marks.length).toBeGreaterThan(0);
+    expect(full.stripRunCount).toBe(19_604);
+    const limited = computeCadencePreview({
+      source: cron("* * * * *"),
+      now,
+      expiresAt: null,
+      remainingRuns: 1_501,
+      clockTimes: [],
+    });
+    expect(limited.stripRunCount).toBe(1_501);
+    expect(limited.days[2].pastEnd).toBe(true);
+    expect(limited.days[2].marks).toHaveLength(0);
+  });
+
+  it("marks the first run of a day even when a dense limit ends just after midnight", () => {
+    const preview = computeCadencePreview({
+      source: cron("* * * * *", "UTC"),
+      now: Date.parse("2026-10-29T10:15:00.000Z"),
+      expiresAt: null,
+      remainingRuns: 825,
+      clockTimes: [],
+    });
+    expect(preview.stripRunCount).toBe(825);
+    expect(preview.days[1].marks).toEqual([{ minuteOfDay: 0, tone: "run" }]);
+    expect(preview.days[2].pastEnd).toBe(true);
+  });
+
+  it("flags the repeated run when clocks fall back", () => {
+    const preview = computeCadencePreview({
+      source: cron("30 1 * * *"),
