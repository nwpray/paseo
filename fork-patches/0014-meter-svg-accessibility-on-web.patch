From df4fe767a13b907dede529765177ce0a44834c91 Mon Sep 17 00:00:00 2001
From: Nick Pray <nickwpray@gmail.com>
Date: Wed, 28 Oct 2026 20:51:04 -0600
Subject: [PATCH] fork: keep native SVG accessibility props off web

---
 packages/app/src/components/context-window-meter.tsx | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/packages/app/src/components/context-window-meter.tsx b/packages/app/src/components/context-window-meter.tsx
index f9cfabcf8..10d54fb25 100644
--- a/packages/app/src/components/context-window-meter.tsx
+++ b/packages/app/src/components/context-window-meter.tsx
@@ -30,6 +30,9 @@ const COMPACT_SVG_SIZE = 12;
 const COMPACT_RADIUS = 5;
 const STROKE_WIDTH = 2;
 const COMPACT_STROKE_WIDTH = 1.75;
+const HIDDEN_RING_ACCESSIBILITY_PROPS = isNative
+  ? { accessibilityElementsHidden: true, importantForAccessibility: "no-hide-descendants" as const }
+  : { "aria-hidden": true as const };
 
 function isValidMaxTokens(value: number): boolean {
   return Number.isFinite(value) && value > 0;
@@ -112,8 +115,7 @@ const ContextWindowRing = withUnistyles(function ContextWindowRing({
       width={size}
       height={size}
       viewBox={`0 0 ${size} ${size}`}
-      accessibilityElementsHidden
-      importantForAccessibility="no-hide-descendants"
+      {...HIDDEN_RING_ACCESSIBILITY_PROPS}
     >
       <Circle
         cx={center}
-- 
2.50.1 (Apple Git-155)

