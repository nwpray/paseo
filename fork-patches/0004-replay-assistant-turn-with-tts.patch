@@ -0,0 +1,51 @@
+import { create } from "zustand";
+
+/** Fork: the one assistant-turn replay in flight. The audio engine is app-wide, so so is this. */
+export interface ActiveSpeechReplay {
+  serverId: string;
+  requestId: string;
+  turnKey: string;
+}
+
+interface SpeechReplayState {
+  active: ActiveSpeechReplay | null;
+  start(replay: ActiveSpeechReplay): void;
+  /** Clears the replay only if it is still the one with this id (a superseded finish is ignored). */
+  finish(serverId: string, requestId: string): void;
+  clearServer(serverId: string): void;
+}
+
+export const useSpeechReplayStore = create<SpeechReplayState>()((set) => ({
+  active: null,
+  start: (replay) => set({ active: replay }),
+  finish: (serverId, requestId) =>
+    set((state) =>
+      state.active?.serverId === serverId && state.active.requestId === requestId
+        ? { active: null }
+        : state,
+    ),
+  clearServer: (serverId) =>
+    set((state) => (state.active?.serverId === serverId ? { active: null } : state)),
+}));
+
+export type TurnSpeakButtonState = "hidden" | "idle" | "stop" | "disabled";
+
+/**
+ * hidden: the daemon cannot replay (no feature flag, or TTS not ready).
+ * stop: this turn is replaying. disabled: other speech is playing (live voice or another replay).
+ */
+export function resolveTurnSpeakButtonState(input: {
+  available: boolean;
+  serverId: string;
+  turnKey: string;
+  active: ActiveSpeechReplay | null;
+  isSpeechPlaying: boolean;
+}): TurnSpeakButtonState {
+  const { active } = input;
+  if (active && active.serverId === input.serverId && active.turnKey === input.turnKey) {
+    return "stop";
+  }
+  if (!input.available) return "hidden";
+  if (active || input.isSpeechPlaying) return "disabled";
+  return "idle";
+}
diff --git a/packages/app/src/speech-replay/use-turn-speech-replay.ts b/packages/app/src/speech-replay/use-turn-speech-replay.ts
