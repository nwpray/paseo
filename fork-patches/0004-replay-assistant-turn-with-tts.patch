@@ -0,0 +1,51 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { resolveTurnSpeakButtonState, useSpeechReplayStore } from "./speech-replay-store";
+
+const active = { serverId: "s1", requestId: "r1", turnKey: "agent:turn-1" };
+const base = { available: true, serverId: "s1", turnKey: "agent:turn-1", isSpeechPlaying: false };
+
+describe("resolveTurnSpeakButtonState", () => {
+  it("is idle when the daemon can replay and nothing is playing", () => {
+    expect(resolveTurnSpeakButtonState({ ...base, active: null })).toBe("idle");
+  });
+
+  it("is hidden when the daemon lacks the feature or TTS is not ready", () => {
+    expect(resolveTurnSpeakButtonState({ ...base, available: false, active: null })).toBe("hidden");
+  });
+
+  it("shows stop for the replaying turn, even while its audio is playing", () => {
+    expect(resolveTurnSpeakButtonState({ ...base, active, isSpeechPlaying: true })).toBe("stop");
+  });
+
+  it("is disabled while another turn replays or live voice speech plays", () => {
+    expect(resolveTurnSpeakButtonState({ ...base, turnKey: "agent:turn-2", active })).toBe(
+      "disabled",
+    );
+    expect(resolveTurnSpeakButtonState({ ...base, serverId: "s2", active })).toBe("disabled");
+    expect(resolveTurnSpeakButtonState({ ...base, active: null, isSpeechPlaying: true })).toBe(
+      "disabled",
+    );
+  });
+});
+
+describe("useSpeechReplayStore", () => {
+  beforeEach(() => useSpeechReplayStore.setState({ active: null }));
+
+  it("ignores a finish for a superseded request", () => {
+    const store = useSpeechReplayStore.getState();
+    store.start(active);
+    store.finish("s1", "old-request");
+    expect(useSpeechReplayStore.getState().active).toEqual(active);
+    store.finish("s1", "r1");
+    expect(useSpeechReplayStore.getState().active).toBeNull();
+  });
+
+  it("clears the replay when its host disconnects", () => {
+    const store = useSpeechReplayStore.getState();
+    store.start(active);
+    store.clearServer("s2");
+    expect(useSpeechReplayStore.getState().active).toEqual(active);
+    store.clearServer("s1");
