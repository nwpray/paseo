@@ -0,0 +1,71 @@
+import { useCallback } from "react";
+import { useSessionStore } from "@/stores/session-store";
+import { useVoiceAudioEngineOptional } from "@/contexts/voice-context";
+import { resolveVoiceUnavailableMessage } from "@/utils/server-info-capabilities";
+import {
+  resolveTurnSpeakButtonState,
+  useSpeechReplayStore,
+  type TurnSpeakButtonState,
+} from "./speech-replay-store";
+
+export interface SpeechReplayScope {
+  serverId: string;
+  agentId: string;
+}
+
+/** Fork: state and press handler for one assistant turn's read-aloud button. */
+export function useTurnSpeechReplay(input: {
+  scope: SpeechReplayScope;
+  turnKey: string;
+  getContent: () => string;
+}): { state: TurnSpeakButtonState; toggle: () => void } {
+  const { scope, getContent } = input;
+  const { serverId } = scope;
+  const turnKey = `${scope.agentId}:${input.turnKey}`;
+  const engine = useVoiceAudioEngineOptional();
+  const client = useSessionStore((state) => state.sessions[serverId]?.client ?? null);
+  const available = useSessionStore((state) => {
+    const serverInfo = state.sessions[serverId]?.serverInfo;
+    return (
+      serverInfo?.features?.speechReplay === true &&
+      resolveVoiceUnavailableMessage({ serverInfo, mode: "voice" }) === null
+    );
+  });
+  // Live voice speech and replays share the app-wide audio engine, so any host playing counts.
+  const isSpeechPlaying = useSessionStore((state) =>
+    Object.values(state.sessions).some((session) => session?.isPlayingAudio),
+  );
+  const active = useSpeechReplayStore((state) => state.active);
+  const state = resolveTurnSpeakButtonState({
+    available: available && client !== null && engine !== null,
+    serverId,
+    turnKey,
+    active,
+    isSpeechPlaying,
+  });
+
+  const toggle = useCallback(() => {
+    const store = useSpeechReplayStore.getState();
+    if (state === "stop" && active) {
+      store.finish(active.serverId, active.requestId);
+      try {
+        client?.cancelSpeechReplay(active.requestId);
+      } catch (error) {
+        console.warn("[SpeechReplay] cancel failed:", error);
+      }
+      engine?.stop();
+      engine?.clearQueue();
+      return;
+    }
+    if (state !== "idle" || !client) return;
+    const text = getContent().trim();
+    if (!text) return;
+    try {
+      store.start({ serverId, requestId: client.startSpeechReplay(text), turnKey });
+    } catch (error) {
+      console.warn("[SpeechReplay] start failed:", error);
+    }
+  }, [active, client, engine, getContent, serverId, state, turnKey]);
+
+  return { state, toggle };
+}
