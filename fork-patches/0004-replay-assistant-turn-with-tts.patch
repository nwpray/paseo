+interface TurnSpeakButtonProps {
+  scope: SpeechReplayScope;
+  turnKey: string;
+  getContent: () => string;
+  containerStyle?: StyleProp<ViewStyle>;
+}
+
+/** Fork: reads the turn aloud through the daemon's TTS; a Stop button while this turn plays. */
+const TurnSpeakButton = memo(function TurnSpeakButton({
+  scope,
+  turnKey,
+  getContent,
+  containerStyle,
+}: TurnSpeakButtonProps) {
+  const { t } = useTranslation();
+  const { state, toggle } = useTurnSpeechReplay({ scope, turnKey, getContent });
+  const disabled = state === "disabled";
+  const pressableStyle = useMemo(
+    () => [
+      turnCopyButtonStylesheet.container,
+      containerStyle,
+      disabled ? turnSpeakButtonStylesheet.disabled : null,
+    ],
+    [containerStyle, disabled],
+  );
+  const accessibilityState = useMemo(() => ({ disabled }), [disabled]);
+
+  if (state === "hidden") return null;
+  const isStop = state === "stop";
+  return (
+    <Pressable
+      onPress={toggle}
+      disabled={disabled}
+      style={pressableStyle}
+      accessibilityRole="button"
+      accessibilityState={accessibilityState}
+      accessibilityLabel={isStop ? t("message.actions.stopReading") : t("message.actions.readTurn")}
+    >
+      {({ hovered }) => {
+        const iconColor =
+          hovered && !disabled
+            ? turnCopyButtonStylesheet.iconHoveredColor.color
+            : turnCopyButtonStylesheet.iconColor.color;
+        return isStop ? (
+          <Square size={ICON_SIZE.sm} color={iconColor} />
+        ) : (
+          <Volume2 size={ICON_SIZE.sm} color={iconColor} />
+        );
+      }}
+    </Pressable>
+  );
+});
+
+const turnSpeakButtonStylesheet = StyleSheet.create(() => ({
+  disabled: { opacity: 0.4 },
+}));
+
