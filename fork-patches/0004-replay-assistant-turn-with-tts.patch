+  test("replaces code blocks with one placeholder and keeps surrounding prose", () => {
+    const input = "Run this:\n```bash\nnpm test\n```\n~~~\nmore\n~~~\nThen check.";
+    expect(sanitizeTextForSpeech(input)).toBe("Run this:\nCode block.\nThen check.");
+  });
+
+  test("drops an unterminated fence through the end of the text", () => {
+    expect(sanitizeTextForSpeech("Before.\n```\nconst a = 1;")).toBe("Before.\nCode block.");
+  });
+
+  test("keeps link and image labels, replaces bare URLs, strips tags", () => {
+    expect(
+      sanitizeTextForSpeech(
+        "See [the docs](https://a.b/c) and ![diagram](x.png) at https://x.y/z <spoken-input>now</spoken-input>",
+      ),
+    ).toBe("See the docs and diagram at link now.");
+  });
+
+  test("strips headings, lists, quotes, tasks and emphasis but keeps snake_case and a < b", () => {
+    const input = [
+      "## Summary",
+      "- **Bold** item",
+      "1. `user_id` _field_",
+      "> quoted ~~old~~",
+      "- [x] done",
+      "if a < b then",
+    ].join("\n");
+    expect(sanitizeTextForSpeech(input)).toBe(
+      "Summary.\nBold item.\nuser_id field.\nquoted old.\ndone.\nif a < b then.",
+    );
+  });
+
+  test("reads table cells and drops rules and punctuation-only lines", () => {
+    const input = "| Name | Value |\n| --- | --- |\n| a | 1 |\n\n---\n***";
+    expect(sanitizeTextForSpeech(input)).toBe("Name, Value.\na, 1.");
+  });
+
+  test("returns an empty string when nothing is speakable", () => {
+    expect(sanitizeTextForSpeech("---\n\n  \n")).toBe("");
+  });
+});
diff --git a/packages/server/src/server/speech/speech-replay-text.ts b/packages/server/src/server/speech/speech-replay-text.ts
new file mode 100644
index 000000000..b60b78071
--- /dev/null
+++ b/packages/server/src/server/speech/speech-replay-text.ts
@@ -0,0 +1,60 @@
+/**
+ * Turn an assistant turn's markdown into text worth hearing (fork: speech replay).
+ *
+ * Code blocks become a short spoken placeholder, links keep their label, tags and
+ * markdown syntax are removed. Each surviving line ends in punctuation so headings
+ * and list items get a pause instead of running together. Lines with nothing to
+ * pronounce are dropped: punctuation-only TTS segments synthesize to empty audio.
+ */
+
+const CODE_BLOCK_PLACEHOLDER = "Code block.";
+const FENCE = /^\s*(`{3,}|~{3,})/;
+const HAS_SPEAKABLE_CONTENT = /[\p{L}\p{N}]/u;
+const ENDS_WITH_PUNCTUATION = /[.!?:;,]$/;
+
+function cleanLine(line: string): string {
+  return (
+    line
+      // <tag>, </tag>, <tag attr="x" /> but not `a < b`
+      .replace(/<\/?[a-zA-Z][\w:-]*(?:\s[^<>]*)?\/?>/g, " ")
+      // ![alt](src), [label](href), [label][ref]
+      .replace(/!?\[([^\]]*)\]\([^)]*\)/g, "$1")
+      .replace(/\[([^\]]+)\]\[[^\]]*\]/g, "$1")
+      .replace(/https?:\/\/\S+/g, "link")
+      // heading, blockquote, list and task-list markers
+      .replace(/^\s{0,3}(?:#{1,6}\s+|(?:>\s?)+|[-*+]\s+(?:\[[ xX]\]\s+)?|\d+[.)]\s+)/, "")
+      // table pipes
+      .replace(/^\s*\|/, "")
+      .replace(/\|\s*$/, "")
+      .replace(/\s*\|\s*/g, ", ")
+      // emphasis and inline code; `_` only at word edges so snake_case survives
+      .replace(/\*+|~~|`+/g, "")
+      .replace(/(^|[^\p{L}\p{N}])_+|_+(?=[^\p{L}\p{N}]|$)/gu, "$1")
+      .replace(/\\([\\`*_{}[\]()#+\-.!|])/g, "$1")
+      .replace(/\s+/g, " ")
+      .trim()
+  );
+}
+
+export function sanitizeTextForSpeech(markdown: string): string {
+  const out: string[] = [];
+  let fence: string | null = null;
+  for (const raw of markdown.split(/\r?\n/)) {
+    const fenceMatch = FENCE.exec(raw);
+    if (fence) {
+      if (fenceMatch && fenceMatch[1][0] === fence[0] && fenceMatch[1].length >= fence.length) {
+        fence = null;
+      }
+      continue;
+    }
+    if (fenceMatch) {
+      fence = fenceMatch[1];
+      if (out[out.length - 1] !== CODE_BLOCK_PLACEHOLDER) out.push(CODE_BLOCK_PLACEHOLDER);
+      continue;
+    }
+    const line = cleanLine(raw);
+    if (!HAS_SPEAKABLE_CONTENT.test(line)) continue;
+    out.push(ENDS_WITH_PUNCTUATION.test(line) ? line : `${line}.`);
+  }
+  return out.join("\n");
+}
