@@ -0,0 +1,240 @@
+import { useCallback, useMemo } from "react";
+import { useTranslation } from "react-i18next";
+import { Text, View } from "react-native";
+import Animated, { FadeIn, FadeOut } from "react-native-reanimated";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import { Mic, MicOff, Space, X } from "lucide-react-native";
+import { Button } from "@/components/ui/button";
+import { buttonControlHeight, type ButtonControlSize } from "@/components/ui/control-geometry";
+import { LoadingSpinner } from "@/components/ui/loading-spinner";
+import { Shortcut } from "@/components/ui/shortcut";
+import { Tooltip, TooltipContent, TooltipTrigger } from "@/components/ui/tooltip";
+import { resolveRealtimeVoiceStatusKey } from "@/composer/input/labels";
+import { isWeb } from "@/constants/platform";
+import { useVoiceTelemetry } from "@/contexts/voice-context";
+import { useKeyboardShortcutsAvailable } from "@/keyboard/availability";
+import { ICON_SIZE, type Theme } from "@/styles/theme";
+import type { VoiceRuntimePhase } from "@/voice/voice-runtime";
+import { VolumeMeter } from "./volume-meter";
+
+type ShortcutChord = NonNullable<React.ComponentProps<typeof Shortcut>["chord"]>;
+
+interface RealtimeVoiceStripProps {
+  isMuted: boolean;
+  isSwitching: boolean;
+  phase: VoiceRuntimePhase;
+  compact: boolean;
+  /** The Space keycap on Mute, for desktop when the text box isn't focused (Space types there). */
+  showMuteHint: boolean;
+  muteKeys: ShortcutChord | null | undefined;
+  onToggleMute: () => void;
+  onStop: () => void;
+}
+
+// Desktop sits in the toolbar's xs tier. Compact takes the next tier up, and hit slop
+// brings it to a 44px target.
+const DESKTOP_SIZE: ButtonControlSize = "xs";
+const COMPACT_SIZE: ButtonControlSize = "sm";
+const DESKTOP_HIT_SLOP = 8;
+const COMPACT_HIT_SLOP = (44 - buttonControlHeight[COMPACT_SIZE]) / 2;
+// The Space keycap trails the Mute label. xs is the smallest step on the icon scale, the
+// same step as the label's mic on desktop.
+const SPACE_GLYPH_SIZE = ICON_SIZE.xs;
+// Compact Mute is icon-only so the status fits at 375px in every locale. Its glyph
+// replaces the toolbar mic, so it keeps the toolbar's glyph size.
+const COMPACT_MUTE_GLYPH_SIZE = isWeb ? ICON_SIZE.md : ICON_SIZE.lg;
+const COMPACT_MUTE_BUTTON = {
+  width: buttonControlHeight[COMPACT_SIZE],
+  height: buttonControlHeight[COMPACT_SIZE],
+};
+
+/**
+ * Voice mode controls, the first row inside the composer card. The text box stays live
+ * underneath, so voice and typing share one composer.
+ */
+export function RealtimeVoiceStrip({
+  isMuted,
+  isSwitching,
+  phase,
+  compact,
+  showMuteHint,
+  muteKeys,
+  onToggleMute,
+  onStop,
+}: RealtimeVoiceStripProps) {
+  const { t } = useTranslation();
+  const { volume, isSpeaking } = useVoiceTelemetry();
+  const size = compact ? COMPACT_SIZE : DESKTOP_SIZE;
+  const hitSlop = compact ? COMPACT_HIT_SLOP : DESKTOP_HIT_SLOP;
+  const statusKey = resolveRealtimeVoiceStatusKey({ phase, isMuted });
+  const muteA11yLabel = isMuted
+    ? t("realtimeVoice.actions.unmute")
+    : t("realtimeVoice.actions.mute");
+  const muteText = isMuted ? t("realtimeVoice.strip.unmute") : t("realtimeVoice.strip.mute");
+  // Same gate the Shortcut badge uses: the keycap only shows where keyboard shortcuts work.
+  const shortcutsAvailable = useKeyboardShortcutsAvailable();
+  const showSpaceHint = Boolean(showMuteHint && muteKeys && shortcutsAvailable);
+  const spaceHint = useMemo(
+    () =>
+      showSpaceHint ? (
+        <View
+          style={isMuted ? styles.spaceHintOnDestructive : null}
+          testID="realtime-voice-mute-hint"
+        >
+          <ThemedSpace
+            size={SPACE_GLYPH_SIZE}
+            uniProps={isMuted ? destructiveForegroundColorMapping : mutedColorMapping}
+          />
+        </View>
+      ) : null,
+    [isMuted, showSpaceHint],
+  );
+
+  const pillMuteIcon = isMuted ? MicOff : Mic;
+  const compactMuteIcon = useCallback(
+    (color: string) =>
+      isMuted ? (
+        <MicOff color={color} size={COMPACT_MUTE_GLYPH_SIZE} />
+      ) : (
+        <Mic color={color} size={COMPACT_MUTE_GLYPH_SIZE} />
+      ),
+    [isMuted],
+  );
+
+  return (
+    <Animated.View entering={FadeIn.duration(150)} exiting={FadeOut.duration(120)}>
+      <View
+        role="toolbar"
+        accessibilityLabel={t("realtimeVoice.strip.label")}
+        style={styles.row}
+        testID="realtime-voice-strip"
+      >
+        {isSwitching ? (
+          <ThemedLoadingSpinner size="small" uniProps={mutedColorMapping} />
+        ) : (
+          <VolumeMeter
+            volume={volume}
+            isMuted={isMuted}
+            isSpeaking={isSpeaking}
+            orientation="horizontal"
+            variant="mini"
+          />
+        )}
+        <Text style={isMuted ? styles.statusMuted : styles.status} numberOfLines={1}>
+          {t(statusKey)}
+        </Text>
+        <View style={compact ? styles.actionsCompact : styles.actions}>
+          <Tooltip delayDuration={0} enabledOnDesktop enabledOnMobile={false}>
+            <TooltipTrigger asChild>
+              <Button
+                variant={isMuted ? "destructive" : "secondary"}
+                size={size}
+                leftIcon={compact ? compactMuteIcon : pillMuteIcon}
+                trailing={compact ? null : spaceHint}
+                onPress={onToggleMute}
+                disabled={isSwitching}
+                accessibilityLabel={muteA11yLabel}
+                aria-checked={isMuted}
+                hitSlop={hitSlop}
+                style={compact ? styles.compactMuteButton : undefined}
+                testID="realtime-voice-mute"
+              >
+                {compact ? null : muteText}
+              </Button>
+            </TooltipTrigger>
+            <TooltipContent side="top" align="center" offset={8}>
+              <View style={styles.tooltipRow}>
+                <Text style={styles.tooltipText}>{muteA11yLabel}</Text>
+                {muteKeys ? <Shortcut chord={muteKeys} /> : null}
+              </View>
+            </TooltipContent>
+          </Tooltip>
+          <Button
+            variant="secondary"
+            size={size}
+            leftIcon={X}
+            onPress={onStop}
+            disabled={isSwitching}
+            accessibilityLabel={t("realtimeVoice.actions.stop")}
+            hitSlop={hitSlop}
+            testID="realtime-voice-end"
+          >
+            {t("realtimeVoice.actions.end")}
+          </Button>
+        </View>
+      </View>
+    </Animated.View>
+  );
+}
+
+const ThemedLoadingSpinner = withUnistyles(LoadingSpinner);
+const ThemedSpace = withUnistyles(Space);
+const mutedColorMapping = (theme: Theme) => ({ color: theme.colors.foregroundMuted });
+const destructiveForegroundColorMapping = (theme: Theme) => ({
+  color: theme.colors.destructiveForeground,
+});
+
+const styles = StyleSheet.create((theme) => ({
+  row: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[2],
+    // No bleed on the left: the meter's first bar sits on the text's rail. The right
+    // bleeds like the toolbar row so End's edge lands on Send's.
+    marginRight: -6,
+    // Tighter than the card's rhythm so the row reads as a header, not a floating band:
+    // desktop's 16px top padding drops to 12 (the card's bottom inset), and the 12px card
+    // gap under the hairline drops to 8.
+    marginTop: {
+      xs: 0,
+      md: -theme.spacing[1],
+    },
+    marginBottom: -theme.spacing[1],
+    paddingBottom: theme.spacing[2],
+    borderBottomWidth: theme.borderWidth[1],
+    borderBottomColor: theme.colors.border,
+  },
+  status: {
+    flex: 1,
+    minWidth: 0,
+    fontSize: theme.fontSize.sm,
+    fontWeight: theme.fontWeight.medium,
+    color: theme.colors.foregroundMuted,
+  },
+  // statusDanger, not destructive: destructive text fails contrast at this size.
+  statusMuted: {
+    flex: 1,
+    minWidth: 0,
+    fontSize: theme.fontSize.sm,
+    fontWeight: theme.fontWeight.medium,
+    color: theme.colors.statusDanger,
+  },
+  actions: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[2],
+  },
+  actionsCompact: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[3],
+  },
+  // destructiveForeground has no muted step, so the keycap fades to read as secondary.
+  spaceHintOnDestructive: {
+    opacity: 0.7,
+  },
+  compactMuteButton: {
+    ...COMPACT_MUTE_BUTTON,
+    paddingHorizontal: 0,
+    borderRadius: theme.borderRadius.full,
+  },
+  tooltipRow: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[2],
+  },
+  tooltipText: {
+    fontSize: theme.fontSize.base,
+    color: theme.colors.popoverForeground,
+  },
+}));
