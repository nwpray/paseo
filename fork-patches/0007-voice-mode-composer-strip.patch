index 000000000..0d49d8f36
--- /dev/null
+++ b/packages/app/src/design/designs/voice-strip.tsx
@@ -0,0 +1,269 @@
+import { useCallback, useEffect, useMemo, useState, type ReactNode } from "react";
+import { useTranslation } from "react-i18next";
+import { View } from "react-native";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import { FileText } from "lucide-react-native";
+import { AttachmentFrame, AttachmentLabel } from "@/components/attachment-pill";
+import { buildCancelButtonStyle, ComposerCancelButton } from "@/composer/index";
+import { MessageInput } from "@/composer/input/input";
+import { isWeb } from "@/constants/platform";
+import { useIsCompactFormFactor } from "@/constants/layout";
+import { VoiceRuntimeProvider } from "@/contexts/voice-context";
+import { useSimulatedVolume } from "@/design/simulated-volume";
+import type { DesignDefinition } from "@/design/types";
+import { ICON_SIZE, type Theme } from "@/styles/theme";
+import type {
+  VoiceRuntime,
+  VoiceRuntimePhase,
+  VoiceRuntimeSnapshot,
+  VoiceRuntimeTelemetrySnapshot,
+} from "@/voice/voice-runtime";
+
+// The real MessageInput in voice mode, so the strip sits in the real card above the
+// real text box and toolbar. A staged runtime stands in for the voice runtime: it
+// reports the state's phase and feeds the meter the simulated speech level. The model
+// chips and context meter come from the full Composer and are absent here.
+
+const SERVER_ID = "design-server";
+const AGENT_ID = "design-agent";
+
+interface StagedVoiceRuntime extends VoiceRuntime {
+  setTelemetry(telemetry: VoiceRuntimeTelemetrySnapshot): void;
+}
+
+function noop(): void {}
+async function resolved(): Promise<void> {}
+
+function createStagedVoiceRuntime(initial: VoiceRuntimeSnapshot): StagedVoiceRuntime {
+  let snapshot = initial;
+  let telemetry: VoiceRuntimeTelemetrySnapshot = {
+    volume: 0,
+    isSpeaking: false,
+    segmentDuration: 0,
+  };
+  const listeners = new Set<() => void>();
+  const telemetryListeners = new Set<() => void>();
+  function subscribeTo(set: Set<() => void>, listener: () => void) {
+    set.add(listener);
+    return () => {
+      set.delete(listener);
+    };
+  }
+  return {
+    subscribe: (listener) => subscribeTo(listeners, listener),
+    getSnapshot: () => snapshot,
+    subscribeTelemetry: (listener) => subscribeTo(telemetryListeners, listener),
+    getTelemetrySnapshot: () => telemetry,
+    setTelemetry(next) {
+      telemetry = next;
+      for (const listener of telemetryListeners) listener();
+    },
+    toggleMute() {
+      snapshot = { ...snapshot, isMuted: !snapshot.isMuted };
+      for (const listener of listeners) listener();
+    },
+    isVoiceModeForAgent: (serverId, agentId) => serverId === SERVER_ID && agentId === AGENT_ID,
+    registerSession: () => noop,
+    updateSessionConnection: noop,
+    handleCapturePcm: noop,
+    handleCaptureVolume: noop,
+    handleAudioOutput: noop,
+    startVoice: resolved,
+    stopVoice: resolved,
+    destroy: resolved,
+    shouldPlayVoiceAudio: () => false,
+    onAssistantAudioStarted: noop,
+    onAssistantAudioFinished: noop,
+    onTranscriptionResult: noop,
+    onServerSpeechStateChanged: noop,
+    onTurnEvent: noop,
+  };
+}
+
+interface StageInput {
+  phase: VoiceRuntimePhase;
+  isMuted?: boolean;
+  isSwitching?: boolean;
+  /** Mic level fed to the meter; 0 is silence. */
+  level?: number;
+  draft?: string;
+  isAgentRunning?: boolean;
+  attachment?: boolean;
+}
+
+function VoiceStage({ runtime, children }: { runtime: StagedVoiceRuntime; children: ReactNode }) {
+  return (
+    <View style={styles.page}>
+      <View style={styles.chat} />
+      <View style={styles.composer}>
+        <VoiceRuntimeProvider runtime={runtime}>{children}</VoiceRuntimeProvider>
+      </View>
+    </View>
+  );
+}
+
+const ThemedFileText = withUnistyles(FileText);
+const fileIconMapping = (theme: Theme) => ({
+  color: theme.colors.foregroundMuted,
+  size: theme.iconSize.md,
+});
+const fileIcon = <ThemedFileText uniProps={fileIconMapping} />;
+
+function StagedComposer({
+  phase,
+  isMuted = false,
+  isSwitching = false,
+  level = 0,
+  draft = "",
+  isAgentRunning = false,
+  attachment = false,
+}: StageInput) {
+  const { t } = useTranslation();
+  const isCompact = useIsCompactFormFactor();
+  const runtime = useMemo(
+    () =>
+      createStagedVoiceRuntime({
+        phase,
+        isVoiceMode: true,
+        isVoiceSwitching: isSwitching,
+        isMuted,
+        activeServerId: SERVER_ID,
+        activeAgentId: AGENT_ID,
+      }),
+    [phase, isMuted, isSwitching],
+  );
+  const volume = useSimulatedVolume(level);
+  useEffect(() => {
+    runtime.setTelemetry({ volume, isSpeaking: level > 0, segmentDuration: 0 });
+  }, [runtime, volume, level]);
+
+  const [value, setValue] = useState(draft);
+  const textReplacement = useMemo(
+    () => ({ kind: "initial" as const, key: "design", text: draft }),
+    [draft],
+  );
+  const cancelButtonStyle = useMemo(() => buildCancelButtonStyle(true, false), []);
+  const activeActionContent = useMemo(
+    () => (
+      <ComposerCancelButton
+        buttonIconSize={isWeb ? ICON_SIZE.md : ICON_SIZE.lg}
+        cancelButtonStyle={cancelButtonStyle}
+        handleCancelAgent={noop}
+        isConnected
+        isCancellingAgent={false}
+        agentInterruptKeys={null}
+        t={t}
+      />
+    ),
+    [cancelButtonStyle, t],
+  );
+  const attachmentSlot = useMemo(
+    () =>
+      attachment ? (
+        <View style={styles.attachmentTray}>
+          <AttachmentFrame testID="design-attachment">
+            <AttachmentLabel icon={fileIcon} title="voice-strip-notes.md" subtitle="Markdown" />
+          </AttachmentFrame>
+        </View>
+      ) : undefined,
+    [attachment],
+  );
+  const handleSubmit = useCallback(() => setValue(""), []);
+
+  return (
+    <VoiceStage runtime={runtime}>
+      <MessageInput
+        value={value}
+        onChangeText={setValue}
+        onSubmit={handleSubmit}
+        attachments={[]}
+        cwd="/"
+        attachmentMenuItems={[]}
+        client={null}
+        placeholder={
+          isCompact ? t("composer.placeholders.mobile") : t("composer.placeholders.desktop")
+        }
+        defaultSendBehavior="interrupt"
+        textReplacement={textReplacement}
+        voiceServerId={SERVER_ID}
+        voiceAgentId={AGENT_ID}
+        isAgentRunning={isAgentRunning}
+        activeActionContent={activeActionContent}
+        attachmentSlot={attachmentSlot}
+        submitButtonTestID="design-send"
+      />
+    </VoiceStage>
+  );
+}
+
+const DRAFT = [
+  "Also rename the strip's test IDs once this lands,",
+  "and check the light theme hairline against the card border.",
+].join("\n");
+
+const design: DesignDefinition = {
+  title: "Voice strip",
+  states: [
+    {
+      id: "connecting",
+      label: "Connecting",
+      render: () => <StagedComposer phase="starting" isSwitching />,
+    },
+    {
+      id: "listening",
+      label: "Listening (silent)",
+      render: () => <StagedComposer phase="listening" />,
+    },
+    {
+      id: "user-speaking",
+      label: "Listening (user speaking)",
+      render: () => <StagedComposer phase="listening" level={0.35} />,
+    },
+    { id: "thinking", label: "Thinking", render: () => <StagedComposer phase="waiting" /> },
+    { id: "speaking", label: "Speaking", render: () => <StagedComposer phase="playing" /> },
+    { id: "muted", label: "Muted", render: () => <StagedComposer phase="listening" isMuted /> },
+    {
+      id: "ending",
+      label: "Ending",
+      render: () => <StagedComposer phase="stopping" isSwitching />,
+    },
+    {
+      id: "draft",
+      label: "With typed draft",
+      render: () => <StagedComposer phase="listening" draft={DRAFT} />,
+    },
+    {
+      id: "attachment",
+      label: "With attachment",
+      render: () => <StagedComposer phase="listening" attachment draft="See the notes." />,
+    },
+    {
+      id: "agent-running",
+      label: "Agent running",
+      render: () => <StagedComposer phase="waiting" isAgentRunning />,
+    },
+  ],
+};
+
+export default design;
+
+const styles = StyleSheet.create((theme) => ({
+  page: {
+    flex: 1,
+    backgroundColor: theme.colors.surface0,
+  },
+  chat: {
+    flex: 1,
+  },
+  composer: {
+    width: "100%",
+    maxWidth: theme.contentMaxWidth,
+    alignSelf: "center",
+    padding: theme.spacing[4],
+  },
+  attachmentTray: {
+    flexDirection: "row",
+    gap: theme.spacing[2],
+    flexWrap: "wrap",
+  },
+}));
