+  | "realtimeVoice.status.listening"
+  | "realtimeVoice.status.thinking"
+  | "realtimeVoice.status.speaking"
+  | "realtimeVoice.status.muted"
+  | "realtimeVoice.status.ending";
+
+const REALTIME_VOICE_STATUS_BY_PHASE: Record<VoiceRuntimePhase, RealtimeVoiceStatusKey> = {
+  // The strip only mounts in voice mode; disabled is the one-frame gap before the snapshot lands.
+  disabled: "realtimeVoice.status.listening",
+  starting: "realtimeVoice.status.connecting",
+  listening: "realtimeVoice.status.listening",
+  submitting: "realtimeVoice.status.thinking",
+  waiting: "realtimeVoice.status.thinking",
+  playing: "realtimeVoice.status.speaking",
+  stopping: "realtimeVoice.status.ending",
