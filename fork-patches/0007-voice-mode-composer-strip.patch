diff --git a/packages/app/src/design/simulated-volume.ts b/packages/app/src/design/simulated-volume.ts
new file mode 100644
index 000000000..32fbe2c7a
--- /dev/null
+++ b/packages/app/src/design/simulated-volume.ts
@@ -0,0 +1,63 @@
+import { useEffect, useState } from "react";
+
+// A speech-like mic level for design states: syllable bursts with short dips
+// between them and longer pauses between words, so meters move like live input.
+
+const SAMPLE_INTERVAL_MS = 50;
+
+interface Syllable {
+  startedAt: number;
+  duration: number;
+  peak: number;
+  /** Silence after this syllable: a short dip, or a word gap. */
+  gap: number;
+}
+
+function randomBetween(min: number, max: number): number {
+  return min + Math.random() * (max - min);
+}
+
+function nextSyllable(startedAt: number, level: number): Syllable {
+  const endsWord = Math.random() < 0.3;
+  return {
+    startedAt,
+    duration: randomBetween(110, 260),
+    peak: level * randomBetween(0.55, 1.35),
+    gap: endsWord ? randomBetween(220, 520) : randomBetween(30, 90),
+  };
+}
+
+// Fast attack, slower decay, like a voiced syllable.
+function syllableEnvelope(progress: number): number {
+  if (progress < 0.2) return progress / 0.2;
+  return Math.max(0, 1 - (progress - 0.2) / 0.8) ** 0.7;
+}
+
+function speechLevel(syllable: Syllable, now: number, level: number): number {
+  const elapsed = now - syllable.startedAt;
+  const floor = level * 0.06;
+  if (elapsed >= syllable.duration) return floor;
+  const flutter = 1 + (Math.random() - 0.5) * 0.25;
+  return floor + syllable.peak * syllableEnvelope(elapsed / syllable.duration) * flutter;
+}
+
+/** Volume samples around `level`, updated every 50ms. A level of 0 is silence. */
+export function useSimulatedVolume(level: number): number {
+  const [volume, setVolume] = useState(level);
+  useEffect(() => {
+    if (level === 0) {
+      setVolume(0);
+      return;
+    }
+    let syllable = nextSyllable(Date.now(), level);
+    const handle = setInterval(() => {
+      const now = Date.now();
+      if (now - syllable.startedAt >= syllable.duration + syllable.gap) {
+        syllable = nextSyllable(now, level);
+      }
+      setVolume(Math.min(1, Math.max(0, speechLevel(syllable, now, level))));
+    }, SAMPLE_INTERVAL_MS);
+    return () => clearInterval(handle);
+  }, [level]);
+  return volume;
+}
