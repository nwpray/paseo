+test("captures provider persistence metadata after runtime info creates an empty thread", async () => {
+  const workdir = mkdtempSync(join(tmpdir(), "agent-manager-late-persistence-"));
+  class LatePersistenceClient extends TestAgentClient {
+    override async createSession(config: AgentSessionConfig): Promise<AgentSession> {
+      const session: AgentSession = new TestAgentSession(config);
+      const getRuntimeInfo = session.getRuntimeInfo.bind(session);
+      let threadStarted = false;
+      session.describePersistence = () =>
+        threadStarted
+          ? { provider: "codex", sessionId: session.id!, metadata: { emptyThread: true } }
+          : null;
+      session.getRuntimeInfo = async () => {
+        const info = await getRuntimeInfo();
+        threadStarted = true;
+        return info;
+      };
+      return session;
+    }
+  }
+  const manager = new AgentManager({
+    clients: { codex: new LatePersistenceClient() },
+    logger,
+  });
+  try {
+    const agent = await manager.createAgent({ provider: "codex", cwd: workdir }, undefined, {
+      workspaceId: undefined,
+    });
+    expect(manager.getAgent(agent.id)?.persistence?.metadata?.emptyThread).toBe(true);
+  } finally {
+    rmSync(workdir, { recursive: true, force: true });
+  }
+});
+
