+  test("replaces an unstarted Codex thread when its rollout does not exist", async () => {
+    const newSession = createSession({ thinkingOptionId: "medium" });
+    const emptyHandle = newSession.describePersistence();
+    expect(emptyHandle?.metadata?.emptyThread).toBe(true);
+
+    const session = new CodexAppServerAgentSession(
+      createConfig({ thinkingOptionId: "medium", systemPrompt: "Voice instructions" }),
+      emptyHandle,
+      createTestLogger(),
+      () => {
+        throw new Error("Test session cannot spawn Codex app-server");
+      },
+    ) as CodexTestSession;
+    const requests: Array<{ method: string; params: unknown }> = [];
+    session.client = {
+      request: vi.fn(async (method: string, params: unknown) => {
+        requests.push({ method, params });
+        if (method === "thread/loaded/list") return { data: [] };
+        if (method === "thread/resume") {
+          throw new Error("no rollout found for thread id test-thread");
+        }
+        if (method === "thread/start") return { thread: { id: "new-empty-thread" } };
+        return {};
+      }),
+    };
+
+    await asInternals(session).ensureThreadLoaded();
+
+    expect(session.currentThreadId).toBe("new-empty-thread");
+    expect(session.describePersistence()?.metadata?.emptyThread).toBe(true);
+    expect(requests.map(({ method }) => method)).toEqual([
+      "thread/loaded/list",
+      "thread/resume",
+      "thread/start",
+    ]);
+    expect(requests[2]?.params).toMatchObject({ developerInstructions: "Voice instructions" });
+  });
+
+  test("keeps a started thread when its original handle was marked empty", async () => {
+    const session = new CodexAppServerAgentSession(
+      createConfig({ thinkingOptionId: "medium" }),
+      { sessionId: "started-thread", metadata: { emptyThread: true } },
+      createTestLogger(),
+      () => {
+        throw new Error("Test session cannot spawn Codex app-server");
+      },
+    ) as CodexTestSession;
+    session.hasStartedTurn = true;
+    const requests: string[] = [];
+    session.client = {
+      request: vi.fn(async (method: string) => {
+        requests.push(method);
+        if (method === "thread/loaded/list") return { data: [] };
+        if (method === "thread/resume") {
+          throw new Error("no rollout found for thread id started-thread");
+        }
+        return {};
+      }),
+    };
+
+    await expect(asInternals(session).ensureThreadLoaded()).rejects.toThrow(
+      "no rollout found for thread id started-thread",
+    );
+    expect(session.currentThreadId).toBe("started-thread");
+    expect(requests).toEqual(["thread/loaded/list", "thread/resume"]);
+  });
