diff --git a/packages/app/src/composer/draft/create-flow.test.ts b/packages/app/src/composer/draft/create-flow.test.ts
index 8587fa3db..590f06413 100644
--- a/packages/app/src/composer/draft/create-flow.test.ts
+++ b/packages/app/src/composer/draft/create-flow.test.ts
@@ -250,4 +250,46 @@ describe("useDraftAgentCreateFlow", () => {
     });
     expect(onCreateSuccess).toHaveBeenCalledTimes(1);
   });
+
+  it("creates a voice-start agent without a blank initial user message", async () => {
+    let finishCreate!: (result: { agentId: string; result: { id: string } }) => void;
+    const createRequest = vi.fn(
+      () =>
+        new Promise<{ agentId: string; result: { id: string } }>((resolve) => {
+          finishCreate = resolve;
+        }),
+    );
+    const onCreateSuccess = vi.fn();
+    const { result } = renderHook(() =>
+      useDraftAgentCreateFlow({
+        draftId: "draft-voice",
+        getPendingServerId: () => "server-1",
+        buildDraftAgent: () => ({ id: "draft-voice" }),
+        createRequest,
+        onCreateSuccess,
+      }),
+    );
+
+    let create!: Promise<void>;
+    await act(async () => {
+      create = result.current.handleCreateFromInput({
+        text: "",
+        attachments: [],
+        cwd: "/repo",
+        allowEmptyText: true,
+      });
+    });
+    expect(result.current.isSubmitting).toBe(true);
+    expect(result.current.submittedStreamItems).toEqual([]);
+    expect(result.current.pendingMessageSubmissions).toEqual([]);
+    expect(createRequest).toHaveBeenCalledWith(
+      expect.objectContaining({ text: "", images: undefined, attachments: undefined }),
+    );
+
+    await act(async () => {
+      finishCreate({ agentId: "agent-voice", result: { id: "agent-voice" } });
+      await create;
+    });
+    expect(onCreateSuccess).toHaveBeenCalledTimes(1);
+  });
 });
