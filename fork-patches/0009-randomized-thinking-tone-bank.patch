+import { expect, test } from "vitest";
+import {
+  createThinkingToneSequence,
+  loadThinkingToneBank,
+  pickNextSegmentIndex,
+} from "./thinking-tone";
+
+/** mulberry32: a small seeded generator so draws are reproducible. */
+function seeded(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state = (state + 0x6d2b79f5) >>> 0;
+    let t = state;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+function draw(count: number, draws: number, random: () => number): number[] {
+  const picks: number[] = [];
+  let previous: number | null = null;
+  for (let i = 0; i < draws; i += 1) {
+    previous = pickNextSegmentIndex(count, previous, random);
+    picks.push(previous);
+  }
+  return picks;
+}
+
+test("never picks the segment that just played", () => {
+  const picks = draw(8, 5000, seeded(1));
+  for (let i = 1; i < picks.length; i += 1) {
+    expect(picks[i]).not.toBe(picks[i - 1]);
+  }
+});
+
+test("covers every segment, roughly uniformly, over many draws", () => {
+  const picks = draw(8, 8000, seeded(2));
+  const counts = Array.from({ length: 8 }, (_, index) => picks.filter((p) => p === index).length);
+  for (const count of counts) {
+    expect(count).toBeGreaterThan(800);
+    expect(count).toBeLessThan(1200);
+  }
+});
+
+test("the extremes of the random source stay in range and skip the previous segment", () => {
+  expect(pickNextSegmentIndex(8, null, () => 0)).toBe(0);
+  expect(pickNextSegmentIndex(8, null, () => 0.9999999)).toBe(7);
+  expect(pickNextSegmentIndex(8, 0, () => 0)).toBe(1);
+  expect(pickNextSegmentIndex(8, 7, () => 0.9999999)).toBe(6);
+  expect(pickNextSegmentIndex(8, 3, () => 3 / 7)).toBe(4);
+  expect(pickNextSegmentIndex(1, 0, () => 0.5)).toBe(0);
+});
+
+test("is deterministic for a given seed", () => {
+  expect(draw(8, 50, seeded(42))).toEqual(draw(8, 50, seeded(42)));
+  expect(draw(8, 50, seeded(42))).not.toEqual(draw(8, 50, seeded(43)));
+});
+
+test("the sequence walks the bank's segments without repeats", () => {
+  const segments = Array.from({ length: 4 }, (_, index) => new Uint8Array([index]));
+  const next = createThinkingToneSequence({ segments, segmentDurationMs: 1 }, seeded(7));
+  const played = Array.from({ length: 200 }, () => next());
+  for (let i = 1; i < played.length; i += 1) {
+    expect(played[i]).not.toBe(played[i - 1]);
+  }
+  expect(new Set(played)).toEqual(new Set(segments));
+});
+
+test("the bundled bank holds equal 16 kHz segments that share their seam samples", async () => {
+  const bank = await loadThinkingToneBank();
+  expect(bank.segments.length).toBeGreaterThan(1);
+  const samples = (segment: Uint8Array) =>
+    Array.from(new Int16Array(segment.buffer, segment.byteOffset, segment.byteLength / 2));
+  const reference = samples(bank.segments[0]);
+  expect(reference.length).toBe((bank.segmentDurationMs / 1000) * 16000);
+  for (const segment of bank.segments) {
+    const pcm = samples(segment);
+    expect(pcm.length).toBe(reference.length);
+    expect(pcm.slice(0, 8)).toEqual(reference.slice(0, 8));
+    expect(pcm.slice(-8)).toEqual(reference.slice(-8));
+  }
+});
