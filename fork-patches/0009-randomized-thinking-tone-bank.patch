+import { expect, test } from "vitest";
+import { nextSegmentStart, playSegmentChain, type SegmentChainHost } from "./segment-chain";
+
+interface Started {
+  id: number;
+  when: number;
+  end: () => void;
+  cancelled: boolean;
+}
+
+/** A host on a manual clock: each segment is one byte naming its id, lasting `frames / rate`. */
+function fakeHost(frames: number, rate: number) {
+  const clock = { now: 10 };
+  const started: Started[] = [];
+  const host: SegmentChainHost<{ id: number; frames: number }> = {
+    now: () => clock.now,
+    prepare: async (bytes) => ({ id: new Uint8Array(bytes)[0], frames }),
+    durationOf: (segment) => segment.frames / rate,
+    start(segment, when, onEnded) {
+      const entry: Started = { id: segment.id, when, end: onEnded, cancelled: false };
+      started.push(entry);
+      return () => {
+        entry.cancelled = true;
+      };
+    },
+  };
+  return { host, clock, started };
+}
+
+const bytes = (id: number) => new Uint8Array([id]).buffer;
+const flush = async () => {
+  for (let i = 0; i < 5; i += 1) await Promise.resolve();
+};
+
+test("starts each segment exactly where the previous one ends, one segment ahead", async () => {
+  const { host, clock, started } = fakeHost(52000, 16000);
+  let nextId = 1;
+  const playing = playSegmentChain(
+    host,
+    bytes(0),
+    () => bytes(nextId++),
+    new AbortController().signal,
+  );
+  await flush();
+
+  // The first segment starts now and the second is already scheduled at its end.
+  expect(started.map((s) => [s.id, s.when])).toEqual([
+    [0, 10],
+    [1, 13.25],
+  ]);
+
+  // Only when a segment ends does the one after the scheduled one get queued.
+  clock.now = 13.3; // the ended event arrives late; the schedule does not drift.
+  started[0].end();
+  await flush();
+  clock.now = 16.6;
+  started[1].end();
+  await flush();
+  expect(started.map((s) => s.when)).toEqual([10, 13.25, 16.5, 19.75]);
+  expect(started.map((s) => s.id)).toEqual([0, 1, 2, 3]);
+  void playing.catch(() => undefined);
+});
+
+test("aborting cancels the playing and the scheduled segment", async () => {
+  const { host, started } = fakeHost(16000, 16000);
+  const controller = new AbortController();
+  const playing = playSegmentChain(host, bytes(0), () => bytes(1), controller.signal);
+  await flush();
+  controller.abort();
+  await expect(playing).rejects.toThrow("Playback stopped");
+  expect(started.map((s) => s.cancelled)).toEqual([true, true]);
+
+  // A late ended event from a cancelled source schedules nothing.
+  started[0].end();
+  await flush();
+  expect(started).toHaveLength(2);
+});
+
+test("a failing next segment lets the chain play out and resolve", async () => {
+  const { host, started } = fakeHost(8000, 16000);
+  let calls = 0;
+  const playing = playSegmentChain(
+    host,
+    bytes(0),
+    () => {
+      calls += 1;
+      if (calls > 1) throw new Error("bank gone");
+      return bytes(1);
+    },
+    new AbortController().signal,
+  );
+  await flush();
+  started[0].end();
+  await flush();
+  started[1].end();
+  await expect(playing).resolves.toBe(1);
+});
+
+test("a chain that falls behind the clock restarts now instead of overlapping", () => {
+  expect(nextSegmentStart(13.25, 12)).toBe(13.25);
+  expect(nextSegmentStart(13.25, 20)).toBe(20);
+});
