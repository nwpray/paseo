@@ -0,0 +1,66 @@
+import { Buffer } from "buffer";
+
+export const THINKING_TONE_MIME_TYPE = "audio/pcm;rate=16000;bits=16";
+
+export interface ThinkingToneBank {
+  segments: readonly Uint8Array[];
+  segmentDurationMs: number;
+}
+
+/**
+ * Pick the next segment uniformly from every segment except the one just played, so the cue never
+ * repeats a segment back to back. `random` returns a number in [0, 1), like `Math.random`.
+ */
+export function pickNextSegmentIndex(
+  count: number,
+  previous: number | null,
+  random: () => number,
+): number {
+  if (count <= 1) {
+    return 0;
+  }
+  if (previous === null || previous < 0 || previous >= count) {
+    return Math.min(count - 1, Math.floor(random() * count));
+  }
+  const pick = Math.min(count - 2, Math.floor(random() * (count - 1)));
+  return pick >= previous ? pick + 1 : pick;
+}
+
+/** An endless random walk through the bank that never plays the same segment twice in a row. */
+export function createThinkingToneSequence(
+  bank: ThinkingToneBank,
+  random: () => number = Math.random,
+): () => Uint8Array {
+  let previous: number | null = null;
+  return () => {
+    previous = pickNextSegmentIndex(bank.segments.length, previous, random);
+    return bank.segments[previous];
+  };
+}
+
+let bankPromise: Promise<ThinkingToneBank> | null = null;
+
+/**
+ * The bank is about 1.1 MB of base64, so it stays out of the startup bundle and is decoded only
+ * when a cue first needs it.
+ */
+export function loadThinkingToneBank(): Promise<ThinkingToneBank> {
+  bankPromise ??= import("@/utils/thinking-tone-bank.native-pcm").then(
+    (module) => ({
+      segments: module.THINKING_TONE_BANK_BASE64.map((base64) =>
+        Uint8Array.from(Buffer.from(base64, "base64")),
+      ),
+      segmentDurationMs: module.THINKING_TONE_BANK_SEGMENT_DURATION_MS,
+    }),
+    (error: unknown) => {
+      bankPromise = null;
+      throw error;
+    },
+  );
+  return bankPromise;
+}
+
+/** Copy a segment so an engine can transfer or detach the buffer it is handed. */
+export function segmentArrayBuffer(segment: Uint8Array): ArrayBuffer {
+  return Uint8Array.from(segment).buffer;
+}
