diff --git a/packages/app/scripts/build-thinking-tone-bank.mjs b/packages/app/scripts/build-thinking-tone-bank.mjs
new file mode 100644
index 000000000..825606564
--- /dev/null
+++ b/packages/app/scripts/build-thinking-tone-bank.mjs
@@ -0,0 +1,132 @@
+#!/usr/bin/env node
+// Embed a bank of thinking-tone segments as base64 PCM16 for the voice cue.
+//
+// Usage: node scripts/build-thinking-tone-bank.mjs <wav-dir> [--match <regex>] [--out <file>]
+//   <wav-dir>   directory holding the segment WAVs; they are embedded in file-name order
+//   --match     only embed files whose name matches this regex (default: every .wav)
+//   --out       module to write (default: src/utils/thinking-tone-bank.native-pcm.ts)
+//
+// Example:
+//   node scripts/build-thinking-tone-bank.mjs ~/Desktop/paseo-thinking-sounds --match '^2a-bank-\d+\.wav$'
+//
+// Every WAV must be 16 kHz mono PCM16 and all of them the same length: the cue plays them back to
+// back in random order, so each one has to start and end in the same state as every other. The
+// samples are embedded as-is, with no gain applied.
+
+import { readFileSync, readdirSync, writeFileSync } from "node:fs";
+import { basename, dirname, join, relative, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const SAMPLE_RATE = 16000;
+
+function fail(message) {
+  console.error(message);
+  process.exit(1);
+}
+
+function parseArgs(argv) {
+  const args = {
+    dir: null,
+    match: null,
+    out: resolve(here, "../src/utils/thinking-tone-bank.native-pcm.ts"),
+  };
+  for (let i = 0; i < argv.length; i += 1) {
+    const arg = argv[i];
+    if (arg === "--match") {
+      args.match = new RegExp(argv[(i += 1)] ?? fail("--match needs a regex"));
+    } else if (arg === "--out") {
+      args.out = resolve(argv[(i += 1)] ?? fail("--out needs a path"));
+    } else if (arg === "--help" || arg === "-h") {
+      fail(
+        readFileSync(fileURLToPath(import.meta.url), "utf8")
+          .split("\n")
+          .slice(1, 15)
+          .join("\n"),
+      );
+    } else if (!args.dir) {
+      args.dir = resolve(arg);
+    } else {
+      fail(`Unexpected argument: ${arg}`);
+    }
+  }
+  if (!args.dir)
+    fail(
+      "Usage: node scripts/build-thinking-tone-bank.mjs <wav-dir> [--match <regex>] [--out <file>]",
+    );
+  return args;
+}
+
+/** Walk the RIFF chunks rather than assuming a 44-byte header. */
+function readPcm16Mono16k(path) {
+  const data = readFileSync(path);
+  if (data.toString("ascii", 0, 4) !== "RIFF" || data.toString("ascii", 8, 12) !== "WAVE") {
+    fail(`${path}: not a RIFF/WAVE file`);
+  }
+  let fmt = null;
+  let pcm = null;
+  let pos = 12;
+  while (pos + 8 <= data.length) {
+    const id = data.toString("ascii", pos, pos + 4);
+    const size = data.readUInt32LE(pos + 4);
+    const body = data.subarray(pos + 8, pos + 8 + size);
+    if (id === "fmt ") {
+      fmt = {
+        format: body.readUInt16LE(0),
+        channels: body.readUInt16LE(2),
+        sampleRate: body.readUInt32LE(4),
+        bitsPerSample: body.readUInt16LE(14),
+      };
+    } else if (id === "data") {
+      pcm = body;
+    }
+    pos += 8 + size + (size & 1);
+  }
+  if (!fmt) fail(`${path}: no fmt chunk`);
+  if (!pcm) fail(`${path}: no data chunk`);
+  if (
+    fmt.format !== 1 ||
+    fmt.channels !== 1 ||
+    fmt.sampleRate !== SAMPLE_RATE ||
+    fmt.bitsPerSample !== 16
+  ) {
+    fail(`${path}: need ${SAMPLE_RATE} Hz mono PCM16, got ${JSON.stringify(fmt)}`);
+  }
+  if (pcm.length % 2 !== 0) fail(`${path}: odd PCM16 byte length ${pcm.length}`);
+  return pcm;
+}
+
+const args = parseArgs(process.argv.slice(2));
+const files = readdirSync(args.dir)
+  .filter((name) => name.toLowerCase().endsWith(".wav") && (!args.match || args.match.test(name)))
+  .sort();
+if (files.length < 2) fail(`Need at least two segments in ${args.dir}, found ${files.length}`);
+
+const segments = files.map((name) => ({ name, pcm: readPcm16Mono16k(join(args.dir, name)) }));
+const samples = segments[0].pcm.length / 2;
+for (const segment of segments) {
+  if (segment.pcm.length / 2 !== samples) {
+    fail(
+      `${segment.name}: ${segment.pcm.length / 2} samples, expected ${samples} like ${segments[0].name}`,
+    );
+  }
+}
+
+const durationMs = (samples / SAMPLE_RATE) * 1000;
+const source = `// Generated by packages/app/scripts/build-thinking-tone-bank.mjs from ${files.join(", ")}.
+// Do not edit by hand; rerun the script.
+
+/**
+ * The voice thinking cue, as segments of 16 kHz mono PCM16. Every segment starts and ends in the
+ * same drone state, so any segment can follow any other with no gap.
+ */
+export const THINKING_TONE_BANK_SAMPLE_RATE = ${SAMPLE_RATE};
+export const THINKING_TONE_BANK_SEGMENT_DURATION_MS = ${durationMs};
+export const THINKING_TONE_BANK_BASE64: readonly string[] = [
+${segments.map((segment) => `  "${segment.pcm.toString("base64")}",`).join("\n")}
+];
+`;
+writeFileSync(args.out, source);
+console.log(
+  `Wrote ${segments.length} segments x ${samples} samples (${durationMs} ms) to ${relative(process.cwd(), args.out) || basename(args.out)}`,
+);
diff --git a/packages/app/scripts/lower-thinking-tone.mjs b/packages/app/scripts/lower-thinking-tone.mjs
deleted file mode 100644
index 8ed7d9e86..000000000
--- a/packages/app/scripts/lower-thinking-tone.mjs
+++ /dev/null
@@ -1,57 +0,0 @@
-#!/usr/bin/env node
-// Scale the amplitude of the thinking-tone PCM16 base64 in-place.
-// Usage: node scripts/lower-thinking-tone.mjs <gain>
-// Example: node scripts/lower-thinking-tone.mjs 0.3   (≈ -10 dB)
-
-import { readFileSync, writeFileSync } from "node:fs";
-import { fileURLToPath } from "node:url";
-import { dirname, resolve } from "node:path";
-
-const here = dirname(fileURLToPath(import.meta.url));
-const target = resolve(here, "../src/utils/thinking-tone.native-pcm.ts");
-
-const gainArg = process.argv[2];
-if (!gainArg) {
-  console.error("Usage: node scripts/lower-thinking-tone.mjs <gain>");
-  process.exit(1);
-}
-const gain = Number(gainArg);
-if (!Number.isFinite(gain) || gain < 0) {
-  console.error(`Invalid gain: ${gainArg}`);
-  process.exit(1);
-}
-
-const source = readFileSync(target, "utf8");
