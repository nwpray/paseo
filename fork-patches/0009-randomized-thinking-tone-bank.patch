+/** What a platform supplies to play a gapless chain of segments. Times are in seconds. */
+export interface SegmentChainHost<Segment> {
+  /** The clock `start` schedules against. */
+  now(): number;
+  prepare(bytes: ArrayBuffer): Segment | Promise<Segment>;
+  durationOf(segment: Segment): number;
+  /**
+   * Start `segment` at `when`, calling `onEnded` once it has finished. Returns a function that
+   * cancels it, whether it is playing or still scheduled.
+   */
+  start(segment: Segment, when: number, onEnded: () => void): () => void;
+}
+
+/**
+ * When the next segment starts: where the previous one ends, unless the chain has fallen behind
+ * the clock (a stalled event loop), in which case it restarts now rather than overlapping.
+ */
+export function nextSegmentStart(plannedStart: number, now: number): number {
+  return Math.max(plannedStart, now);
+}
+
+/**
+ * Play `first`, then a segment from `next()` after each, back to back, until `signal` aborts.
+ *
+ * One segment is always scheduled ahead: segment n+1 is scheduled when segment n starts, at the
+ * exact time segment n ends, so timer and event jitter only has to beat one segment's length.
+ * Aborting cancels the playing and the scheduled segment and rejects. If `next()` or `prepare`
+ * fails, the chain plays out what is scheduled and resolves with the seconds played.
+ */
+export function playSegmentChain<Segment>(
+  host: SegmentChainHost<Segment>,
+  first: ArrayBuffer,
+  next: () => ArrayBuffer,
+  signal: AbortSignal,
+): Promise<number> {
+  if (signal.aborted) return Promise.reject(new Error("Playback stopped"));
+  return new Promise<number>((resolve, reject) => {
+    const cancels = new Set<() => void>();
+    let plannedStart = host.now();
+    let played = 0;
+    let exhausted = false;
+    let settled = false;
+
+    const settle = (finish: () => void) => {
+      if (settled) return;
+      settled = true;
+      signal.removeEventListener("abort", abort);
+      finish();
+    };
+    function abort() {
+      for (const cancel of cancels) cancel();
+      cancels.clear();
+      settle(() => reject(new Error("Playback stopped")));
+    }
+    signal.addEventListener("abort", abort, { once: true });
+
+    const resolveIfDone = () => {
+      if (exhausted && cancels.size === 0) settle(() => resolve(played));
+    };
+
+    async function schedule(bytes: ArrayBuffer): Promise<void> {
+      const segment = await host.prepare(bytes);
+      if (settled) return;
+      const when = nextSegmentStart(plannedStart, host.now());
+      const duration = host.durationOf(segment);
+      plannedStart = when + duration;
+      const cancel = host.start(segment, when, () => {
+        if (!cancels.delete(cancel) || settled) return;
+        played += duration;
+        if (exhausted) {
+          resolveIfDone();
+        } else {
+          void scheduleNext();
+        }
+      });
+      cancels.add(cancel);
+    }
+
+    async function scheduleNext(): Promise<void> {
+      try {
+        await schedule(next());
+      } catch {
+        exhausted = true;
+        resolveIfDone();
+      }
+    }
+
+    schedule(first).then(
+      () => void scheduleNext(),
+      (error) => {
+        for (const cancel of cancels) cancel();
+        cancels.clear();
+        settle(() => reject(error));
+      },
+    );
+  });
+}
