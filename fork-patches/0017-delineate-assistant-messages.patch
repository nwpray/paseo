--- a/packages/app/src/agent-stream/layout.test.ts
+++ b/packages/app/src/agent-stream/layout.test.ts
@@ -148,6 +148,23 @@ function findLayoutItem(layout: StreamLayout, id: string): StreamLayoutItem {
 }
 
 describe("layoutStream", () => {
+  it.each(["web", "android"] as const)(
+    "completes an earlier live message while the next message streams on %s",
+    (platform) => {
+      const first = assistantMessage("first", 1);
+      const next = assistantMessage("next", 2);
+      const layout = layoutFor({
+        platform,
+        isTurnActive: true,
+        tail: [],
+        head: [first, next],
+      });
+
+      expect(findLayoutItem(layout, first.id).phase).toBe("complete");
+      expect(findLayoutItem(layout, next.id).phase).toBe("streaming");
+    },
+  );
+
   it("places one response footer after an adjacent tagged tool-only turn", () => {
     const priorAssistant = assistantMessage("prior", 1, undefined, "turn-1");
     const nextTool = toolCall("next-tool", 2, "turn-2");
diff --git a/packages/app/src/agent-stream/layout.ts b/packages/app/src/agent-stream/layout.ts
index 82ef98db5..eaadfac71 100644
--- a/packages/app/src/agent-stream/layout.ts
+++ b/packages/app/src/agent-stream/layout.ts
@@ -330,7 +330,12 @@ function layoutSegmentItem(
       isToolSequenceItem(item) &&
       !(isToolSequenceItem(belowItem) && continuesTurn(item, belowItem)),
     frameOrder: input.frameOrder,
-    phase: input.phase,
+    // Once another row follows a live assistant message, that message has finished
+    // and can own its copy/playback actions while the next message streams.
+    phase:
+      input.phase === "streaming" && item.kind === "assistant_message" && belowItem !== null
+        ? "complete"
+        : input.phase,
   });
 }
 
