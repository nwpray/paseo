+/** Actions belong to the source assistant message, even when a turn emits several messages. */
+export const AssistantMessageActionRow = memo(function AssistantMessageActionRow({
+  item,
+  text,
+  supportsTimelineCursor,
+  onForkAssistantTurn,
+  speechReplayScope,
+}: {
+  item: StreamItem;
+  text: string;
+  supportsTimelineCursor: boolean;
+  onForkAssistantTurn?: AssistantTurnForkHandler;
+  speechReplayScope?: SpeechReplayScope;
+}) {
+  const getContent = useCallback(() => text, [text]);
+  let boundary: AssistantTurnForkBoundary | undefined;
+  if (item.kind === "assistant_message") {
+    boundary = resolveAssistantTurnForkBoundary({
+      items: [item],
+      startIndex: 0,
+      supportsTimelineCursor,
+    });
+  } else if (item.kind === "tool_call") {
+    boundary = resolveSpokenToolForkBoundary({ item, supportsTimelineCursor });
+  }
+  const handleFork = useCallback(
+    (target: AssistantForkTarget) => {
+      if (boundary) return onForkAssistantTurn?.({ target, boundary });
+    },
+    [boundary, onForkAssistantTurn],
+  );
+  return (
+    <View style={[stylesheet.streamItemWrapper, stylesheet.messageActionsRow]}>
+      <AssistantTurnFooter
+        getContent={getContent}
+        onFork={boundary && onForkAssistantTurn ? handleFork : undefined}
+        speechReplayScope={speechReplayScope}
+        turnKey={item.id}
+      />
+    </View>
+  );
+});
+
