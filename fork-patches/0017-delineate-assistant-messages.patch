@@ -113,3 +113,43 @@ describe("resolveAssistantTurnForkBoundary", () => {
     ).toBeUndefined();
   });
 });
+
+describe("resolveSpokenToolForkBoundary", () => {
+  const spokenTool: Extract<StreamItem, { kind: "tool_call" }> = {
+    kind: "tool_call",
+    id: "speak-1",
+    timestamp: timestamp(2),
+    timelineCursor: { epoch: "timeline-1", seq: 42 },
+    payload: {
+      source: "agent",
+      data: {
+        provider: "claude",
+        callId: "speak-1",
+        name: "speak",
+        detail: { type: "unknown", input: "Hello", output: null },
+        status: "completed",
+        error: null,
+      },
+    },
+  };
+
+  it("forks a spoken tool row from its canonical cursor", () => {
+    expect(
+      resolveSpokenToolForkBoundary({ item: spokenTool, supportsTimelineCursor: true }),
+    ).toEqual({
+      boundaryCursor: { epoch: "timeline-1", seq: 42 },
+    });
+  });
+
+  it("does not offer an unsupported or missing cursor", () => {
+    expect(
+      resolveSpokenToolForkBoundary({ item: spokenTool, supportsTimelineCursor: false }),
+    ).toBeUndefined();
+    expect(
+      resolveSpokenToolForkBoundary({
+        item: { ...spokenTool, timelineCursor: undefined },
+        supportsTimelineCursor: true,
+      }),
+    ).toBeUndefined();
+  });
+});
diff --git a/packages/app/src/agent-stream/turn-boundary.ts b/packages/app/src/agent-stream/turn-boundary.ts
index f7cbe8c00..40589197e 100644
--- a/packages/app/src/agent-stream/turn-boundary.ts
+++ b/packages/app/src/agent-stream/turn-boundary.ts
@@ -21,3 +21,13 @@ export function resolveAssistantTurnForkBoundary(input: {
   }
   return item.messageId ? { boundaryMessageId: item.messageId } : undefined;
 }
+
+/** A spoken tool row can be a fork checkpoint when the host supplies timeline cursors. */
+export function resolveSpokenToolForkBoundary(input: {
+  item: Extract<StreamItem, { kind: "tool_call" }>;
+  supportsTimelineCursor: boolean;
+}): AssistantTurnForkBoundary | undefined {
+  return input.supportsTimelineCursor && input.item.timelineCursor
+    ? { boundaryCursor: input.item.timelineCursor }
+    : undefined;
+}
