+    [undefined, false, false, { kind: "interrupt" }],
+    [undefined, true, false, { kind: "interrupt" }],
+    [undefined, true, true, { kind: "interrupt" }],
+    ["interrupt", false, false, { kind: "interrupt" }],
+    ["interrupt", true, false, { kind: "interrupt" }],
+    ["interrupt", true, true, { kind: "interrupt" }],
+    // Steer folds into the running turn, or starts one when idle.
+    ["steer", false, false, { kind: "send", activeTurnBehavior: "steer" }],
+    ["steer", true, false, { kind: "send", activeTurnBehavior: "steer" }],
+    ["steer", true, true, { kind: "send", activeTurnBehavior: "steer" }],
+    // Queue holds the transcript while the agent works.
+    ["queue", false, false, { kind: "send", activeTurnBehavior: "steer" }],
+    ["queue", false, true, { kind: "send", activeTurnBehavior: "steer" }],
+    ["queue", true, false, { kind: "queue" }],
+    // A queued item would strand behind a parked permission, so it interrupts,
+    // matching resolveActiveSendBehavior in the composer.
+    ["queue", true, true, { kind: "send", activeTurnBehavior: "interrupt" }],
+  ] as const)(
+    "behaviour %s, run active %s, pending permission %s",
