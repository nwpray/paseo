@@ -0,0 +1,95 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createDucker, DUCK_GAIN, DUCK_HOLD_MS } from "./ducker";
+
+function setup() {
+  const calls: Array<[gain: number, timeConstantMs: number]> = [];
+  const ducker = createDucker({ setOutputGain: (gain, tau) => calls.push([gain, tau]) });
+  return { ducker, calls };
+}
+
+describe("ducker", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("fades to a whisper on speech, holds, then fades back up", () => {
+    const { ducker, calls } = setup();
+
+    ducker.speechStarted();
+    expect(calls).toEqual([[0.1, 67]]);
+
+    ducker.speechStopped();
+    vi.advanceTimersByTime(DUCK_HOLD_MS - 1);
+    expect(calls).toEqual([[0.1, 67]]);
+
+    vi.advanceTimersByTime(1);
+    expect(calls).toEqual([
+      [0.1, 67],
+      [1, 200],
+    ]);
+    expect(DUCK_GAIN).toBe(0.1);
+  });
+
+  it("stays ducked when speech resumes during the hold", () => {
+    const { ducker, calls } = setup();
+
+    ducker.speechStarted();
+    ducker.speechStopped();
+    vi.advanceTimersByTime(100);
+    ducker.speechStarted();
+    vi.advanceTimersByTime(DUCK_HOLD_MS * 4);
+
+    expect(calls).toEqual([[0.1, 67]]);
+  });
+
+  it("re-ducks from wherever the release has got to", () => {
+    const { ducker, calls } = setup();
+
+    ducker.speechStarted();
+    ducker.speechStopped();
+    vi.advanceTimersByTime(DUCK_HOLD_MS + 150);
+    ducker.speechStarted();
+
+    // Each change is a new target from the current value; the engine never jumps.
+    expect(calls).toEqual([
+      [0.1, 67],
+      [1, 200],
+      [0.1, 67],
+    ]);
+  });
+
+  it("ignores repeated starts and a stop with no start", () => {
+    const { ducker, calls } = setup();
+
+    ducker.speechStopped();
+    vi.advanceTimersByTime(DUCK_HOLD_MS);
+    ducker.speechStarted();
+    ducker.speechStarted();
+
+    expect(calls).toEqual([[0.1, 67]]);
+  });
+
+  it("reset restores full volume at once and cancels a pending release", () => {
+    const { ducker, calls } = setup();
+
+    ducker.speechStarted();
+    ducker.speechStopped();
+    ducker.reset();
+    vi.advanceTimersByTime(DUCK_HOLD_MS * 4);
+
+    expect(calls).toEqual([
+      [0.1, 67],
+      [1, 0],
+    ]);
+  });
+
+  it("reset when nothing is ducked does nothing", () => {
+    const { ducker, calls } = setup();
+    ducker.reset();
+    expect(calls).toEqual([]);
+  });
+});
