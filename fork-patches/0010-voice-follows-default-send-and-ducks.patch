+import { expect, test } from "vitest";
+import { rampAudioParam, type RampableParam } from "./gain-ramp";
+
+function recordingParam() {
+  const events: Array<[string, ...number[]]> = [];
+  const param: RampableParam = {
+    cancelScheduledValues: (t) => events.push(["cancel", t]),
+    setValueAtTime: (v, t) => events.push(["set", v, t]),
+    setTargetAtTime: (v, t, tau) => events.push(["target", v, t, tau]),
+  };
+  return { param, events };
+}
+
+test("approaches the target from the current value with the time constant in seconds", () => {
+  const { param, events } = recordingParam();
+  rampAudioParam(param, 2.5, 0.1, 67);
+  expect(events).toEqual([
+    ["cancel", 2.5],
+    ["target", 0.1, 2.5, 0.067],
+  ]);
+});
+
+test("a reversal mid-fade cancels only future events and starts a new approach now", () => {
+  const { param, events } = recordingParam();
+  rampAudioParam(param, 1, 0.1, 67);
+  rampAudioParam(param, 1.12, 1, 200);
+  expect(events).toEqual([
+    ["cancel", 1],
+    ["target", 0.1, 1, 0.067],
+    ["cancel", 1.12],
+    ["target", 1, 1.12, 0.2],
+  ]);
+});
+
+test("a zero time constant sets the value at once", () => {
+  const { param, events } = recordingParam();
+  rampAudioParam(param, 3, 1, 0);
+  expect(events).toEqual([
+    ["cancel", 3],
+    ["set", 1, 3],
+  ]);
+});
