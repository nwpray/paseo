new file mode 100644
index 000000000..dc46697a3
--- /dev/null
+++ b/packages/app/src/voice/ducker.ts
@@ -0,0 +1,62 @@
+/**
+ * Fork 0009: while the user speaks in voice mode, the agent's speech fades to a whisper and
+ * comes back after they stop. The engine runs each change as a one-pole approach from the
+ * current gain (`setOutputGain`), so a change of direction mid-fade never jumps.
+ */
+
+/** -20 dB. Still audible as "it is still talking", and 20 dB less echo for the VAD. */
+export const DUCK_GAIN = 0.1;
+/** Fade down in about 200 ms: three time constants reach within 5% of the target. */
+export const DUCK_ATTACK_TIME_CONSTANT_MS = 67;
+/** Rides out network jitter and back-to-back segments; the server already waits 1 s of silence. */
+export const DUCK_HOLD_MS = 250;
+/** Fade up in about 600 ms, slower than the fade down. */
+export const DUCK_RELEASE_TIME_CONSTANT_MS = 200;
+
+export interface DuckerPort {
+  /** A time constant of 0 sets the gain at once. */
+  setOutputGain(gain: number, timeConstantMs: number): void;
+}
+
+export interface Ducker {
+  speechStarted(): void;
+  speechStopped(): void;
+  /** Back to full volume at once. Only for moments when nothing is audible. */
+  reset(): void;
+}
+
+export function createDucker(port: DuckerPort): Ducker {
+  let ducked = false;
+  let hold: ReturnType<typeof setTimeout> | null = null;
+
+  function clearHold(): void {
+    if (hold) clearTimeout(hold);
+    hold = null;
+  }
+
+  return {
+    speechStarted() {
+      if (hold) {
+        clearHold();
+        return;
+      }
+      if (ducked) return;
+      ducked = true;
+      port.setOutputGain(DUCK_GAIN, DUCK_ATTACK_TIME_CONSTANT_MS);
+    },
+    speechStopped() {
+      if (!ducked || hold) return;
+      hold = setTimeout(() => {
+        hold = null;
+        ducked = false;
+        port.setOutputGain(1, DUCK_RELEASE_TIME_CONSTANT_MS);
+      }, DUCK_HOLD_MS);
+    },
+    reset() {
+      clearHold();
+      if (!ducked) return;
+      ducked = false;
+      port.setOutputGain(1, 0);
+    },
+  };
+}
