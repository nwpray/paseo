diff --git a/packages/app/src/audio/cue-layer.test.ts b/packages/app/src/audio/cue-layer.test.ts
new file mode 100644
index 000000000..cb22128d7
--- /dev/null
+++ b/packages/app/src/audio/cue-layer.test.ts
@@ -0,0 +1,147 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { RampableParam } from "./gain-ramp";
+import { startCueLayer } from "./cue-layer";
+
+/** A cue on a manual clock; records the gain automation and whether the chain was stopped. */
+function setup() {
+  const clock = { now: 10 };
+  const events: Array<[string, ...number[]]> = [];
+  const gain: RampableParam = {
+    cancelScheduledValues: (t) => events.push(["cancel", t]),
+    setValueAtTime: (v, t) => events.push(["set", v, t]),
+    setTargetAtTime: (v, t, tau) => events.push(["target", v, t, tau]),
+  };
+  let chainSignal: AbortSignal | null = null;
+  let endChain: () => void = () => {};
+  let disposed = 0;
+  let chainStarts = 0;
+  const advance = (ms: number) => {
+    clock.now += ms / 1000;
+    vi.advanceTimersByTime(ms);
+  };
+  const port = {
+    now: () => clock.now,
+    gain,
+    startChain(signal: AbortSignal) {
+      chainStarts += 1;
+      chainSignal = signal;
+      return new Promise<void>((resolve) => {
+        endChain = resolve;
+        signal.addEventListener("abort", () => resolve(), { once: true });
+      });
+    },
+    dispose: () => {
+      disposed += 1;
+    },
+  };
+  return {
+    port,
+    events,
+    advance,
+    chainStopped: () => chainSignal?.aborted ?? false,
+    endChain: () => endChain(),
+    disposed: () => disposed,
+    chainStarts: () => chainStarts,
+  };
+}
+
+describe("cue layer", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("fades in from silence over about 400 ms", () => {
+    const { port, events } = setup();
+    startCueLayer(port, 400);
+    expect(events).toEqual([
+      ["cancel", 10],
+      ["set", 0, 10],
+      ["target", 1, 10, 0.4 / 3],
+    ]);
+  });
+
+  it("fades out from the current gain, then stops the chain", async () => {
+    const { port, events, advance, chainStopped, disposed } = setup();
+    const cue = startCueLayer(port, 400);
+    advance(1000);
+    events.length = 0;
+
+    cue.release(350);
+    expect(events).toEqual([
+      ["cancel", 11],
+      ["target", 0, 11, 0.07],
+    ]);
+    advance(349);
+    expect(chainStopped()).toBe(false);
+    advance(1);
+    expect(chainStopped()).toBe(true);
+    await cue.ended;
+    expect(disposed()).toBe(1);
+  });
+
+  it("a restart during the fade-out ramps back up on the same chain", () => {
+    const { port, events, advance, chainStopped, chainStarts } = setup();
+    const cue = startCueLayer(port, 400);
+    advance(1000);
+    cue.release(350);
+    advance(150);
+    events.length = 0;
+
+    cue.resume(400);
+    advance(1000);
+
+    expect(events).toEqual([
+      ["cancel", 11.15],
+      ["target", 1, 11.15, 0.4 / 3],
+    ]);
+    expect(chainStopped()).toBe(false);
+    expect(chainStarts()).toBe(1);
+  });
+
+  it("resume does nothing while the cue is not fading out", () => {
+    const { port, events } = setup();
+    const cue = startCueLayer(port, 400);
+    events.length = 0;
+    cue.resume(400);
+    expect(events).toEqual([]);
+  });
+
+  it("a fast stop shortens a fade-out already under way", () => {
+    const { port, events, advance, chainStopped } = setup();
+    const cue = startCueLayer(port, 400);
+    cue.release(350);
+    advance(100);
+    events.length = 0;
+
+    cue.release(40);
+    expect(events).toEqual([
+      ["cancel", 10.1],
+      ["target", 0, 10.1, 0.008],
+    ]);
+    advance(40);
+    expect(chainStopped()).toBe(true);
+  });
+
+  it("a slower release does not stretch a faster one", () => {
+    const { port, events, advance, chainStopped } = setup();
+    const cue = startCueLayer(port, 400);
+    cue.release(40);
+    events.length = 0;
+    cue.release(350);
+    expect(events).toEqual([]);
+    advance(40);
+    expect(chainStopped()).toBe(true);
+  });
+
+  it("ends when the chain ends on its own", async () => {
+    const { port, endChain, disposed } = setup();
+    const cue = startCueLayer(port, 400);
+    endChain();
+    await cue.ended;
+    expect(disposed()).toBe(1);
+  });
+});
diff --git a/packages/app/src/audio/cue-layer.ts b/packages/app/src/audio/cue-layer.ts
new file mode 100644
index 000000000..ebb11bd4b
--- /dev/null
+++ b/packages/app/src/audio/cue-layer.ts
@@ -0,0 +1,87 @@
+import { rampAudioParam, type RampableParam } from "./gain-ramp";
+
+/**
+ * Fork 0009: a looping cue (the thinking tone) on its own gain stage, ahead of the output gain
+ * that ducking drives, so the two multiply instead of fighting. It plays outside the playback
+ * queue: a reply never waits behind it, and overlaps its fade-out as a short crossfade.
+ */
+export interface CueHandle {
+  /** Fade out from the current gain, then stop the chain. Again with a shorter fade speeds it up. */
+  release(fadeOutMs: number): void;
+  /** Called during a fade-out: fade back up from the current gain, on the same chain. */
+  resume(fadeInMs: number): void;
+  /** Settles once the cue has stopped: after a release, or because the chain ended. */
+  readonly ended: Promise<void>;
+}
+
+export interface CueLayerPort {
+  /** The clock the gain is automated on, in seconds. */
+  now(): number;
+  gain: RampableParam;
+  /** Start the segment chain; it settles when the chain ends or `signal` aborts. */
+  startChain(signal: AbortSignal): Promise<unknown>;
+  /** Detach the gain stage once the cue has stopped. */
+  dispose(): void;
+}
+
+/** Three time constants reach within 5% of full volume. */
+export const cueFadeInTimeConstantMs = (fadeInMs: number) => fadeInMs / 3;
+/** Five time constants reach -43 dB, where stopping the chain is inaudible. */
+export const cueFadeOutTimeConstantMs = (fadeOutMs: number) => fadeOutMs / 5;
+
+export function startCueLayer(port: CueLayerPort, fadeInMs: number): CueHandle {
+  const controller = new AbortController();
+  let stopTimer: ReturnType<typeof setTimeout> | null = null;
+  let releaseEndsAt: number | null = null;
+  let finished = false;
+  const ended = createLatch();
+  const stop = () => {
+    if (finished) return;
+    finished = true;
+    if (stopTimer) clearTimeout(stopTimer);
+    stopTimer = null;
+    controller.abort();
+    port.dispose();
+    ended.open();
+  };
+
+  const start = port.now();
+  port.gain.cancelScheduledValues(start);
+  port.gain.setValueAtTime(0, start);
+  port.gain.setTargetAtTime(1, start, cueFadeInTimeConstantMs(fadeInMs) / 1000);
+  port.startChain(controller.signal).then(
+    () => stop(),
+    () => stop(),
+  );
+
+  return {
+    ended: ended.promise,
+    release(fadeOutMs) {
+      if (finished) return;
+      const now = port.now();
+      const endsAt = now + Math.max(0, fadeOutMs) / 1000;
+      // A second, slower release must not stretch a fade already under way.
+      if (releaseEndsAt !== null && endsAt >= releaseEndsAt) return;
+      releaseEndsAt = endsAt;
+      rampAudioParam(port.gain, now, 0, cueFadeOutTimeConstantMs(fadeOutMs));
+      if (stopTimer) clearTimeout(stopTimer);
+      stopTimer = setTimeout(stop, Math.max(0, fadeOutMs));
+    },
+    resume(resumeFadeInMs) {
+      if (finished || releaseEndsAt === null) return;
+      releaseEndsAt = null;
+      if (stopTimer) clearTimeout(stopTimer);
+      stopTimer = null;
+      rampAudioParam(port.gain, port.now(), 1, cueFadeInTimeConstantMs(resumeFadeInMs));
+    },
+  };
+}
+
+/** A promise that settles once `open` is called. */
+function createLatch(): { promise: Promise<void>; open: () => void } {
+  const latch = { promise: Promise.resolve(), open: () => {} };
+  latch.promise = new Promise<void>((resolve) => {
+    latch.open = resolve;
+  });
+  return latch;
+}
