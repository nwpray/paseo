@@ -0,0 +1,31 @@
+import type { ActiveTurnBehavior, VoiceSendBehavior } from "../../messages.js";
+
+/**
+ * What a final voice transcript does.
+ * - `interrupt`: the pre-0009 path. Speech start already interrupted the agent; the transcript
+ *   replaces any run that started since.
+ * - `send`: dispatch now with the given active-turn behaviour.
+ * - `queue`: hand the transcript to the app's queue track.
+ */
+export type SpokenInputDisposition =
+  | { kind: "interrupt" }
+  | { kind: "send"; activeTurnBehavior: ActiveTurnBehavior }
+  | { kind: "queue" };
+
+export function resolveSpokenInputDisposition(input: {
+  sendBehavior: VoiceSendBehavior | undefined;
+  runActive: boolean;
+  pendingPermission: boolean;
+}): SpokenInputDisposition {
+  const { sendBehavior, runActive, pendingPermission } = input;
+  // COMPAT(voiceSendBehavior): apps before fork 0009 omit sendBehavior and keep today's
+  // interrupt; remove the undefined case after 2027-04-28.
+  if (sendBehavior === undefined || sendBehavior === "interrupt") return { kind: "interrupt" };
+  // Steer into an idle agent too: if it wakes in the same instant, the message folds into
+  // that turn instead of killing it.
+  if (sendBehavior === "steer" || !runActive) return { kind: "send", activeTurnBehavior: "steer" };
+  // A queued message would strand behind a parked permission. Typed input interrupts here
+  // (resolveActiveSendBehavior in the app's composer), and so does speech.
+  if (pendingPermission) return { kind: "send", activeTurnBehavior: "interrupt" };
+  return { kind: "queue" };
+}
