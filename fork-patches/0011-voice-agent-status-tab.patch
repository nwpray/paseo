--- /dev/null
+++ b/packages/app/src/components/ui/shape-morph/index.web.tsx
@@ -0,0 +1,58 @@
+import {
+  createAnimatedComponent,
+  useAnimatedProps,
+  type SharedValue,
+} from "react-native-reanimated";
+import Svg, { Path } from "react-native-svg";
+import { withUnistyles } from "react-native-unistyles";
+import type { Theme } from "@/styles/theme";
+import { SHAPE_OUTLINES, outlineToSvgPath, type Outline } from "./shapes";
+import { useShapeMorphFrame, type ShapeMorphProps } from "./use-shape-morph";
+
+export type { ShapeMorphProps } from "./use-shape-morph";
+
+// Web and Electron draw the morph as an inline SVG, written from the UI-thread frame, so
+// CanvasKit never loads on web. Native draws the same frames with Skia (index.tsx).
+
+const AnimatedPath = createAnimatedComponent(Path);
+// The fill sits on the Svg root and the paths inherit it, so Unistyles never patches a node
+// Reanimated animates. Not on a G: withUnistyles adds a wrapper div on web, which is
+// invalid inside an <svg> (see panel-tab.tsx).
+const ThemedSvg = withUnistyles(Svg);
+function fillColor(theme: Theme) {
+  return { fill: theme.colors.foreground };
+}
+
+const SLOTS = Array.from({ length: SHAPE_OUTLINES }, (_, k) => k);
+
+function MorphPath({ frame, index }: { frame: SharedValue<Outline[]>; index: number }) {
+  const animatedProps = useAnimatedProps(() => {
+    const outline = frame.value[index];
+    return { d: outlineToSvgPath(outline), fillOpacity: outline.opacity };
+  });
+  return <AnimatedPath animatedProps={animatedProps} />;
+}
+
+/** Morphs between shapes from `./shapes`. See ShapeMorphProps for the API. */
+export function ShapeMorph(props: ShapeMorphProps) {
+  const frame = useShapeMorphFrame(props);
+  const { width, height, color } = props;
+  const paths = SLOTS.map((k) => <MorphPath key={k} frame={frame} index={k} />);
+  if (color) {
+    return (
+      <Svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} fill={color}>
+        {paths}
+      </Svg>
+    );
+  }
+  return (
+    <ThemedSvg
+      width={width}
+      height={height}
+      viewBox={`0 0 ${width} ${height}`}
+      uniProps={fillColor}
+    >
+      {paths}
+    </ThemedSvg>
+  );
+}
diff --git a/packages/app/src/components/ui/shape-morph/shapes.test.ts b/packages/app/src/components/ui/shape-morph/shapes.test.ts
new file mode 100644
index 000000000..6402c2b4d
--- /dev/null
+++ b/packages/app/src/components/ui/shape-morph/shapes.test.ts
@@ -0,0 +1,237 @@
+import { describe, expect, it } from "vitest";
+import {
+  OUTLINE_POINTS,
+  SHAPE_NAMES,
+  SHAPE_OUTLINES,
+  columnX,
+  defaultVia,
+  emptyOutline,
+  evaluateShape,
+  isEmptyOutline,
+  morphFrame,
+  normalizeOutlines,
+  outlineCenter,
+  outlineToSvgPath,
+  pairOutlines,
+  planMorph,
+  shapeAt,
+  type Outline,
+  type ShapeParams,
+} from "./shapes";
+
+// The 18px mini meter: 3px bars, 3px gaps, a 15 × 18 box.
+const MINI: ShapeParams = {
+  width: 15,
+  height: 18,
+  barWidth: 3,
+  barGap: 3,
+  barHeights: [7, 12, 9],
+  barOpacities: [0.9, 0.95, 1],
+};
+
+function bounds(outline: Outline) {
+  const xs = outline.points.filter((_, i) => i % 2 === 0);
+  const ys = outline.points.filter((_, i) => i % 2 === 1);
+  return {
+    minX: Math.min(...xs),
+    maxX: Math.max(...xs),
+    minY: Math.min(...ys),
+    maxY: Math.max(...ys),
+  };
+}
+
+function expectFinite(outlines: readonly Outline[]) {
+  for (const outline of outlines) {
+    for (const value of outline.points) expect(Number.isFinite(value)).toBe(true);
+    expect(Number.isFinite(outline.opacity)).toBe(true);
+  }
+}
+
+function expectSame(a: readonly Outline[], b: readonly Outline[]) {
+  expect(a).toHaveLength(b.length);
+  a.forEach((outline, k) => {
+    outline.points.forEach((value, i) => expect(value).toBeCloseTo(b[k].points[i], 9));
+    expect(outline.opacity).toBeCloseTo(b[k].opacity, 9);
+  });
+}
+
+describe("shapeAt", () => {
+  it.each(SHAPE_NAMES)("normalizes %s to fixed outline and point counts", (name) => {
+    for (const t of [0, 133, 1600, 4999]) {
+      const outlines = shapeAt(name, t, MINI);
+      expect(outlines).toHaveLength(SHAPE_OUTLINES);
+      for (const outline of outlines) expect(outline.points).toHaveLength(OUTLINE_POINTS * 2);
+      expectFinite(outlines);
+    }
+  });
+
+  it("pads one-part shapes with empty outlines", () => {
+    for (const name of ["ring", "dot"] as const) {
+      const outlines = shapeAt(name, 0, MINI);
+      expect(outlines.filter((o) => !isEmptyOutline(o))).toHaveLength(1);
+    }
+  });
+
+  it("paints a bar exactly where VolumeMeter paints it", () => {
+    const [left, middle, right] = shapeAt("bars", 0, MINI);
+    expect(bounds(middle).maxY - bounds(middle).minY).toBeCloseTo(12, 1);
+    expect(bounds(middle).minY).toBeCloseTo((18 - 12) / 2, 1);
+    expect(bounds(left).minX).toBeCloseTo(0, 1);
+    expect(bounds(left).maxX).toBeCloseTo(3, 1);
+    expect(bounds(right).maxX).toBeCloseTo(15, 1);
+    expect(middle.opacity).toBeCloseTo(0.95);
+  });
+
+  it("fits the orbit in the box, at 0.8 opacity", () => {
+    for (const outline of shapeAt("orbit", 700, MINI)) {
+      const box = bounds(outline);
+      expect(box.minX).toBeGreaterThanOrEqual(0);
+      expect(box.maxX).toBeLessThanOrEqual(15);
+      expect(box.maxX - box.minX).toBeCloseTo(3.5, 1);
+      expect(outline.opacity).toBe(0.8);
+    }
+  });
+
+  it("winds every outline the same way", () => {
+    const area = (o: Outline) => {
+      let sum = 0;
+      for (let i = 0; i < OUTLINE_POINTS; i += 1) {
+        const j = (i + 1) % OUTLINE_POINTS;
+        sum += o.points[2 * i] * o.points[2 * j + 1] - o.points[2 * j] * o.points[2 * i + 1];
+      }
+      return sum;
+    };
+    for (const name of SHAPE_NAMES) {
+      for (const outline of shapeAt(name, 250, MINI)) {
+        if (!isEmptyOutline(outline)) expect(area(outline)).toBeGreaterThan(0);
+      }
+    }
+  });
+});
+
+describe("normalizeOutlines", () => {
+  it("resamples odd point counts, replaces NaN and clamps opacity", () => {
+    const square: Outline = { points: [0, 0, 10, 0, 10, 10, Number.NaN, 10], opacity: 4 };
+    const [outline, ...rest] = normalizeOutlines([square], MINI);
+    expect(outline.points).toHaveLength(OUTLINE_POINTS * 2);
+    expectFinite([outline, ...rest]);
+    expect(outline.opacity).toBe(1);
+    expect(rest.every(isEmptyOutline)).toBe(true);
+  });
+
+  it("keeps only the first SHAPE_OUTLINES outlines", () => {
+    const many = Array.from({ length: 5 }, () => evaluateShape("dot", 0, MINI)[0]);
+    expect(normalizeOutlines(many, MINI)).toHaveLength(SHAPE_OUTLINES);
+  });
+});
+
+describe("pairOutlines", () => {
+  it("pairs equal counts in x order so paths never cross", () => {
+    const bars = shapeAt("bars", 0, MINI);
+    const reversed = [bars[2], bars[1], bars[0]];
+    expect(pairOutlines(reversed, bars)).toEqual([2, 1, 0]);
+  });
+
+  it("sends one ring to the middle bar and grows the others from nothing", () => {
+    const ring = shapeAt("ring", 0, MINI);
+    const pairing = pairOutlines(ring, shapeAt("bars", 0, MINI));
+    expect(pairing[1]).toBe(0);
+    expect(new Set(pairing).size).toBe(SHAPE_OUTLINES);
+  });
+
+  it("is a permutation for every pair of presets", () => {
+    for (const a of SHAPE_NAMES) {
+      for (const b of SHAPE_NAMES) {
+        const pairing = pairOutlines(shapeAt(a, 300, MINI), shapeAt(b, 900, MINI));
+        expect([...pairing].sort()).toEqual([0, 1, 2]);
+      }
+    }
+  });
+});
+
+describe("morphFrame", () => {
+  function morph(from: (typeof SHAPE_NAMES)[number], to: (typeof SHAPE_NAMES)[number], p: number) {
+    const a = shapeAt(from, 0, MINI);
+    const b = shapeAt(to, 800, MINI);
+    const viaName = defaultVia(from, to);
+    const via = viaName ? shapeAt(viaName, 400, MINI) : null;
+    return {
+      a,
+      b,
+      frame: morphFrame({ from: a, via, to: b, plan: planMorph(a, via, b), progress: p }),
+    };
+  }
+
+  it("starts on the source and ends on the target, for every pair", () => {
+    for (const from of SHAPE_NAMES) {
+      for (const to of SHAPE_NAMES) {
+        const start = morph(from, to, 0);
+        const end = morph(from, to, 1);
+        const plan = planMorph(start.a, null, start.b);
+        // At p = 0 every target slot holds its paired source outline.
+        const viaName = defaultVia(from, to);
+        if (!viaName) {
+          start.frame.forEach((outline, k) => {
+            const source = start.a[plan.first[k]];
+            if (isEmptyOutline(source)) expect(isEmptyOutline(outline)).toBe(true);
+            else expectSame([outline], [source]);
+          });
+        }
+        end.frame.forEach((outline, k) => {
+          const target = end.b[k];
+          if (isEmptyOutline(target)) expect(isEmptyOutline(outline)).toBe(true);
+          else expectSame([outline], [target]);
+        });
+      }
+    }
+  });
+
+  it("never produces NaN, even for out-of-range progress", () => {
+    for (const p of [-1, 0, 0.25, 0.5, 0.75, 1, 2, Number.NaN]) {
+      for (const from of SHAPE_NAMES) {
+        for (const to of SHAPE_NAMES) expectFinite(morph(from, to, p).frame);
+      }
+    }
+  });
+
+  it("passes orbit to bars through the dots lined up on the bar columns", () => {
+    const { frame } = morph("orbit", "bars", 0.5);
+    frame.forEach((outline, k) => {
+      const [x, y] = outlineCenter(outline);
+      expect(x).toBeCloseTo(columnX(MINI, k), 5);
+      expect(y).toBeCloseTo(9, 5);
+      expect(bounds(outline).maxX - bounds(outline).minX).toBeCloseTo(3, 1);
+    });
+  });
+
+  it("eases opacity from the orbit's 0.8 to the bars' own", () => {
+    expect(morph("orbit", "bars", 0).frame.map((o) => o.opacity)).toEqual([0.8, 0.8, 0.8]);
+    const end = morph("orbit", "bars", 1).frame.map((o) => o.opacity);
+    [0.9, 0.95, 1].forEach((value, k) => expect(end[k]).toBeCloseTo(value));
+  });
+
+  it("grows a ring's missing bars out of points at their own columns", () => {
+    const { frame } = morph("ring", "bars", 0.001);
+    const [x] = outlineCenter(frame[0]);
+    expect(x).toBeCloseTo(columnX(MINI, 0), 5);
+    expect(bounds(frame[0]).maxY - bounds(frame[0]).minY).toBeLessThan(0.1);
+  });
+});
+
+describe("defaultVia", () => {
+  it("lines up between orbit and bars, both ways, and nowhere else", () => {
+    expect(defaultVia("orbit", "bars")).toBe("lineup");
+    expect(defaultVia("bars", "orbit")).toBe("lineup");
+    expect(defaultVia("ring", "bars")).toBeNull();
+    expect(defaultVia("orbit", "dot")).toBeNull();
+  });
+});
+
+describe("outlineToSvgPath", () => {
+  it("writes a closed path with one command per point", () => {
+    const d = outlineToSvgPath(emptyOutline(1, 2));
+    expect(d.startsWith("M1.00 2.00")).toBe(true);
+    expect(d.endsWith("Z")).toBe(true);
+    expect(d.match(/[ML]/g)).toHaveLength(OUTLINE_POINTS);
+  });
+});
diff --git a/packages/app/src/components/ui/shape-morph/shapes.ts b/packages/app/src/components/ui/shape-morph/shapes.ts
new file mode 100644
index 000000000..66e90a435
--- /dev/null
+++ b/packages/app/src/components/ui/shape-morph/shapes.ts
@@ -0,0 +1,618 @@
+// The shape model behind ShapeMorph. Pure and worklet-safe: every function runs on the JS
+// thread in tests and on the UI thread in the renderers, and none of it imports React,
+// Reanimated or Skia.
+//
+// A shape is a function of time and params that returns outlines: closed polygons with an
+// opacity. Every shape is normalized to SHAPE_OUTLINES outlines of OUTLINE_POINTS points,
+// so any two shapes tween point by point. A shape with fewer parts is padded with empty
+// outlines, zero-size points that grow out of (or shrink into) their counterpart during a
+// morph. That is how one ring becomes three bars.
+//
+// The presets are round-capped strokes along a centerline (a straight segment or an arc),
+// sampled the same way: side A, end cap, side B, start cap. Bars, dots (zero-length lines)
+// and arcs share that structure, so their points line up without twisting. Geometry follows
+// the voice-status mockup (option F, `.dev/mockups/voice-status-split.html`).
+//
+// Every worklet here sits above the worklets that call it (docs/coding-standards.md, React).
+
+/** A closed polygon as flat [x0, y0, x1, y1, ...] in box pixels, with its fill opacity. */
+export interface Outline {
+  points: number[];
+  opacity: number;
+}
+
+export interface ShapeParams {
+  /** Box size in px. 1 unit = 1px, origin at the top-left. */
+  width: number;
+  height: number;
+  /** Bar column geometry, as VolumeMeter lays it out (snapped widths). */
+  barWidth: number;
+  barGap: number;
+  /** Bar heights in px, one per bar. Used by `bars`; its length sets the column count. */
+  barHeights: readonly number[];
+  /** Bar opacities, one per bar. Defaults to BAR_OPACITY. */
+  barOpacities?: readonly number[];
+}
+
+/** A shape: outlines at time `t` (ms). Must be a worklet when passed to a renderer. */
+export type ShapeFn = (t: number, params: ShapeParams) => Outline[];
+
+export const SHAPE_NAMES = ["orbit", "bars", "ring", "dot", "ellipsis", "lineup"] as const;
+/** `lineup` is the dots sitting on the bar columns: the keyframe between orbit and bars. */
+export type ShapeName = (typeof SHAPE_NAMES)[number];
+
+/** Outlines per normalized shape. Shapes with more parts keep their first SHAPE_OUTLINES. */
+export const SHAPE_OUTLINES = 3;
+const SIDE_POINTS = 24;
+const CAP_POINTS = 8;
+/** Points per outline: two sides and two caps. */
+export const OUTLINE_POINTS = 2 * SIDE_POINTS + 2 * CAP_POINTS;
+
+const TWO_PI = Math.PI * 2;
+const EPSILON = 1e-6;
+
+// Opacities match VolumeMeter: rest bars 0.5, live bars 0.9-1.0. Loaders sit between.
+export const LOADER_OPACITY = 0.8;
+export const BAR_OPACITY = 0.9;
+
+// Orbit, at the 18px mini meter: a 4.5px radius (a quarter of the box height), 3.5px dots
+// (the bar width plus 0.5), one clockwise turn every 3.2s at constant speed.
+export const ORBIT_TURN_MS = 3200;
+const ORBIT_RADIUS_PER_HEIGHT = 0.25;
+const ORBIT_DOT_EXTRA = 0.5;
+// Ring: one broken arc, a spinner. Radius and stroke scale with the box and bar width.
+const RING_TURN_MS = 1600;
+const RING_RADIUS_PER_HEIGHT = 0.3;
+const RING_STROKE_PER_BAR = 0.42;
+const RING_GAP = 1.2;
+// Dot: one breathing dot.
+const DOT_PERIOD_MS = 1800;
+const DOT_RADIUS_PER_HEIGHT = 0.133;
+const DOT_BREATH_PER_HEIGHT = 0.044;
+// Ellipsis: typing-indicator dots on the bar columns, bouncing in sequence.
+const ELLIPSIS_PERIOD_MS = 1500;
+const ELLIPSIS_BOUNCE_PER_HEIGHT = 0.144;
+const ELLIPSIS_LAG = 0.75;
+
+interface LineBlob {
+  kind: "line";
+  ax: number;
+  ay: number;
+  bx: number;
+  by: number;
+  r: number;
+}
+
+interface ArcBlob {
+  kind: "arc";
+  ox: number;
+  oy: number;
+  R: number;
+  a0: number;
+  a1: number;
+  r: number;
+}
+
+type Blob = LineBlob | ArcBlob;
+
+function lineBlob(ax: number, ay: number, bx: number, by: number, r: number): LineBlob {
+  "worklet";
+  return { kind: "line", ax, ay, bx, by, r };
+}
+
+function dotBlob(x: number, y: number, r: number): LineBlob {
+  "worklet";
+  return lineBlob(x, y, x, y, r);
+}
+
+/**
+ * Samples a round-capped stroke into OUTLINE_POINTS points: side A from start to end, the
+ * end cap, side B back, then the start cap. A zero-length line points up, so dots and
+ * vertical bars start at the same place.
+ */
+function blobOutline(blob: Blob): number[] {
+  "worklet";
+  const pts: number[] = [];
+  const r = blob.r;
+  let cx0: number;
+  let cy0: number;
+  let cx1: number;
+  let cy1: number;
