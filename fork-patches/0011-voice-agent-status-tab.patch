+import { scheduleOnRN } from "react-native-worklets";
+import { withUnistyles } from "react-native-unistyles";
+import { SPACING, type Theme } from "@/styles/theme";
+
+/**
+ * hidden is fully sunk behind the panel and gives its reserved row back. compact sinks a
+ * little and shows only the leading content. expanded shows the leading content and label.
+ */
+export type PanelTabState = "hidden" | "compact" | "expanded";
+
+type PanelTabAccessibilityProps = Pick<
+  ViewProps,
+  | "role"
+  | "aria-live"
+  | "aria-label"
+  | "accessibilityRole"
+  | "accessibilityLabel"
+  | "accessibilityLiveRegion"
+  | "testID"
+>;
+
+interface PanelTabProps extends PanelTabAccessibilityProps {
+  state: PanelTabState;
+  /** Stays visible in compact, e.g. an avatar or a meter. At most 20px tall. */
+  leading: ReactNode;
+  /** Shown only when expanded. Keep it to one line; the tab is at most 320px wide. */
+  label?: ReactNode;
+  /** The panel the tab peeks from behind. It must be opaque: it hides the tab's base. */
+  children: ReactNode;
+  /**
+   * Grow to fill the parent instead of only shrinking with it, for a panel that fills its
+   * parent (a fullscreen composer). The wrapper sits between the parent and the panel, so it
+   * passes the panel's flex sizing through.
+   */
+  fill?: boolean;
+}
+
+// Geometry, from the voice-status mockup (option F). The tab's bottom TUCK px always sit
+// behind the panel, so the panel's top border cuts straight across the tab's base.
+const BORDER = 1;
+const CONTENT_HEIGHT = 20;
+const PAD_TOP = SPACING[2];
+const PAD_START = SPACING[2];
+const PAD_END = SPACING[4];
+const PAD_COMPACT = SPACING[1.5];
+const GAP = SPACING[2];
+/** Visible height when expanded: border, top padding, content, then 10px below it. */
+const PANEL_TAB_VISIBLE_HEIGHT = BORDER + PAD_TOP + CONTENT_HEIGHT + 10;
+const VISIBLE_HEIGHT = PANEL_TAB_VISIBLE_HEIGHT;
+const TUCK = SPACING[3];
+const TAB_HEIGHT = VISIBLE_HEIGHT + TUCK;
+/** The flare feet dip this far below the panel's top edge. */
+const FLARE_FOOT_DEPTH = SPACING[1];
+// Neither radius is a theme step. The flare leaves the tab side exactly where the top
+// corner ends, so the convex corner and the concave flare form one S-curve.
+const CORNER_RADIUS = 20;
+const FLARE_RADIUS = 22;
+const COMPACT_FLARE_RADIUS = FLARE_RADIUS * 0.75;
+const MAX_BODY_WIDTH = 320;
+// The outline is drawn on a fixed canvas so only the path changes per frame, never the
+// layout of the node that hosts it.
+const CANVAS_WIDTH = MAX_BODY_WIDTH + 2 * (FLARE_RADIUS + BORDER);
+
+const SINK: Record<PanelTabState, number> = {
+  hidden: VISIBLE_HEIGHT + 2,
+  compact: SPACING[1.5],
+  expanded: 0,
+};
+
+// Calm sheet motion: ease-in-out, no overshoot, much slower than control feedback.
+const RISE_MS = 860;
+const SINK_MS = 820;
+const SHAPE_MS = 680;
+/** Compacting waits for the label to fade so it never shows outside the narrowing body. */
+const COMPACT_DELAY_MS = 280;
+const LABEL_OUT_MS = 300;
+const LABEL_IN_MS = 380;
+const LABEL_IN_DELAY_MS = 620;
+/** The reserved row closes only once the tab is mostly behind the panel. */
+const RESERVE_CLOSE_DELAY_MS = 160;
+const RISE_EASING = Easing.bezier(0.33, 0, 0.2, 1);
+const SETTLE_EASING = Easing.bezier(0.45, 0, 0.25, 1);
+const SINK_EASING = Easing.bezier(0.55, 0, 0.45, 1);
+const LABEL_EASING = Easing.bezier(0.25, 0.1, 0.25, 1);
+
+function mix(from: number, to: number, progress: number): number {
+  "worklet";
+  return from + (to - from) * progress;
+}
+
+/** Whole device pixels, so the leading content (an avatar and its ring) paints on the grid. */
+function snapToDevicePixels(length: number, scale: number): number {
+  "worklet";
+  return Math.round(length * scale) / scale;
+}
+
+interface BodyMeasure {
+  /** 0 is compact, 1 is expanded. */
+  shape: number;
+  leadingWidth: number;
+  rowWidth: number;
+}
