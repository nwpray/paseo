+  const out: Outline[] = [];
+  for (let k = 0; k < SHAPE_OUTLINES; k += 1) {
+    const target = to[k];
+    const source = from[plan.first[plan.second[k]]];
+    const a = isEmptyOutline(source) ? target.opacity : source.opacity;
+    const b = isEmptyOutline(target) ? a : target.opacity;
