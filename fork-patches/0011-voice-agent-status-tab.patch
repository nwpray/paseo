+function expandedProgress(state: PanelTabState): number {
+  return state === "expanded" ? 1 : 0;
+}
+
+function reservedHeight(state: PanelTabState): number {
+  return state === "hidden" ? 0 : VISIBLE_HEIGHT;
+}
+
+interface TabMotion {
+  sink: SharedValue<number>;
+  shape: SharedValue<number>;
+  label: SharedValue<number>;
+  reserve: SharedValue<number>;
+}
+
+function animateTo({
+  motion,
+  from,
+  to,
+  onSunk,
+}: {
+  motion: TabMotion;
+  from: PanelTabState;
+  to: PanelTabState;
+  /** Runs once the tab is fully behind the panel and its row has closed. */
+  onSunk: () => void;
+}) {
+  const { sink, shape, label, reserve } = motion;
+  const fadeOut = withTiming(0, { duration: LABEL_OUT_MS, easing: LABEL_EASING });
+  if (to === "hidden") {
+    label.value = fadeOut;
+    sink.value = withTiming(SINK.hidden, { duration: SINK_MS, easing: SINK_EASING });
+    reserve.value = withDelay(
+      RESERVE_CLOSE_DELAY_MS,
+      withTiming(0, { duration: SINK_MS, easing: SINK_EASING }, (finished) => {
