+
+const AnimatedPath = createAnimatedComponent(Path);
+// Colors sit on the root and the path inherits them, so Unistyles never patches the node
+// Reanimated animates (docs/unistyles.md). Not on a G: withUnistyles adds a wrapper div on
+// web, which is invalid inside an <svg> and drops the outline.
+const ThemedSvg = withUnistyles(Svg);
