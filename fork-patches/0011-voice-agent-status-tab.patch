+ * while it waits or connects it shrinks to its avatar, and it sinks away as voice ends.
+ */
+export function resolveAgentVoiceTabState(status: AgentVoiceStatus): PanelTabState {
+  if (status === "thinking" || status === "speaking") return "expanded";
+  if (status === "ending") return "hidden";
+  return "compact";
 }
