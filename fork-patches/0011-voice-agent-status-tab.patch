+import { describe, expect, it } from "vitest";
+import type { ProviderSnapshotEntry } from "@getpaseo/protocol/agent-types";
+import { resolveProviderDisplayName } from "./provider-definitions";
+
+function entry(provider: string, label: string): ProviderSnapshotEntry {
+  return { provider, label, status: "ready", enabled: true };
+}
+
+describe("resolveProviderDisplayName", () => {
+  it("prefers the host snapshot's label", () => {
+    expect(resolveProviderDisplayName("claude", [entry("claude", "Claude (work)")])).toBe(
+      "Claude (work)",
+    );
+  });
+
+  it("falls back to the built-in name before the snapshot loads", () => {
+    expect(resolveProviderDisplayName("claude", undefined)).toBe("Claude");
+    expect(resolveProviderDisplayName("codex", [entry("claude", "Claude")])).toBe("Codex");
+  });
+
+  it("falls back to the ACP catalog title, then the raw id", () => {
+    expect(resolveProviderDisplayName("amp-acp", undefined)).toBe("Amp");
+    expect(resolveProviderDisplayName("my-custom-agent", undefined)).toBe("my-custom-agent");
+  });
+});
