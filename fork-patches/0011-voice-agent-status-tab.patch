diff --git a/packages/app/src/components/agent-voice-tab.tsx b/packages/app/src/components/agent-voice-tab.tsx
new file mode 100644
index 000000000..8210e8a6a
--- /dev/null
+++ b/packages/app/src/components/agent-voice-tab.tsx
@@ -0,0 +1,372 @@
+import { useEffect, useMemo, useRef, type ReactNode } from "react";
+import { useTranslation } from "react-i18next";
+import { AccessibilityInfo, PixelRatio, Platform, Text, View } from "react-native";
+import Animated, {
+  cancelAnimation,
+  Easing,
+  interpolateColor,
+  useAnimatedStyle,
+  useReducedMotion,
+  useSharedValue,
+  withRepeat,
+  withTiming,
+} from "react-native-reanimated";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import { useProviderIcon } from "@/components/provider-icons";
+import { useRetainedPanelActive } from "@/components/retained-panel";
+import { PanelTab } from "@/components/ui/panel-tab";
+import { VolumeMeter } from "@/components/volume-meter";
+import {
+  resolveAgentVoiceStatus,
+  resolveAgentVoiceStatusKey,
+  resolveAgentVoiceTabState,
+  type AgentVoiceStatus,
+} from "@/composer/input/labels";
+import { useProvidersSnapshot } from "@/hooks/use-providers-snapshot";
+import { ICON_SIZE, SPACING, type Theme } from "@/styles/theme";
+import { resolveProviderDisplayName } from "@/utils/provider-definitions";
+import type { VoiceRuntimePhase } from "@/voice/voice-runtime";
+
+/** The voice session the composer's agent is in. */
+export interface AgentVoiceSession {
+  serverId: string;
+  /** The agent's provider id, for its name and icon. Unknown before the agent loads. */
+  provider: string | null;
+  cwd: string | null;
+  phase: VoiceRuntimePhase;
+}
+
+interface AgentVoiceTabProps {
+  /** null while voice is off for this composer's agent. */
+  session: AgentVoiceSession | null;
+  /**
+   * The agent's playback level, 0..1, for the Speaking meter. Voice telemetry has no
+   * playback level yet, so this stays 0 and the meter runs its idle pulse. Pass the real
+   * level here once telemetry carries one.
+   */
+  agentPlaybackLevel?: number;
+  /** Fill the parent, for a fullscreen composer. */
+  fill?: boolean;
+  /** The composer card. It must be opaque: it hides the tab's base. */
+  children: ReactNode;
+}
+
+/** The stream's jump button sits this far above the tab's top, on the tab's center axis. */
+export const AGENT_VOICE_TAB_JUMP_GAP = SPACING[2];
+
+const AVATAR_SIZE = 20;
+const AVATAR_ICON_SIZE = ICON_SIZE.xs;
+// The Speaking ring is two box-shadow layers on the avatar itself, a gap in the tab surface
+// and the ring outside it, so it is drawn from the avatar's own pixel-snapped box and can't
+// drift off-center. Not an outline: Chrome rounds outline width and offset to whole CSS
+// pixels, which turns the pulse into 1px jumps.
+const RING_GAP = 1.5;
+const RING_WIDTH = 1.5;
+// The pulse moves the ring out and back the same distance on every side and swells its
+// alpha, so it reads as breathing from the center.
+const RING_SPREAD_REST = -1;
+const RING_SPREAD_PEAK = 0.5;
+const RING_ALPHA_REST = 0.15;
+const RING_ALPHA_PEAK = 0.8;
+const RING_ALPHA_STILL = 0.6;
+const RING_PULSE_HALF_MS = 600;
+const RING_FADE_MS = 200;
+
+/** Whole device pixels, so the ring's width and gap paint evenly on both sides. */
+function snapToDevicePixels(length: number, scale: number): number {
+  return Math.max(1, Math.round(length * scale)) / scale;
+}
+
+/** The status the label shows: the last busy one, so it never flips while fading out. */
+function useShownBusyStatus(status: AgentVoiceStatus): "thinking" | "speaking" {
+  const shown = useRef<"thinking" | "speaking">("thinking");
+  if (status === "thinking" || status === "speaking") shown.current = status;
+  return shown.current;
+}
+
+function useRetainedSession(session: AgentVoiceSession | null): AgentVoiceSession | null {
+  const retained = useRef(session);
+  if (session) retained.current = session;
+  return retained.current;
+}
+
+/**
+ * The agent's side of a voice session: a tab that peeks from behind the composer card with
+ * the agent's avatar, and while it thinks or speaks, its name, status and meter. Mute is the
+ * user's side and lives in the voice strip, so it never changes what this tab shows.
+ */
+export function AgentVoiceTab({
+  session,
+  agentPlaybackLevel = 0,
+  fill = false,
+  children,
+}: AgentVoiceTabProps) {
+  const { t } = useTranslation();
+  // Keep the last session while the tab sinks away after voice ends.
+  const shownSession = useRetainedSession(session);
+  const status: AgentVoiceStatus = session
+    ? resolveAgentVoiceStatus({ phase: session.phase })
+    : "ending";
+  const busyStatus = useShownBusyStatus(status);
+  const provider = shownSession?.provider ?? null;
+  const { entries } = useProvidersSnapshot(session ? session.serverId : null, {
+    cwd: shownSession?.cwd,
+    enabled: session !== null,
+  });
+  const name = provider
+    ? resolveProviderDisplayName(provider, entries)
+    : t("realtimeVoice.agentFallbackName");
+  const statusText = t(resolveAgentVoiceStatusKey(status));
+  const announcement = t("realtimeVoice.agentStatus", { provider: name, status: statusText });
+
+  useEffect(() => {
+    // iOS has no live regions; announce each change of status instead.
+    if (Platform.OS === "ios" && session) AccessibilityInfo.announceForAccessibility(announcement);
+  }, [announcement, session]);
+
+  const leading = useMemo(
+    () => (
+      <AgentAvatar
+        provider={provider ?? ""}
+        serverId={shownSession?.serverId ?? null}
+        isSpeaking={status === "speaking"}
+        announcement={announcement}
+      />
+    ),
+    [provider, shownSession?.serverId, status, announcement],
+  );
+  const label = useMemo(
+    () => <AgentVoiceLabel name={name} status={busyStatus} level={agentPlaybackLevel} />,
+    [name, busyStatus, agentPlaybackLevel],
+  );
+
+  return (
+    <PanelTab
+      state={resolveAgentVoiceTabState(status)}
+      leading={leading}
+      label={label}
+      fill={fill}
+      role="status"
+      aria-live="polite"
+      accessibilityLiveRegion="polite"
+      aria-label={announcement}
+      testID="agent-voice-tab"
+    >
+      {children}
+    </PanelTab>
+  );
+}
+
+interface AgentAvatarProps {
+  provider: string;
+  serverId: string | null;
+  isSpeaking: boolean;
+  /** The tab's full status, as live-region text a screen reader announces when it changes. */
+  announcement: string;
+}
+
+function AgentAvatar({ provider, serverId, isSpeaking, announcement }: AgentAvatarProps) {
+  const Icon = useProviderIcon(provider, serverId);
+  const icon = useMemo(
+    () => <ThemedAvatarIcon Icon={Icon} uniProps={avatarIconColorMapping} />,
+    [Icon],
+  );
+  return (
+    <View>
+      <ThemedAvatarRing isSpeaking={isSpeaking} uniProps={avatarRingColorMapping}>
+        {icon}
+      </ThemedAvatarRing>
+      <Text style={styles.announcement} testID="agent-voice-tab-announcement">
+        {announcement}
+      </Text>
+    </View>
+  );
+}
+
+function AvatarIcon({ Icon, color }: { Icon: ReturnType<typeof useProviderIcon>; color: string }) {
+  return <Icon size={AVATAR_ICON_SIZE} color={color} />;
+}
+const ThemedAvatarIcon = withUnistyles(AvatarIcon);
+function avatarIconColorMapping(theme: Theme) {
+  return { color: theme.colors.foreground };
+}
+
+interface AvatarRingProps {
+  isSpeaking: boolean;
+  fillColor: string;
+  /** The surface behind the avatar: the ring fades from it, so its rest alpha is a tint. */
+  surfaceColor: string;
+  ringColor: string;
+  children: ReactNode;
+}
+
+/**
+ * The avatar disc. Reanimated owns this node, so its colors arrive as props (withUnistyles)
+ * and go in as plain styles, never as a Unistyles style (docs/unistyles.md).
+ */
+function AvatarRing({ isSpeaking, fillColor, surfaceColor, ringColor, children }: AvatarRingProps) {
+  const reduceMotion = useReducedMotion();
+  const isPanelActive = useRetainedPanelActive();
+  const scale = PixelRatio.get();
+  const ringGap = snapToDevicePixels(RING_GAP, scale);
+  const ringWidth = snapToDevicePixels(RING_WIDTH, scale);
+  const visibility = useSharedValue(isSpeaking ? 1 : 0);
+  const pulse = useSharedValue(0);
+
+  useEffect(() => {
+    visibility.value = reduceMotion
+      ? Number(isSpeaking)
+      : withTiming(Number(isSpeaking), { duration: RING_FADE_MS });
+  }, [isSpeaking, reduceMotion, visibility]);
+
+  // The pulse is an infinite animation, so it runs only while the ring shows on an active panel.
+  const isPulsing = isSpeaking && isPanelActive && !reduceMotion;
+  useEffect(() => {
+    if (!isPulsing) {
+      cancelAnimation(pulse);
+      pulse.value = 0;
+      return;
+    }
+    pulse.value = withRepeat(
+      withTiming(1, { duration: RING_PULSE_HALF_MS, easing: Easing.inOut(Easing.ease) }),
+      -1,
+      true,
+    );
+    return () => cancelAnimation(pulse);
+  }, [isPulsing, pulse]);
+
+  const ringStyle = useAnimatedStyle(() => {
+    const restAlpha = reduceMotion ? RING_ALPHA_STILL : RING_ALPHA_REST;
+    const peakAlpha = reduceMotion ? RING_ALPHA_STILL : RING_ALPHA_PEAK;
+    const alpha = (restAlpha + (peakAlpha - restAlpha) * pulse.value) * visibility.value;
+    const spread = reduceMotion
+      ? 0
+      : RING_SPREAD_REST + (RING_SPREAD_PEAK - RING_SPREAD_REST) * pulse.value;
+    if (visibility.value <= 0) return { boxShadow: [] };
+    const gap = ringGap + spread;
+    return {
+      boxShadow: [
+        { offsetX: 0, offsetY: 0, blurRadius: 0, spreadDistance: gap, color: surfaceColor },
+        {
+          offsetX: 0,
+          offsetY: 0,
+          blurRadius: 0,
+          spreadDistance: gap + ringWidth,
+          color: interpolateColor(alpha, [0, 1], [surfaceColor, ringColor]),
+        },
+      ],
+    };
+  });
+  const fillStyle = useMemo(() => ({ backgroundColor: fillColor }), [fillColor]);
+
+  return (
+    <Animated.View style={[avatarStyles.avatar, fillStyle, ringStyle]} testID="agent-voice-avatar">
+      {children}
+    </Animated.View>
+  );
+}
+const ThemedAvatarRing = withUnistyles(AvatarRing);
+function avatarRingColorMapping(theme: Theme) {
+  return {
+    fillColor: theme.colors.surface3,
+    surfaceColor: theme.colors.surface2,
+    ringColor: theme.colors.accentBright,
+  };
+}
+
+interface AgentVoiceLabelProps {
+  name: string;
+  status: "thinking" | "speaking";
+  level: number;
+}
+
+/** "Claude · ⋯ Thinking". The screen reader hears the tab's name, so the row is hidden. */
+function AgentVoiceLabel({ name, status, level }: AgentVoiceLabelProps) {
+  const { t } = useTranslation();
+  return (
+    <View style={styles.label} aria-hidden importantForAccessibility="no-hide-descendants">
+      <Text style={styles.name} numberOfLines={1}>
+        {name}
+      </Text>
+      <Text style={styles.separator}>·</Text>
+      <View style={styles.status}>
+        <VolumeMeter
+          volume={level}
+          orientation="horizontal"
+          variant="mini"
+          mode={status === "thinking" ? "think" : "live"}
+        />
+        <ThemedStatusWord
+          text={t(resolveAgentVoiceStatusKey(status))}
+          uniProps={statusWordColorMapping}
+        />
+      </View>
+    </View>
+  );
+}
+
+function StatusWord({ text, color }: { text: string; color: string }) {
+  const style = useMemo(() => [styles.statusText, { color }], [color]);
+  return (
+    <Text style={style} numberOfLines={1}>
+      {text}
+    </Text>
+  );
+}
+const ThemedStatusWord = withUnistyles(StatusWord);
+// foregroundMuted on surface2 is 5.8:1 in dark but 4.4:1 in light, under AA for 12px text,
+// so light uses foreground. A mapping, not a StyleSheet branch: on web the stylesheet is
+// built once with color variables, so a colorScheme branch there would never switch.
+function statusWordColorMapping(theme: Theme) {
+  return {
+    color: theme.colorScheme === "light" ? theme.colors.foreground : theme.colors.foregroundMuted,
+  };
+}
+
+// Plain styles: the avatar disc is a Reanimated node.
+const avatarStyles = {
+  avatar: {
+    width: AVATAR_SIZE,
+    height: AVATAR_SIZE,
+    borderRadius: AVATAR_SIZE / 2,
+    alignItems: "center",
+    justifyContent: "center",
+  },
+} as const;
+
+const styles = StyleSheet.create((theme) => ({
+  // Off-screen live-region text: present for assistive tech, takes no layout.
+  announcement: {
+    position: "absolute",
+    width: 1,
+    height: 1,
+    overflow: "hidden",
+    opacity: 0,
+  },
+  label: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[2],
+    minWidth: 0,
+  },
+  name: {
+    flexShrink: 1,
+    fontSize: theme.fontSize.sm,
+    fontWeight: theme.fontWeight.medium,
+    color: theme.colors.foreground,
+  },
+  separator: {
+    fontSize: theme.fontSize.sm,
+    fontWeight: theme.fontWeight.medium,
+    color: theme.colors.foregroundExtraMuted,
+  },
+  status: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[1.5],
+  },
+  statusText: {
+    fontSize: theme.fontSize.sm,
+    fontWeight: theme.fontWeight.medium,
+  },
+}));
