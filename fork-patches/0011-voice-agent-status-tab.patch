+
+// ShapeMorph morphs any preset into any other, point by point. Orbit → bars is the
+// flagship: the agent meter's Thinking → Speaking. Every specimen renders at the 18px mini
+// meter size and at 5×, so the geometry is readable.
+
+type PickableShape = Exclude<ShapeName, "lineup">;
+
+const SHAPE_OPTIONS: SegmentedControlOption<PickableShape>[] = [
+  { value: "orbit", label: "Orbit" },
+  { value: "bars", label: "Bars" },
+  { value: "ring", label: "Ring" },
+  { value: "dot", label: "Dot" },
+  { value: "ellipsis", label: "Ellipsis" },
+];
+const ALL_SHAPES: readonly ShapeName[] = ["orbit", "bars", "ring", "dot", "ellipsis", "lineup"];
+const SCRUB_STOPS = [0, 0.25, 0.5, 0.75, 1] as const;
+
+interface Scale {
+  label: string;
+  factor: number;
+}
+
+// The mini meter box (MINI_SIZE in volume-meter.tsx): 3px bars and gaps, 15 × 18.
+const MINI_BAR = 3;
+const MINI_HEIGHT = 18;
+const MINI_MIN_BAR = 7;
+const MINI_MAX_BAR = 16;
+const SCALES: readonly Scale[] = [
+  { label: "18px mini", factor: 1 },
+  { label: "5×", factor: 5 },
+];
+/** Per-bar share of a speech level, as the meter's budget splits it. */
+const BAR_SHARES = [0.85, 1.15, 0.95] as const;
+
+/** Bar heights for a speech level at a scale, between the meter's rest and ceiling heights. */
+function barHeightsFor(level: number, factor: number): number[] {
+  return BAR_SHARES.map(
+    (share) =>
+      factor *
+      Math.min(MINI_MAX_BAR, MINI_MIN_BAR + (MINI_MAX_BAR - MINI_MIN_BAR) * level * share * 1.4),
+  );
+}
+
+function useSpeakingHeights(factor: number): number[] {
+  const volume = useSimulatedVolume(0.45);
+  return useMemo(() => barHeightsFor(volume, factor), [volume, factor]);
+}
+
+function geometry(factor: number) {
+  return {
+    width: factor * (3 * MINI_BAR + 2 * MINI_BAR),
+    height: factor * MINI_HEIGHT,
+    barWidth: factor * MINI_BAR,
+    barGap: factor * MINI_BAR,
+  };
+}
+
+function ShapePickers({
+  from,
+  to,
+  onFrom,
+  onTo,
+}: {
+  from: PickableShape;
+  to: PickableShape;
+  onFrom: (value: PickableShape) => void;
+  onTo: (value: PickableShape) => void;
+}) {
+  return (
+    <View style={styles.controls}>
+      <View style={styles.control}>
+        <Text style={styles.controlLabel}>From</Text>
+        <SegmentedControl size="sm" options={SHAPE_OPTIONS} value={from} onValueChange={onFrom} />
+      </View>
+      <View style={styles.control}>
+        <Text style={styles.controlLabel}>To</Text>
+        <SegmentedControl size="sm" options={SHAPE_OPTIONS} value={to} onValueChange={onTo} />
+      </View>
+    </View>
+  );
+}
+
+/** A drag track for progress, plus stops for exact frames. */
+function ProgressScrub({ value, onChange }: { value: number; onChange: (value: number) => void }) {
+  const [trackWidth, setTrackWidth] = useState(0);
+  const handleLayout = useCallback(
+    (event: LayoutChangeEvent) => setTrackWidth(event.nativeEvent.layout.width),
+    [],
+  );
+  const handleTouch = useCallback(
+    (event: GestureResponderEvent) => {
+      if (trackWidth <= 0) return;
+      onChange(Math.min(1, Math.max(0, event.nativeEvent.locationX / trackWidth)));
+    },
+    [onChange, trackWidth],
+  );
+  const grant = useCallback(() => true, []);
+  return (
+    <View style={styles.control}>
+      <Text style={styles.controlLabel}>Progress {value.toFixed(2)}</Text>
+      <View
+        style={styles.track}
+        onLayout={handleLayout}
+        onStartShouldSetResponder={grant}
+        onMoveShouldSetResponder={grant}
+        onResponderGrant={handleTouch}
+        onResponderMove={handleTouch}
+        testID="shape-morph-scrub"
+      >
+        <View pointerEvents="none" style={styles.trackFill(value)} />
+      </View>
+      <View style={styles.stops}>
+        {SCRUB_STOPS.map((stop) => (
+          <ScrubStop key={stop} stop={stop} active={stop === value} onChange={onChange} />
+        ))}
+      </View>
+    </View>
+  );
+}
+
+function ScrubStop({
+  stop,
+  active,
+  onChange,
+}: {
+  stop: number;
+  active: boolean;
+  onChange: (value: number) => void;
+}) {
+  const handlePress = useCallback(() => onChange(stop), [onChange, stop]);
+  return (
+    <Button
+      size="xs"
+      variant={active ? "secondary" : "ghost"}
+      onPress={handlePress}
+      testID={`shape-morph-stop-${stop}`}
+    >
+      {String(stop)}
+    </Button>
+  );
+}
+
+function ScrubSpecimen({
+  scale,
+  from,
+  to,
+  progress,
+}: {
+  scale: Scale;
+  from: PickableShape;
+  to: PickableShape;
+  progress: number;
+}) {
+  const heights = useSpeakingHeights(scale.factor);
+  const progressValue = useSharedValue(progress);
+  useEffect(() => {
+    progressValue.value = progress;
+  }, [progress, progressValue]);
+  return (
+    <DesignSpecimen label={scale.label}>
+      <ShapeMorph
+        from={from}
+        shape={to}
+        progress={progressValue}
+        barHeights={heights}
+        {...geometry(scale.factor)}
+      />
+    </DesignSpecimen>
+  );
+}
+
+function Scrub() {
+  const [from, setFrom] = useState<PickableShape>("orbit");
+  const [to, setTo] = useState<PickableShape>("bars");
+  const [progress, setProgress] = useState(0.25);
+  return (
+    <DesignPage>
+      <DesignSection
+        title="Scrub"
+        description="Pick two presets and drag the progress. Orbit ↔ bars pass through the dots lined up on the bar columns at 0.5. Animated shapes hold still while scrubbing."
+      >
+        <ShapePickers from={from} to={to} onFrom={setFrom} onTo={setTo} />
+        <ProgressScrub value={progress} onChange={setProgress} />
+        <DesignRow>
+          {SCALES.map((scale) => (
+            <ScrubSpecimen
+              key={scale.label}
+              scale={scale}
+              from={from}
+              to={to}
+              progress={progress}
+            />
+          ))}
+        </DesignRow>
+      </DesignSection>
+    </DesignPage>
+  );
+}
+
+const HOLD_MS = 2200;
+
+/** Flips between the two shapes, holding each long enough to read it. */
+function useLoopTarget(from: PickableShape, to: PickableShape): PickableShape {
+  const [atTarget, setAtTarget] = useState(false);
+  useEffect(() => {
+    const timer = setTimeout(() => setAtTarget(!atTarget), HOLD_MS + SHAPE_MORPH_DURATION_MS);
+    return () => clearTimeout(timer);
+  }, [atTarget]);
+  return atTarget ? to : from;
+}
+
+function LoopSpecimen({
+  scale,
+  shape,
+  paused,
+}: {
+  scale: Scale;
+  shape: PickableShape;
+  paused?: boolean;
+}) {
+  const heights = useSpeakingHeights(scale.factor);
+  return (
+    <DesignSpecimen label={scale.label}>
+      <ShapeMorph shape={shape} barHeights={heights} paused={paused} {...geometry(scale.factor)} />
+    </DesignSpecimen>
+  );
+}
+
+function Loop() {
+  const [from, setFrom] = useState<PickableShape>("orbit");
+  const [to, setTo] = useState<PickableShape>("bars");
+  const shape = useLoopTarget(from, to);
+  return (
+    <DesignPage>
+      <DesignSection
+        title="Auto loop"
+        description={`Morphs ${from} → ${to} and back over ${SHAPE_MORPH_DURATION_MS}ms, holding each. Animated shapes keep moving through the morph, and bars track live heights.`}
+      >
+        <ShapePickers from={from} to={to} onFrom={setFrom} onTo={setTo} />
+        <Text style={styles.status}>Target: {shape}</Text>
+        <DesignRow>
+          {SCALES.map((scale) => (
+            <LoopSpecimen key={scale.label} scale={scale} shape={shape} />
+          ))}
+        </DesignRow>
+      </DesignSection>
+    </DesignPage>
+  );
+}
+
+function ReducedMotion() {
+  const shape = useLoopTarget("orbit", "bars");
+  return (
+    <DesignPage>
+      <DesignSection
+        title="Reduced motion"
+        description="With the OS setting on, there is no morph: the shape swaps on the same loop, and the orbit holds still at a fixed angle. A stopped clock takes the same path, which this state uses to show it."
+      >
+        <Text style={styles.status}>Target: {shape}</Text>
+        <DesignRow>
+          {SCALES.map((scale) => (
+            <LoopSpecimen key={scale.label} scale={scale} shape={shape} paused />
+          ))}
+        </DesignRow>
+      </DesignSection>
+    </DesignPage>
+  );
+}
+
+function PresetSpecimen({ shape, factor }: { shape: ShapeName; factor: number }) {
+  const heights = useSpeakingHeights(factor);
+  return (
+    <DesignSpecimen label={shape === "lineup" ? "lineup (keyframe)" : shape}>
+      <ShapeMorph shape={shape} barHeights={heights} {...geometry(factor)} />
+    </DesignSpecimen>
+  );
+}
+
+function Presets() {
+  return (
+    <DesignPage>
+      {SCALES.map((scale) => (
+        <DesignSection
+          key={scale.label}
+          title={`Presets · ${scale.label}`}
+          description="Each preset live. lineup is the keyframe between orbit and bars."
+        >
+          <DesignRow>
+            {ALL_SHAPES.map((shape) => (
+              <PresetSpecimen key={shape} shape={shape} factor={scale.factor} />
+            ))}
+          </DesignRow>
+        </DesignSection>
+      ))}
+    </DesignPage>
+  );
+}
+
+const design: DesignDefinition = {
+  title: "Shape morph",
+  states: [
+    { id: "scrub", label: "Scrub (orbit → bars)", render: Scrub },
+    { id: "loop", label: "Auto loop", render: Loop },
+    { id: "reduced-motion", label: "Reduced motion", render: ReducedMotion },
+    { id: "presets", label: "Presets", render: Presets },
+  ],
+};
+
+export default design;
+
+const styles = StyleSheet.create((theme) => ({
+  controls: {
+    gap: theme.spacing[3],
+  },
+  control: {
+    gap: theme.spacing[1.5],
+    alignItems: "flex-start",
+  },
+  controlLabel: {
+    color: theme.colors.foregroundMuted,
+    fontSize: theme.fontSize.sm,
+  },
+  status: {
+    color: theme.colors.foregroundMuted,
+    fontSize: theme.fontSize.sm,
+    fontFamily: theme.fontFamily.mono,
+  },
+  track: {
+    width: theme.spacing[32] * 2,
+    height: theme.spacing[4],
+    borderRadius: theme.borderRadius.full,
+    backgroundColor: theme.colors.surface3,
+    overflow: "hidden",
+  },
+  trackFill: (value: number) => ({
+    width: `${value * 100}%`,
+    height: "100%",
+    backgroundColor: theme.colors.accent,
+  }),
+  stops: {
+    flexDirection: "row",
+    gap: theme.spacing[1],
+  },
+}));
