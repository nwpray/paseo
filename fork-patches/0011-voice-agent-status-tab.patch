+      }),
+    );
+    return;
+  }
+  const isRising = from === "hidden";
+  const isCompacting = !isRising && to === "compact";
+  const shapeTiming = withTiming(expandedProgress(to), {
+    duration: SHAPE_MS,
+    easing: SETTLE_EASING,
+  });
+  shape.value = isCompacting ? withDelay(COMPACT_DELAY_MS, shapeTiming) : shapeTiming;
+  if (isRising) {
+    sink.value = withTiming(SINK[to], { duration: RISE_MS, easing: RISE_EASING });
+    reserve.value = withTiming(VISIBLE_HEIGHT, { duration: RISE_MS, easing: SETTLE_EASING });
+  } else {
+    const sinkTiming = withTiming(SINK[to], { duration: SHAPE_MS, easing: SETTLE_EASING });
+    sink.value = isCompacting ? withDelay(COMPACT_DELAY_MS, sinkTiming) : sinkTiming;
+  }
