+      transform: [
+        { translateX: snapToDevicePixels(CANVAS_WIDTH / 2 - width / 2 + inset, scale) },
+        { translateY: BORDER + mix(PAD_COMPACT, PAD_TOP, shape.value) },
+      ],
+    };
+  });
+  const labelStyle = useAnimatedStyle(() => ({ opacity: labelOpacity.value }));
+  const outlineProps = useAnimatedProps(() => {
+    const width = bodyWidth({
+      shape: shape.value,
+      leadingWidth: leadingWidth.value,
+      rowWidth: rowWidth.value,
+    });
+    return { d: buildOutline(width, mix(COMPACT_FLARE_RADIUS, FLARE_RADIUS, shape.value)) };
+  });
+
+  // Reanimated owns every animated node here, so they take plain styles only.
+  const sizing = fill ? styles.fill : styles.shrink;
+  return (
+    <View style={sizing}>
+      <Animated.View style={reserveStyle} />
+      <View style={sizing}>
+        {isTabMounted ? (
+          <View {...accessibility} aria-hidden={state === "hidden"} style={styles.tabRow}>
+            <Animated.View style={[styles.tab, tabStyle]}>
+              <View style={styles.outline}>
+                <ThemedSvg
+                  width={CANVAS_WIDTH}
+                  height={TAB_HEIGHT}
+                  strokeWidth={BORDER}
+                  uniProps={outlineColors}
+                >
+                  <AnimatedPath animatedProps={outlineProps} />
+                </ThemedSvg>
+              </View>
+              <Animated.View style={[styles.content, contentStyle]} onLayout={handleRowLayout}>
+                <View onLayout={handleLeadingLayout}>{leading}</View>
+                {label ? (
+                  <Animated.View style={[styles.label, labelStyle]}>{label}</Animated.View>
+                ) : null}
+              </Animated.View>
+            </Animated.View>
+          </View>
+        ) : null}
+        {children}
+      </View>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  shrink: { flexShrink: 1, minHeight: 0 },
+  fill: { flex: 1, minHeight: 0 },
+  // The row spans from the tab's top to TUCK below the panel's top edge and clips there,
+  // so a sunk tab never shows under a panel shorter than the tab. It is wider than the
+  // panel on both sides so the clip never cuts a flare.
+  tabRow: {
+    position: "absolute",
+    top: -VISIBLE_HEIGHT,
+    left: -CANVAS_WIDTH / 2,
+    right: -CANVAS_WIDTH / 2,
+    height: TAB_HEIGHT,
+    alignItems: "center",
+    overflow: "hidden",
+    pointerEvents: "none",
+  },
+  tab: {
+    width: CANVAS_WIDTH,
+    height: TAB_HEIGHT,
+  },
+  outline: {
+    position: "absolute",
+    top: 0,
+    left: 0,
+  },
+  content: {
+    position: "absolute",
+    top: 0,
+    left: 0,
+    height: CONTENT_HEIGHT,
+    maxWidth: MAX_BODY_WIDTH - 2 * BORDER - PAD_START - PAD_END,
+    flexDirection: "row",
+    alignItems: "center",
+    gap: GAP,
+  },
+  label: {
+    flexShrink: 1,
+    minWidth: 0,
+  },
+});
