+    `L${f(left)} ${f(half + corner)}`,
+    `A${f(corner)} ${f(corner)} 0 0 1 ${f(left + corner)} ${f(half)}`,
+    `L${f(right - corner)} ${f(half)}`,
+    `A${f(corner)} ${f(corner)} 0 0 1 ${f(right)} ${f(half + corner)}`,
+    `L${f(right)} ${f(shoulder)}`,
+    `A${f(flare)} ${f(flare)} 0 0 0 ${f(right + flare)} ${f(foot)}`,
+    `L${f(right + flare)} ${TAB_HEIGHT}`,
