+  if (!input.via) return tweenOutlines(input.from, input.to, input.plan.first, ease(p), opacity);
+  if (p < 0.5) {
+    const first = tweenOutlines(input.from, input.via, input.plan.first, ease(p * 2), 0);
+    return withOpacities(first, input.from, input.to, input.plan, opacity);
+  }
+  const second = tweenOutlines(input.via, input.to, input.plan.second, ease(p * 2 - 1), 1);
+  return withOpacities(second, input.from, input.to, input.plan, opacity);
