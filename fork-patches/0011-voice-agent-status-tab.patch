--- /dev/null
+++ b/packages/app/src/components/ui/shape-morph/index.tsx
@@ -0,0 +1,66 @@
+import { useMemo } from "react";
+import { Canvas, Path, usePathValue } from "@shopify/react-native-skia";
+import { useDerivedValue, type SharedValue } from "react-native-reanimated";
+import { withUnistyles } from "react-native-unistyles";
+import type { Theme } from "@/styles/theme";
+import { SHAPE_OUTLINES, type Outline } from "./shapes";
+import { useShapeMorphFrame, type ShapeMorphProps } from "./use-shape-morph";
+
+export type { ShapeMorphProps } from "./use-shape-morph";
+
+// Native draws the morph with Skia: one Path per outline, rebuilt on the UI thread from the
+// shared frame. Web and Electron use index.web.tsx, an SVG, so CanvasKit never loads there.
+
+const SLOTS = Array.from({ length: SHAPE_OUTLINES }, (_, k) => k);
+
+function MorphPath({
+  frame,
+  index,
+  color,
+}: {
+  frame: SharedValue<Outline[]>;
+  index: number;
+  color: string;
+}) {
+  const path = usePathValue((builder) => {
+    "worklet";
+    const points = frame.value[index].points;
+    builder.moveTo(points[0], points[1]);
+    for (let i = 2; i < points.length; i += 2) builder.lineTo(points[i], points[i + 1]);
+    builder.close();
+  });
+  const opacity = useDerivedValue(() => frame.value[index].opacity);
+  return <Path path={path} color={color} opacity={opacity} />;
+}
+
+interface MorphCanvasProps {
+  frame: SharedValue<Outline[]>;
+  width: number;
+  height: number;
+  color: string;
+}
+
+function MorphCanvas({ frame, width, height, color }: MorphCanvasProps) {
+  const style = useMemo(() => ({ width, height }), [width, height]);
+  return (
+    <Canvas style={style}>
+      {SLOTS.map((k) => (
+        <MorphPath key={k} frame={frame} index={k} color={color} />
+      ))}
+    </Canvas>
+  );
+}
+
+// Only the color is themed, so only this wrapper re-renders on a theme change.
+const ThemedMorphCanvas = withUnistyles(MorphCanvas);
+function fillColor(theme: Theme) {
+  return { color: theme.colors.foreground };
+}
+
+/** Morphs between shapes from `./shapes`. See ShapeMorphProps for the API. */
+export function ShapeMorph(props: ShapeMorphProps) {
+  const frame = useShapeMorphFrame(props);
+  const { width, height, color } = props;
+  if (color) return <MorphCanvas frame={frame} width={width} height={height} color={color} />;
+  return <ThemedMorphCanvas frame={frame} width={width} height={height} uniProps={fillColor} />;
+}
diff --git a/packages/app/src/components/ui/shape-morph/index.web.tsx b/packages/app/src/components/ui/shape-morph/index.web.tsx
