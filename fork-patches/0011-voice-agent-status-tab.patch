+/**
+ * A provider's name for people, before the host's snapshot has loaded too: the snapshot's
+ * label, then the built-in or catalog name, then the raw id.
+ */
+export function resolveProviderDisplayName(
+  provider: string,
+  snapshotEntries: ProviderSnapshotEntry[] | undefined,
+): string {
+  return (
+    snapshotEntries?.find((entry) => entry.provider === provider)?.label ??
+    AGENT_PROVIDER_DEFINITIONS.find((definition) => definition.id === provider)?.label ??
+    ACP_PROVIDER_CATALOG.find((entry) => entry.id === provider)?.title ??
+    provider
+  );
+}
