+/** Resamples a closed polygon to `count` points evenly spaced by arc length, from point 0. */
+function resample(points: number[], count: number): number[] {
+  "worklet";
+  const n = points.length / 2;
+  if (n === count) return points;
+  if (n === 0) return emptyOutline(0, 0).points;
+  const lengths: number[] = [0];
+  for (let i = 0; i < n; i += 1) {
+    const j = (i + 1) % n;
+    const seg = Math.hypot(points[2 * j] - points[2 * i], points[2 * j + 1] - points[2 * i + 1]);
+    lengths.push(lengths[i] + seg);
+  }
+  const total = lengths[n];
+  const out: number[] = [];
+  let seg = 0;
+  for (let k = 0; k < count; k += 1) {
+    const at = (total * k) / count;
+    while (seg < n - 1 && lengths[seg + 1] < at) seg += 1;
+    const span = lengths[seg + 1] - lengths[seg];
+    const u = span > EPSILON ? (at - lengths[seg]) / span : 0;
+    const j = (seg + 1) % n;
+    out.push(
+      points[2 * seg] + (points[2 * j] - points[2 * seg]) * u,
+      points[2 * seg + 1] + (points[2 * j + 1] - points[2 * seg + 1]) * u,
