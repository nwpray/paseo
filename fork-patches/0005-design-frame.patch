+import type { ReactElement } from "react";
+
+/** One named state of a design. `render` draws it with real app components. */
+export interface DesignState {
+  id: string;
+  label: string;
+  render: () => ReactElement;
+}
+
+/** A design file's default export. */
+export interface DesignDefinition {
+  title: string;
+  states: readonly DesignState[];
+}
+
+export type DesignDevice = "phone" | "tablet" | "desktop";
+export type DesignDeviceSelection = DesignDevice | "all";
+export type DesignZoom = "fit" | "100";
