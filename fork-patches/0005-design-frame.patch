+import type { ReactNode } from "react";
+import { ScrollView, Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+
+// Layout pieces for composing design states. They only arrange real app
+// components; they are not app UI and nothing outside src/design uses them.
+
+/** A scrolling page on the app's base surface, with page padding. */
+export function DesignPage({ children }: { children: ReactNode }) {
+  return (
+    <View style={styles.page}>
+      <ScrollView style={styles.scroll} contentContainerStyle={styles.pageContent}>
+        {children}
+      </ScrollView>
+    </View>
+  );
+}
+
+/** A titled group of examples. */
+export function DesignSection({
+  title,
+  description,
+  children,
+}: {
+  title: string;
+  description?: string;
+  children: ReactNode;
+}) {
+  return (
+    <View style={styles.section}>
+      <Text style={styles.sectionTitle}>{title}</Text>
+      {description ? <Text style={styles.sectionDescription}>{description}</Text> : null}
+      <View style={styles.sectionBody}>{children}</View>
+    </View>
+  );
+}
+
+/** A wrapping row of examples. */
+export function DesignRow({ children }: { children: ReactNode }) {
