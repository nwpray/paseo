+import { createElement, useCallback, useMemo, useState } from "react";
+import { View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import type { ThemePreference } from "@/styles/theme";
+import type { DesignDefinition, DesignDevice } from "@/design/types";
+import { DesignFrameContextProvider } from "@/design/frame/context";
+import type { DesignFrameMessage } from "@/design/frame/messages";
+import { DesignThemeGate } from "@/design/frame/theme-gate";
+import { useDesignFrameMessages } from "@/design/frame/use-frame-messages";
+
+/** The inside of one device iframe: the selected state, full-bleed, no review chrome. */
+export function DesignDeviceFrame({
+  design,
+  device,
+  initialState,
+  initialTheme,
+}: {
+  design: DesignDefinition;
+  device: DesignDevice;
+  initialState: string | null;
+  initialTheme: ThemePreference;
+}) {
+  const [stateId, setStateId] = useState(initialState);
+  const [theme, setTheme] = useState(initialTheme);
+  const handleMessage = useCallback((message: DesignFrameMessage) => {
+    setStateId(message.state);
+    setTheme(message.theme);
+  }, []);
+  useDesignFrameMessages(handleMessage);
+
+  const state = design.states.find((candidate) => candidate.id === stateId) ?? design.states[0];
+  const context = useMemo(() => ({ device, theme }), [device, theme]);
+
+  return (
+    <DesignThemeGate theme={theme} device={device} remount>
+      <DesignFrameContextProvider value={context}>
+        <View style={styles.root} testID="design-device-frame">
+          {state ? createElement(state.render, { key: state.id }) : null}
+        </View>
+      </DesignFrameContextProvider>
+    </DesignThemeGate>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  root: {
+    flex: 1,
+    backgroundColor: theme.colors.surface0,
+  },
+}));
