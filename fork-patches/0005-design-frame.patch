@@ -0,0 +1,15 @@
+import { useEffect } from "react";
+import { parseDesignFrameMessage, type DesignFrameMessage } from "@/design/frame/messages";
+
+/** Inside a device iframe: receive state and theme changes from the review page. */
+export function useDesignFrameMessages(onMessage: (message: DesignFrameMessage) => void): void {
+  useEffect(() => {
+    function handleMessage(event: MessageEvent) {
+      if (event.origin !== window.location.origin) return;
+      const message = parseDesignFrameMessage(event.data);
+      if (message) onMessage(message);
+    }
+    window.addEventListener("message", handleMessage);
+    return () => window.removeEventListener("message", handleMessage);
+  }, [onMessage]);
+}
