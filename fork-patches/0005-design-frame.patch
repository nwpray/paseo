@@ -0,0 +1,100 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import { inlineUnistylesStyle } from "@/styles/unistyles-inline-style";
+import type { ThemePreference } from "@/styles/theme";
+import type { DesignDevice } from "@/design/types";
+import { createDesignFrameMessage } from "@/design/frame/messages";
+import { buildDeviceFrameUrl, DESIGN_DEVICES } from "@/design/frame/params";
+
+export interface DeviceViewportProps {
+  name: string;
+  device: DesignDevice;
+  state: string;
+  theme: ThemePreference;
+  scale: number;
+}
+
+/**
+ * One device preview: an iframe of the same design route at the device's real width,
+ * so Unistyles breakpoints and `useIsCompactFormFactor()` resolve as they would on
+ * that device. The src is fixed at mount; later state and theme changes arrive by
+ * postMessage so the preview does not reload.
+ */
+export function DeviceViewport({ name, device, state, theme, scale }: DeviceViewportProps) {
+  const iframeRef = useRef<HTMLIFrameElement>(null);
+  const [src] = useState(() => buildDeviceFrameUrl({ name, device, state, theme }));
+  const size = DESIGN_DEVICES[device];
+
+  const post = useCallback(() => {
+    iframeRef.current?.contentWindow?.postMessage(
+      createDesignFrameMessage(state, theme),
+      window.location.origin,
+    );
+  }, [state, theme]);
+
+  useEffect(() => {
+    post();
+  }, [post]);
+
+  const iframeStyle = useMemo(
+    () => ({
+      width: size.width,
+      height: size.height,
+      border: 0,
+      display: "block",
+      // The clip box is a flex column at the scaled height; without this the iframe
+      // shrinks to it and the preview gets a shorter viewport than the device.
+      flexShrink: 0,
+      transform: `scale(${scale})`,
+      transformOrigin: "0 0",
+    }),
+    [scale, size.height, size.width],
+  );
+
+  return (
+    <View style={styles.viewport} testID={`design-viewport-${device}`}>
+      <Text style={styles.label}>
+        {size.label} · {size.width} × {size.height}
+      </Text>
+      <View style={styles.screenBorder}>
+        <View
+          style={[
+            styles.screen,
+            inlineUnistylesStyle({ width: size.width * scale, height: size.height * scale }),
+          ]}
+        >
+          {/* oxlint-disable-next-line react/iframe-missing-sandbox -- the preview is this
+              app on this origin; a sandbox would block its storage and postMessage origin. */}
+          <iframe
+            ref={iframeRef}
+            src={src}
+            title={`${name} on ${size.label}`}
+            style={iframeStyle}
+            onLoad={post}
+          />
+        </View>
+      </View>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  viewport: {
+    gap: theme.spacing[2],
+    alignItems: "flex-start",
+  },
+  label: {
+    color: theme.colors.foregroundMuted,
+    fontSize: theme.fontSize.sm,
+  },
+  screenBorder: {
+    overflow: "hidden",
+    borderWidth: theme.borderWidth[1],
+    borderColor: theme.colors.border,
+    borderRadius: theme.borderRadius.lg,
+  },
+  screen: {
+    overflow: "hidden",
+  },
+}));
