@@ -0,0 +1,171 @@
+// Design-file rules for `npm run design:check` and the design frame's Check button.
+// Plain TypeScript with no imports so Node can load it directly (type stripping).
+
+export type DesignCheckRule =
+  | "raw-color"
+  | "palette"
+  | "style-literal"
+  | "icon-size-literal"
+  | "use-unistyles";
+
+export interface DesignCheckFinding {
+  rule: DesignCheckRule;
+  line: number;
+  column: number;
+  message: string;
+  excerpt: string;
+}
+
+const IGNORE_NEXT_LINE = "design-check-ignore-next-line";
+
+// Style keys whose numbers must come from theme tokens (spacing, fontSize,
+// lineHeight, fontWeight, borderRadius, borderWidth). `0` is allowed.
+const TOKEN_STYLE_KEYS = [
+  "padding",
+  "paddingTop",
+  "paddingBottom",
+  "paddingLeft",
+  "paddingRight",
+  "paddingHorizontal",
+  "paddingVertical",
+  "paddingStart",
+  "paddingEnd",
+  "margin",
+  "marginTop",
+  "marginBottom",
+  "marginLeft",
+  "marginRight",
+  "marginHorizontal",
+  "marginVertical",
+  "marginStart",
+  "marginEnd",
+  "gap",
+  "rowGap",
+  "columnGap",
+  "fontSize",
+  "lineHeight",
+  "fontWeight",
+  "borderRadius",
+  "borderTopLeftRadius",
+  "borderTopRightRadius",
+  "borderBottomLeftRadius",
+  "borderBottomRightRadius",
+  "borderWidth",
+  "borderTopWidth",
+  "borderBottomWidth",
+  "borderLeftWidth",
+  "borderRightWidth",
+];
+
+interface Matcher {
+  rule: DesignCheckRule;
+  pattern: RegExp;
+  message: (match: RegExpExecArray) => string;
+}
+
+const MATCHERS: Matcher[] = [
+  {
+    rule: "raw-color",
+    pattern: /["'`]#[0-9a-fA-F]{3,8}["'`]/g,
+    message: (m) => `Raw hex color ${m[0]}. Use a theme.colors token.`,
+  },
+  {
+    rule: "raw-color",
+    pattern: /\b(?:rgba?|hsla?)\s*\(/g,
+    message: (m) => `Raw ${m[0].replace(/\s*\($/, "")}() color. Use a theme.colors token.`,
+  },
+  {
+    rule: "palette",
+    pattern: /\bpalette\s*(?:\.|\[)/g,
+    message: () => "palette.* is the raw scale. Use a semantic theme.colors token.",
+  },
+  {
+    rule: "style-literal",
+    pattern: new RegExp(
+      `\\b(${TOKEN_STYLE_KEYS.join("|")})\\s*:\\s*["']?(-?(?:[1-9]\\d*|0?\\.\\d+)(?:\\.\\d+)?)["']?`,
+      "g",
+    ),
+    message: (m) => `${m[1]}: ${m[2]} is a literal. Use the theme token (spacing, fontSize, ...).`,
+  },
+  {
+    rule: "icon-size-literal",
+    pattern: /\bsize=\{\s*-?\d+(?:\.\d+)?\s*\}/g,
+    message: (m) => `${m[0]} is a literal icon size. Use theme.iconSize / ICON_SIZE.`,
+  },
+  {
+    rule: "use-unistyles",
+    pattern: /\buseUnistyles\b/g,
+    message: () => "useUnistyles() is banned (docs/unistyles.md). Use StyleSheet.create.",
+  },
+];
+
+/** Blank out comments while keeping line and column positions stable. */
+function maskComments(source: string): string {
+  let out = "";
+  let i = 0;
+  let quote: string | null = null;
+  while (i < source.length) {
+    const char = source[i];
+    const next = source[i + 1];
+    if (quote) {
+      out += char;
+      if (char === "\\") {
+        out += next ?? "";
+        i += 2;
+        continue;
+      }
+      if (char === quote) quote = null;
+      i += 1;
+      continue;
+    }
+    if (char === '"' || char === "'" || char === "`") {
+      quote = char;
+      out += char;
+      i += 1;
+      continue;
+    }
+    if (char === "/" && next === "/") {
+      while (i < source.length && source[i] !== "\n") {
+        out += " ";
+        i += 1;
+      }
+      continue;
+    }
+    if (char === "/" && next === "*") {
+      while (i < source.length && !(source[i] === "*" && source[i + 1] === "/")) {
+        out += source[i] === "\n" ? "\n" : " ";
+        i += 1;
+      }
+      out += "  ";
+      i += 2;
+      continue;
+    }
+    out += char;
+    i += 1;
+  }
+  return out;
+}
+
+export function checkDesignSource(source: string): DesignCheckFinding[] {
+  const rawLines = source.split("\n");
+  const lines = maskComments(source).split("\n");
+  const findings: DesignCheckFinding[] = [];
+  lines.forEach((line, index) => {
+    if (index > 0 && rawLines[index - 1]?.includes(IGNORE_NEXT_LINE)) return;
+    for (const matcher of MATCHERS) {
+      matcher.pattern.lastIndex = 0;
+      let match = matcher.pattern.exec(line);
+      while (match) {
+        findings.push({
+          rule: matcher.rule,
+          line: index + 1,
+          column: match.index + 1,
+          message: matcher.message(match),
+          excerpt: (rawLines[index] ?? "").trim(),
+        });
+        match = matcher.pattern.exec(line);
+      }
+    }
+  });
+  return findings.sort((a, b) => a.line - b.line || a.column - b.column);
+}
