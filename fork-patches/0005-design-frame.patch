new file mode 100644
index 000000000..9ead3dac3
--- /dev/null
+++ b/packages/app/src/design/frame/quiet-known-warnings.web.ts
@@ -0,0 +1,23 @@
+let installed = false;
+
+/**
+ * Unistyles web forwards `uniProps` to the wrapped lucide SVG, so every themed icon
+ * logs "React does not recognize the `uniProps` prop" in web dev builds, app-wide.
+ * Expo's error toast for it would sit on top of every device preview. Drop only that
+ * message, only in the design frame.
+ */
+export function quietKnownWebWarnings(): void {
+  if (installed) return;
+  installed = true;
+  const forward = console.error;
+  console.error = (...args: unknown[]) => {
+    if (
+      typeof args[0] === "string" &&
+      args[0].startsWith("React does not recognize the") &&
+      args[1] === "uniProps"
+    ) {
+      return;
+    }
+    forward(...args);
+  };
+}
