+#!/usr/bin/env bash
+# Design frame: Expo web with the dev-only /design routes and no daemon.
+# See docs/design-frame.md. DESIGN_PORT overrides the default port.
+set -e
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
+export PATH="$ROOT_DIR/node_modules/.bin:$PATH"
+
+DESIGN_PORT="${DESIGN_PORT:-8095}"
+
+echo "Design frame: http://localhost:${DESIGN_PORT}/design"
+
+exec cross-env \
+  BROWSER="${BROWSER:-none}" \
+  APP_VARIANT=development \
+  EXPO_PUBLIC_PASEO_DESIGN_FRAME=1 \
+  npm run web:expo --workspace=@getpaseo/app -- --port "$DESIGN_PORT"
