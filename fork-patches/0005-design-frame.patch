+import { useCallback } from "react";
+import { Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import { Button } from "@/components/ui/button";
+import { DropdownMenu, DropdownMenuContent, DropdownMenuItem } from "@/components/ui/dropdown-menu";
+import { DropdownTrigger } from "@/components/ui/dropdown-trigger";
+import { SegmentedControl, type SegmentedControlOption } from "@/components/ui/segmented-control";
+import type { ThemePreference } from "@/styles/theme";
+import type { DesignDeviceSelection, DesignState, DesignZoom } from "@/design/types";
+import { DESIGN_THEME_PREFERENCES } from "@/design/frame/params";
+
+const DEVICE_OPTIONS: SegmentedControlOption<DesignDeviceSelection>[] = [
+  { value: "phone", label: "Phone", testID: "design-device-phone" },
+  { value: "tablet", label: "Tablet", testID: "design-device-tablet" },
+  { value: "desktop", label: "Desktop", testID: "design-device-desktop" },
+  { value: "all", label: "All", testID: "design-device-all" },
+];
+
+const ZOOM_OPTIONS: SegmentedControlOption<DesignZoom>[] = [
+  { value: "fit", label: "Fit" },
+  { value: "100", label: "100%" },
+];
+
+const THEME_LABELS: Record<Exclude<ThemePreference, "plugin">, string> = {
+  light: "Light",
+  dark: "Dark",
+  auto: "Auto (system)",
+  zinc: "Zinc",
+  midnight: "Midnight",
+  claude: "Claude",
+  ghostty: "Ghostty",
+  pureBlack: "Pure black",
+};
+
+export interface ReviewBarProps {
+  title: string;
+  states: readonly DesignState[];
+  stateId: string;
+  device: DesignDeviceSelection;
+  zoom: DesignZoom;
+  theme: Exclude<ThemePreference, "plugin">;
+  checkRunning: boolean;
+  onStateChange: (stateId: string) => void;
+  onDeviceChange: (device: DesignDeviceSelection) => void;
+  onZoomChange: (zoom: DesignZoom) => void;
+  onThemeChange: (theme: Exclude<ThemePreference, "plugin">) => void;
+  onCheck: () => void;
+  onBack: () => void;
+}
+
+export function DesignReviewBar(props: ReviewBarProps) {
+  const activeState = props.states.find((state) => state.id === props.stateId);
+  return (
+    <View style={styles.bar} testID="design-review-bar">
+      <View style={styles.group}>
+        <Button variant="ghost" size="sm" onPress={props.onBack}>
+          Designs
+        </Button>
+        <Text style={styles.title} numberOfLines={1}>
+          {props.title}
+        </Text>
+      </View>
+      <View style={styles.group}>
+        <BarLabel label="State" />
+        <DropdownMenu>
+          <DropdownTrigger size="sm" accessibilityRole="button" testID="design-state-trigger">
+            {activeState?.label ?? props.stateId}
+          </DropdownTrigger>
+          <DropdownMenuContent side="bottom" align="start" width={220}>
+            {props.states.map((state) => (
+              <OptionItem
+                key={state.id}
+                value={state.id}
+                label={state.label}
+                selected={state.id === props.stateId}
+                onSelect={props.onStateChange}
+              />
+            ))}
+          </DropdownMenuContent>
+        </DropdownMenu>
+      </View>
+      <View style={styles.group}>
+        <BarLabel label="Device" />
+        <SegmentedControl
+          size="sm"
+          options={DEVICE_OPTIONS}
+          value={props.device}
+          onValueChange={props.onDeviceChange}
+        />
+      </View>
+      <View style={styles.group}>
+        <BarLabel label="Zoom" />
+        <SegmentedControl
+          size="sm"
+          options={ZOOM_OPTIONS}
+          value={props.zoom}
+          onValueChange={props.onZoomChange}
+        />
+      </View>
+      <View style={styles.group}>
+        <BarLabel label="Theme" />
+        <DropdownMenu>
+          <DropdownTrigger size="sm" accessibilityRole="button" testID="design-theme-trigger">
+            {THEME_LABELS[props.theme]}
+          </DropdownTrigger>
+          <DropdownMenuContent side="bottom" align="start" width={200}>
+            {DESIGN_THEME_PREFERENCES.map((theme) => (
+              <OptionItem
+                key={theme}
+                value={theme}
+                label={THEME_LABELS[theme]}
+                selected={theme === props.theme}
+                onSelect={props.onThemeChange}
+              />
+            ))}
+          </DropdownMenuContent>
+        </DropdownMenu>
+      </View>
+      <Button
+        variant="outline"
+        size="sm"
+        loading={props.checkRunning}
+        onPress={props.onCheck}
+        testID="design-check-button"
+      >
+        Check
+      </Button>
+    </View>
+  );
+}
+
+function BarLabel({ label }: { label: string }) {
+  return <Text style={styles.label}>{label}</Text>;
+}
+
+function OptionItem<T extends string>({
+  value,
+  label,
+  selected,
+  onSelect,
+}: {
+  value: T;
+  label: string;
+  selected: boolean;
+  onSelect: (value: T) => void;
+}) {
+  const handleSelect = useCallback(() => onSelect(value), [onSelect, value]);
+  return (
+    <DropdownMenuItem selected={selected} onSelect={handleSelect}>
+      {label}
+    </DropdownMenuItem>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  bar: {
+    flexDirection: "row",
+    flexWrap: "wrap",
+    alignItems: "center",
+    gap: theme.spacing[4],
+    paddingHorizontal: theme.spacing[4],
+    paddingVertical: theme.spacing[2],
+    backgroundColor: theme.colors.surfaceSidebar,
+    borderBottomWidth: theme.borderWidth[1],
+    borderBottomColor: theme.colors.border,
+  },
+  group: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[2],
+  },
+  title: {
+    color: theme.colors.foreground,
+    fontSize: theme.fontSize.base,
+    fontWeight: theme.fontWeight.medium,
+  },
