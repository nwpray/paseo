@@ -0,0 +1,71 @@
+import { THEME_OPTIONS, type ThemePreference } from "@/styles/theme";
+import type { DesignDevice, DesignDeviceSelection, DesignZoom } from "@/design/types";
+
+/** Viewport each device preview gets. Width drives the Unistyles breakpoint. */
+export const DESIGN_DEVICES: Record<
+  DesignDevice,
+  { label: string; width: number; height: number }
+> = {
+  phone: { label: "Phone", width: 375, height: 812 },
+  tablet: { label: "Tablet", width: 768, height: 1024 },
+  desktop: { label: "Desktop", width: 1280, height: 800 },
+};
+
+export const DESIGN_DEVICE_ORDER: readonly DesignDevice[] = ["phone", "tablet", "desktop"];
+
+export const DESIGN_THEME_PREFERENCES: readonly Exclude<ThemePreference, "plugin">[] =
+  THEME_OPTIONS.map((option) => option.name);
+
+const DEFAULT_THEME: Exclude<ThemePreference, "plugin"> = "dark";
+
+/** Query params shared by the review page and each device iframe. */
+export interface DesignFrameParams {
+  state: string | null;
+  device: DesignDeviceSelection;
+  zoom: DesignZoom;
+  theme: Exclude<ThemePreference, "plugin">;
+  /** `device` when this page is the inside of a device iframe. */
+  frame: "device" | null;
+}
+
+type RawParam = string | string[] | undefined;
+
+function first(value: RawParam): string | undefined {
+  return Array.isArray(value) ? value[0] : value;
+}
+
+export function parseDesignFrameParams(raw: Record<string, RawParam>): DesignFrameParams {
+  const device = first(raw.device);
+  const zoom = first(raw.zoom);
+  const theme = first(raw.theme);
+  return {
+    state: first(raw.state) ?? null,
+    device: isDeviceSelection(device) ? device : "phone",
+    zoom: zoom === "100" ? "100" : "fit",
+    theme: isThemePreference(theme) ? theme : DEFAULT_THEME,
+    frame: first(raw.frame) === "device" ? "device" : null,
+  };
+}
+
+export function isDeviceSelection(value: unknown): value is DesignDeviceSelection {
+  return value === "all" || value === "phone" || value === "tablet" || value === "desktop";
+}
+
+export function isThemePreference(value: unknown): value is Exclude<ThemePreference, "plugin"> {
+  return DESIGN_THEME_PREFERENCES.some((name) => name === value);
+}
+
+export function buildDeviceFrameUrl(input: {
+  name: string;
+  device: DesignDevice;
+  state: string;
+  theme: ThemePreference;
+}): string {
+  const query = new URLSearchParams({
+    frame: "device",
+    device: input.device,
+    state: input.state,
+    theme: input.theme,
+  });
+  return `/design/${encodeURIComponent(input.name)}?${query.toString()}`;
+}
