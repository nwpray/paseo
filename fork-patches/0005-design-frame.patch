+import { applyAppearance } from "@/appearance/apply";
+import { applyTheme } from "@/appearance/provider";
+import { DEFAULT_CLIENT_SETTINGS, resolveContentMaxWidth } from "@/hooks/use-settings";
+import { defaultContentFontSize, defaultUiBaseFontSize } from "@/hooks/use-settings/storage";
+import type { ThemePreference } from "@/styles/theme";
+import type { DesignDevice } from "@/design/types";
+
+/**
+ * Apply a theme through the app's own appearance path, with fresh-install appearance
+ * defaults. Phone and tablet previews take the native defaults (15px interface, 16px
+ * content) so a phone frame on web reads like the phone app, not like desktop web.
+ */
+export function applyDesignTheme(theme: ThemePreference, device: DesignDevice | null): void {
+  applyTheme({ preference: theme, contributedTheme: null });
+  const native = device === "phone" || device === "tablet";
+  applyAppearance({
+    uiFontFamily: DEFAULT_CLIENT_SETTINGS.uiFontFamily,
+    monoFontFamily: DEFAULT_CLIENT_SETTINGS.monoFontFamily,
+    uiBaseFontSize: defaultUiBaseFontSize(native),
+    contentFontSize: defaultContentFontSize(native),
+    codeFontSize: DEFAULT_CLIENT_SETTINGS.codeFontSize,
+    contentMaxWidth: resolveContentMaxWidth(DEFAULT_CLIENT_SETTINGS),
+    syntaxTheme: DEFAULT_CLIENT_SETTINGS.syntaxTheme,
+  });
+}
