@@ -0,0 +1,28 @@
+import type { ThemePreference } from "@/styles/theme";
+import { isThemePreference } from "@/design/frame/params";
+
+/**
+ * The review page posts this to every device iframe when the state or theme changes.
+ * Each iframe is its own JS runtime with its own Unistyles, so it applies the theme
+ * itself through the same `applyTheme` path.
+ */
+export interface DesignFrameMessage {
+  source: "paseo-design-frame";
+  state: string;
+  theme: ThemePreference;
+}
+
+export function createDesignFrameMessage(
+  state: string,
+  theme: ThemePreference,
+): DesignFrameMessage {
+  return { source: "paseo-design-frame", state, theme };
+}
+
+export function parseDesignFrameMessage(data: unknown): DesignFrameMessage | null {
+  if (typeof data !== "object" || data === null) return null;
+  const record = data as Record<string, unknown>;
+  if (record.source !== "paseo-design-frame") return null;
+  if (typeof record.state !== "string" || !isThemePreference(record.theme)) return null;
+  return { source: "paseo-design-frame", state: record.state, theme: record.theme };
+}
