@@ -0,0 +1,154 @@
+import { useCallback, useMemo, useState } from "react";
+import { type LayoutChangeEvent, ScrollView, View } from "react-native";
+import { useRouter } from "expo-router";
+import { StyleSheet } from "react-native-unistyles";
+import { BORDER_WIDTH, SPACING, type ThemePreference } from "@/styles/theme";
+import type { DesignDefinition, DesignDeviceSelection, DesignZoom } from "@/design/types";
+import {
+  type DesignCheckStatus,
+  DesignCheckPanel,
+  runDesignCheck,
+} from "@/design/frame/check-panel";
+import { DeviceViewport } from "@/design/frame/device-viewport";
+import { DESIGN_DEVICE_ORDER, DESIGN_DEVICES, type DesignFrameParams } from "@/design/frame/params";
+import { DesignReviewBar } from "@/design/frame/review-bar";
+import { DesignThemeGate } from "@/design/frame/theme-gate";
+
+const PREVIEW_GAP = SPACING[8];
+const PREVIEW_PADDING = SPACING[6];
+// Room for the device caption above each viewport.
+const PREVIEW_CAPTION_ALLOWANCE = SPACING[8];
+const VIEWPORT_BORDER = BORDER_WIDTH[1];
+
+interface Size {
+  width: number;
+  height: number;
+}
+
+/** Scale that fits every visible device into the preview area, never above 100%. */
+export function resolveFitScale(devices: readonly (keyof typeof DESIGN_DEVICES)[], area: Size) {
+  const deviceWidth = devices.reduce((sum, device) => sum + DESIGN_DEVICES[device].width, 0);
+  const deviceHeight = Math.max(...devices.map((device) => DESIGN_DEVICES[device].height));
+  // Gaps, padding, captions and the 1px viewport borders do not scale.
+  const fixedWidth =
+    PREVIEW_GAP * Math.max(0, devices.length - 1) +
+    PREVIEW_PADDING * 2 +
+    devices.length * VIEWPORT_BORDER * 2;
+  const fixedHeight = PREVIEW_PADDING * 2 + PREVIEW_CAPTION_ALLOWANCE + VIEWPORT_BORDER * 2;
+  const availableWidth = area.width - fixedWidth;
+  const availableHeight = area.height - fixedHeight;
+  if (availableWidth <= 0 || availableHeight <= 0) return 1;
+  return Math.min(1, availableWidth / deviceWidth, availableHeight / deviceHeight);
+}
+
+export function DesignReviewPage({
+  name,
+  design,
+  params,
+}: {
+  name: string;
+  design: DesignDefinition;
+  params: DesignFrameParams;
+}) {
+  const router = useRouter();
+  const stateId = params.state ?? design.states[0]?.id ?? "";
+  const [area, setArea] = useState<Size | null>(null);
+  const [checkStatus, setCheckStatus] = useState<DesignCheckStatus>({ kind: "idle" });
+
+  const devices = useMemo(
+    () => (params.device === "all" ? DESIGN_DEVICE_ORDER : [params.device]),
+    [params.device],
+  );
+  const scale = params.zoom === "fit" && area ? resolveFitScale(devices, area) : 1;
+
+  const handleLayout = useCallback((event: LayoutChangeEvent) => {
+    const { width, height } = event.nativeEvent.layout;
+    setArea({ width, height });
+  }, []);
+  const setStateId = useCallback((state: string) => router.setParams({ state }), [router]);
+  const setDevice = useCallback(
+    (device: DesignDeviceSelection) => router.setParams({ device }),
+    [router],
+  );
+  const setZoom = useCallback((zoom: DesignZoom) => router.setParams({ zoom }), [router]);
+  const setTheme = useCallback(
+    (theme: Exclude<ThemePreference, "plugin">) => router.setParams({ theme }),
+    [router],
+  );
+  const goBack = useCallback(() => router.push("/design"), [router]);
+  const check = useCallback(() => {
+    setCheckStatus({ kind: "running" });
+    runDesignCheck(name)
+      .then((result) => setCheckStatus({ kind: "done", result }))
+      .catch((error: unknown) =>
+        setCheckStatus({
+          kind: "error",
+          message: error instanceof Error ? error.message : String(error),
+        }),
+      );
+  }, [name]);
+
+  const viewports = useMemo(
+    () =>
+      devices.map((device) => (
+        <DeviceViewport
+          key={device}
+          name={name}
+          device={device}
+          state={stateId}
+          theme={params.theme}
+          scale={scale}
+        />
+      )),
+    [devices, name, params.theme, scale, stateId],
+  );
+
+  return (
+    <DesignThemeGate theme={params.theme} device={null} remount={false}>
+      <View style={styles.root}>
+        <DesignReviewBar
+          title={design.title}
+          states={design.states}
+          stateId={stateId}
+          device={params.device}
+          zoom={params.zoom}
+          theme={params.theme}
+          checkRunning={checkStatus.kind === "running"}
+          onStateChange={setStateId}
+          onDeviceChange={setDevice}
+          onZoomChange={setZoom}
+          onThemeChange={setTheme}
+          onCheck={check}
+          onBack={goBack}
+        />
+        <DesignCheckPanel status={checkStatus} />
+        <View style={styles.previewArea} onLayout={handleLayout}>
+          <ScrollView style={styles.scroll}>
+            <ScrollView horizontal style={styles.scroll} contentContainerStyle={styles.previews}>
+              {area ? viewports : null}
+            </ScrollView>
+          </ScrollView>
+        </View>
+      </View>
+    </DesignThemeGate>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  root: {
+    flex: 1,
+    backgroundColor: theme.colors.surface1,
+  },
+  previewArea: {
+    flex: 1,
+  },
+  scroll: {
+    flex: 1,
+  },
+  previews: {
+    flexDirection: "row",
+    alignItems: "flex-start",
+    gap: PREVIEW_GAP,
+    padding: PREVIEW_PADDING,
+  },
+}));
