+import { useCallback } from "react";
+import { Text, View } from "react-native";
+import { useLocalSearchParams, useRouter } from "expo-router";
+import { StyleSheet } from "react-native-unistyles";
+import { Button } from "@/components/ui/button";
+import { settingsStyles } from "@/styles/settings";
+import { DESIGNS } from "@/design/registry";
+import { DesignDeviceFrame } from "@/design/frame/device-frame";
+import { parseDesignFrameParams } from "@/design/frame/params";
+import { DesignReviewPage } from "@/design/frame/review-page";
+import { DesignThemeGate } from "@/design/frame/theme-gate";
+import { quietKnownWebWarnings } from "@/design/frame/quiet-known-warnings";
+
+quietKnownWebWarnings();
+
+/** `/design/[name]`: the review page, or the inside of a device iframe. */
+export function DesignFrameScreen() {
+  const rawParams = useLocalSearchParams();
+  const name = typeof rawParams.name === "string" ? rawParams.name : "";
+  const params = parseDesignFrameParams(rawParams);
+  const design = DESIGNS[name];
+
+  if (!design) {
+    return <MissingDesign name={name} theme={params.theme} />;
+  }
+  if (params.frame === "device") {
+    return (
+      <DesignDeviceFrame
+        design={design}
+        device={params.device === "all" ? "desktop" : params.device}
+        initialState={params.state}
+        initialTheme={params.theme}
+      />
+    );
+  }
+  return <DesignReviewPage key={name} name={name} design={design} params={params} />;
+}
+
+/** `/design`: every registered design. */
+export function DesignIndexScreen() {
+  const params = parseDesignFrameParams(useLocalSearchParams());
+  return (
+    <DesignThemeGate theme={params.theme} device={null} remount={false}>
+      <View style={styles.page}>
+        <View style={styles.column}>
+          <Text style={styles.title}>Design frame</Text>
+          <View style={settingsStyles.card}>
+            {Object.entries(DESIGNS).map(([name, design], index) => (
+              <DesignRow
+                key={name}
+                name={name}
+                title={design.title}
+                stateCount={design.states.length}
+                first={index === 0}
+              />
+            ))}
+          </View>
+        </View>
+      </View>
+    </DesignThemeGate>
+  );
+}
+
+function DesignRow({
+  name,
+  title,
+  stateCount,
+  first,
+}: {
+  name: string;
+  title: string;
+  stateCount: number;
+  first: boolean;
+}) {
+  const router = useRouter();
+  const open = useCallback(() => router.push(`/design/${name}`), [name, router]);
+  return (
+    <View style={[settingsStyles.row, first ? null : settingsStyles.rowBorder]}>
+      <View style={settingsStyles.rowContent}>
+        <Text style={settingsStyles.rowTitle}>{title}</Text>
+        <Text style={settingsStyles.rowHint}>
+          {name} · {stateCount} state{stateCount === 1 ? "" : "s"}
+        </Text>
+      </View>
+      <Button variant="outline" size="sm" onPress={open} testID={`design-open-${name}`}>
+        Open
+      </Button>
+    </View>
+  );
+}
+
+function MissingDesign({
+  name,
+  theme,
+}: {
+  name: string;
+  theme: ReturnType<typeof parseDesignFrameParams>["theme"];
+}) {
+  return (
+    <DesignThemeGate theme={theme} device={null} remount={false}>
+      <View style={styles.page}>
+        <Text style={settingsStyles.rowHint}>{`No design named "${name}"`}</Text>
+      </View>
+    </DesignThemeGate>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  page: {
+    flex: 1,
+    alignItems: "center",
+    backgroundColor: theme.colors.surface0,
+    padding: theme.spacing[6],
+  },
+  column: {
+    width: "100%",
+    maxWidth: 720,
+    gap: theme.spacing[4],
+  },
+  title: {
+    color: theme.colors.foreground,
+    fontSize: theme.fontSize.lg,
+    fontWeight: theme.fontWeight.medium,
+  },
+}));
