+import { describe, expect, it } from "vitest";
+import { checkDesignSource } from "./rules";
+
+function rulesOf(source: string): string[] {
+  return checkDesignSource(source).map((finding) => finding.rule);
+}
+
+describe("checkDesignSource", () => {
+  it("accepts token-only styles", () => {
+    const source = [
+      "const styles = StyleSheet.create((theme) => ({",
+      "  row: { padding: theme.spacing[4], gap: 0, borderRadius: theme.borderRadius.lg },",
+      "  label: { fontSize: theme.fontSize.sm, color: theme.colors.foregroundMuted },",
+      "}));",
+      "<Icon size={ICON_SIZE.md} />",
+    ].join("\n");
+    expect(checkDesignSource(source)).toEqual([]);
+  });
+
+  it("flags raw hex, rgb and hsl colors", () => {
+    expect(rulesOf(`color: "#fff", bg: 'rgba(0, 0, 0, 0.5)', x: "hsl(0 0% 0%)"`)).toEqual([
+      "raw-color",
+      "raw-color",
+      "raw-color",
+    ]);
+  });
+
+  it("flags palette use", () => {
+    expect(rulesOf("color: theme.colors.palette.zinc[500]")).toEqual(["palette"]);
+  });
+
+  it("flags literal spacing, type and radius values with position", () => {
+    const findings = checkDesignSource(
+      "a\n  view: { padding: 12, fontSize: 14, borderRadius: 8, fontWeight: '500' },",
+    );
