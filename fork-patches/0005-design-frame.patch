@@ -0,0 +1,36 @@
+import { type ReactNode, useEffect, useState } from "react";
+import type { ThemePreference } from "@/styles/theme";
+import type { DesignDevice } from "@/design/types";
+import { applyDesignTheme } from "@/design/frame/apply-design-theme";
+
+/**
+ * Apply the theme before the first paint of the children, then on every change.
+ * With `remount`, children remount per theme: web bakes numeric tokens into classes,
+ * and the catalog reads token values at render. The review page does not remount,
+ * so its device iframes keep their runtime across theme changes.
+ */
+export function DesignThemeGate({
+  theme,
+  device,
+  remount,
+  children,
+}: {
+  theme: ThemePreference;
+  device: DesignDevice | null;
+  remount: boolean;
+  children: ReactNode;
+}) {
+  const [appliedTheme, setAppliedTheme] = useState<ThemePreference | null>(null);
+
+  useEffect(() => {
+    applyDesignTheme(theme, device);
+    setAppliedTheme(theme);
+  }, [device, theme]);
+
+  if (appliedTheme === null) return null;
+  return <ThemeKey key={remount ? appliedTheme : "stable"}>{children}</ThemeKey>;
+}
+
+function ThemeKey({ children }: { children: ReactNode }) {
+  return children;
+}
