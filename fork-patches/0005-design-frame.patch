+import type { DesignDefinition } from "@/design/types";
+
+// The catalog renders the live theme: every swatch, bar and sample is painted from
+// a StyleSheet.create((theme) => ...) factory, and the printed values are read from
+// the active Unistyles theme. The frame remounts this page on theme change.
+
+type Colors = Theme["colors"];
+type ColorToken = {
+  [Key in keyof Colors]: Colors[Key] extends string ? Key : never;
+}[keyof Colors];
+type SpacingToken = keyof typeof SPACING;
+type FontSizeToken = keyof Theme["fontSize"];
+type FontWeightToken = keyof typeof FONT_WEIGHT;
+type IconSizeToken = keyof typeof ICON_SIZE;
+type RadiusToken = keyof typeof BORDER_RADIUS;
+type BorderWidthToken = keyof typeof BORDER_WIDTH;
+type OpacityToken = keyof typeof OPACITY;
+type ShadowToken = keyof Theme["shadow"];
+type ControlSize = "xs" | "sm" | "md";
+
+// Token names are the same in every theme; values come from the active theme.
+const COLOR_TOKENS = (Object.keys(lightTheme.colors) as (keyof Colors)[]).filter(
+  (key): key is ColorToken => typeof lightTheme.colors[key] === "string",
+);
+const SPACING_TOKENS = (Object.keys(SPACING).map(Number) as SpacingToken[]).sort((a, b) => a - b);
+const FONT_SIZE_TOKENS = Object.keys(lightTheme.fontSize) as FontSizeToken[];
+const FONT_WEIGHT_TOKENS = Object.keys(FONT_WEIGHT) as FontWeightToken[];
+const ICON_SIZE_TOKENS = Object.keys(ICON_SIZE) as IconSizeToken[];
+const RADIUS_TOKENS = Object.keys(BORDER_RADIUS) as RadiusToken[];
+const BORDER_WIDTH_TOKENS = Object.keys(BORDER_WIDTH).map(Number) as BorderWidthToken[];
+const OPACITY_TOKENS = Object.keys(OPACITY).map(Number) as OpacityToken[];
+const SHADOW_TOKENS = Object.keys(lightTheme.shadow) as ShadowToken[];
+const CONTROL_SIZES: ControlSize[] = ["xs", "sm", "md"];
+const BUTTON_VARIANTS = ["default", "secondary", "outline", "ghost", "destructive"] as const;
+const BUTTON_SIZES = ["xs", "sm", "md", "lg"] as const;
