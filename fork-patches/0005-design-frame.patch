+import { useEffect, useState } from "react";
+import { VolumeMeter } from "@/components/volume-meter";
+import { DesignPage, DesignRow, DesignSection, DesignSpecimen } from "@/design/kit";
+import type { DesignDefinition } from "@/design/types";
+
+// The VolumeMeter as it ships today, in every variant and orientation.
+// Speaking and loud feed it a jittered level so the bars move like live input.
+
+interface MeterInput {
+  level: number;
+  isSpeaking: boolean;
+  isMuted: boolean;
+}
+
+const SAMPLE_INTERVAL_MS = 90;
+
+function useSimulatedVolume(level: number): number {
+  const [volume, setVolume] = useState(level);
+  useEffect(() => {
+    if (level === 0) {
+      setVolume(0);
+      return;
+    }
+    const handle = setInterval(() => {
+      const jitter = (Math.random() - 0.5) * level * 0.8;
+      setVolume(Math.min(1, Math.max(0, level + jitter)));
+    }, SAMPLE_INTERVAL_MS);
+    return () => clearInterval(handle);
+  }, [level]);
+  return volume;
+}
+
+function MeterVariants({ level, isSpeaking, isMuted }: MeterInput) {
+  const volume = useSimulatedVolume(level);
+  return (
+    <DesignPage>
+      <DesignSection title="Default" description="Realtime voice overlay size">
+        <DesignRow>
+          <DesignSpecimen label="Horizontal">
+            <VolumeMeter
+              volume={volume}
+              isSpeaking={isSpeaking}
+              isMuted={isMuted}
+              orientation="horizontal"
+            />
+          </DesignSpecimen>
+          <DesignSpecimen label="Vertical">
+            <VolumeMeter
+              volume={volume}
+              isSpeaking={isSpeaking}
+              isMuted={isMuted}
+              orientation="vertical"
+            />
+          </DesignSpecimen>
+        </DesignRow>
+      </DesignSection>
+      <DesignSection title="Compact" description="Dictation and inline size">
+        <DesignRow>
+          <DesignSpecimen label="Horizontal">
+            <VolumeMeter
+              volume={volume}
+              isSpeaking={isSpeaking}
+              isMuted={isMuted}
+              orientation="horizontal"
+              variant="compact"
+            />
+          </DesignSpecimen>
+          <DesignSpecimen label="Vertical">
+            <VolumeMeter
+              volume={volume}
+              isSpeaking={isSpeaking}
+              isMuted={isMuted}
+              orientation="vertical"
+              variant="compact"
+            />
+          </DesignSpecimen>
+        </DesignRow>
+      </DesignSection>
+    </DesignPage>
+  );
+}
+
+function Idle() {
+  return <MeterVariants level={0} isSpeaking={false} isMuted={false} />;
+}
+
+function Speaking() {
+  return <MeterVariants level={0.35} isSpeaking isMuted={false} />;
+}
+
+function Loud() {
+  return <MeterVariants level={0.9} isSpeaking isMuted={false} />;
+}
+
+function Muted() {
+  return <MeterVariants level={0} isSpeaking={false} isMuted />;
+}
+
+const design: DesignDefinition = {
+  title: "Volume meter",
+  states: [
+    { id: "idle", label: "Idle", render: Idle },
+    { id: "speaking", label: "Speaking", render: Speaking },
+    { id: "loud", label: "Loud", render: Loud },
+    { id: "muted", label: "Muted", render: Muted },
+  ],
+};
+
+export default design;
