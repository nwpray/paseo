+#!/usr/bin/env node
+// Design check: flags raw colors, palette.*, literal spacing/type/radius values and
+// useUnistyles() in design-frame files. See docs/design-frame.md.
+//
+// Usage:
+//   npm run design:check                          Check every design in src/design/designs
+//   npm run design:check -- <file> [file...]      Check specific files
+//   npm run design:check -- --json [files...]     Print findings as JSON
+//   npm run design:check -- --help
+//
+// Exits 1 when any finding is reported. Silence one line with a
+// `// design-check-ignore-next-line` comment directly above it.
+//
+// The Metro dev server (EXPO_PUBLIC_PASEO_DESIGN_FRAME=1) also serves this check at
+// GET /__design/check?name=<design> for the frame's Check button.
+
+import { readdir, readFile } from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { checkDesignSource } from "../src/design/check/rules.ts";
+
+const APP_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const DESIGNS_DIR = path.join(APP_ROOT, "src", "design", "designs");
+const DESIGN_NAME_PATTERN = /^[a-z0-9][a-z0-9-]*$/;
+
+const HELP = `design:check — lint design-frame files against the design system
+
+Usage:
+  npm run design:check                         every file in src/design/designs
+  npm run design:check -- <file> [file...]     specific files
+  npm run design:check -- --json [files...]    JSON output
+
+Rules:
+  raw-color          "#hex", rgb(), rgba(), hsl() literals
+  palette            palette.* (raw scale) instead of semantic theme.colors
+  style-literal      numeric padding/margin/gap/fontSize/lineHeight/fontWeight/
+                     borderRadius/borderWidth instead of theme tokens (0 is allowed)
+  icon-size-literal  size={14} instead of theme.iconSize / ICON_SIZE
+  use-unistyles      useUnistyles() (banned by docs/unistyles.md)
+
+Silence one line with // design-check-ignore-next-line above it.`;
+
+export async function listDesignFiles() {
+  const entries = await readdir(DESIGNS_DIR);
+  return entries
+    .filter((entry) => /\.(ts|tsx)$/.test(entry) && !/\.test\./.test(entry))
+    .sort()
+    .map((entry) => path.join(DESIGNS_DIR, entry));
+}
+
+export async function checkDesignFile(file, displayRoot = APP_ROOT) {
+  const source = await readFile(file, "utf8");
+  return { file: path.relative(displayRoot, file), findings: checkDesignSource(source) };
+}
+
+/** Metro middleware handler: GET /__design/check?name=<design>. */
+export async function handleDesignCheckRequest(req, res) {
+  const url = new URL(req.url, "http://localhost");
+  const name = url.searchParams.get("name") ?? "";
+  res.setHeader("Content-Type", "application/json");
+  res.setHeader("Cache-Control", "no-store");
+  if (!DESIGN_NAME_PATTERN.test(name)) {
+    res.statusCode = 400;
+    res.end(JSON.stringify({ error: "Expected ?name=<design-name>" }));
+    return;
+  }
+  const file = path.join(DESIGNS_DIR, `${name}.tsx`);
+  try {
+    res.end(JSON.stringify(await checkDesignFile(file)));
+  } catch {
+    res.statusCode = 404;
+    res.end(JSON.stringify({ error: `No design file for "${name}"` }));
+  }
+}
+
+async function main(argv) {
+  if (argv.includes("--help") || argv.includes("-h")) {
+    console.log(HELP);
+    return 0;
+  }
+  const json = argv.includes("--json");
+  const fileArgs = argv.filter((arg) => !arg.startsWith("--"));
+  const cwd = process.env.INIT_CWD ?? process.cwd();
+  const files =
+    fileArgs.length > 0 ? fileArgs.map((file) => path.resolve(cwd, file)) : await listDesignFiles();
+  const results = await Promise.all(files.map((file) => checkDesignFile(file, cwd)));
+  const total = results.reduce((sum, result) => sum + result.findings.length, 0);
+
+  if (json) {
+    console.log(JSON.stringify(results, null, 2));
+  } else {
+    for (const result of results) {
+      for (const finding of result.findings) {
+        console.log(
+          `${result.file}:${finding.line}:${finding.column}  ${finding.rule}  ${finding.message}`,
+        );
+        console.log(`    ${finding.excerpt}`);
+      }
+    }
+    console.log(
+      total === 0
+        ? `design:check: ${results.length} file(s) clean`
+        : `design:check: ${total} finding(s) in ${results.length} file(s)`,
+    );
+  }
+  return total === 0 ? 0 : 1;
+}
+
+if (import.meta.url === pathToFileURL(process.argv[1] ?? "").href) {
+  process.exitCode = await main(process.argv.slice(2));
+}
