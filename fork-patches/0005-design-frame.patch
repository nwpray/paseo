+import { useMemo } from "react";
+import { Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import { Alert } from "@/components/ui/alert";
+import type { DesignCheckFinding } from "@/design/check/rules";
+
+export interface DesignCheckResult {
+  file: string;
+  findings: DesignCheckFinding[];
+}
+
+export type DesignCheckStatus =
+  | { kind: "idle" }
+  | { kind: "running" }
+  | { kind: "done"; result: DesignCheckResult }
+  | { kind: "error"; message: string };
+
+/** Ask the Metro dev server to run `design:check` on this design's file. */
+export async function runDesignCheck(name: string): Promise<DesignCheckResult> {
+  const response = await fetch(`/__design/check?name=${encodeURIComponent(name)}`);
+  const body = (await response.json()) as Partial<DesignCheckResult> & { error?: string };
+  if (!response.ok || !body.file || !body.findings) {
+    throw new Error(body.error ?? `Check failed with HTTP ${response.status}`);
+  }
+  return { file: body.file, findings: body.findings };
+}
+
+export function DesignCheckPanel({ status }: { status: DesignCheckStatus }) {
+  if (status.kind === "idle" || status.kind === "running") return null;
+  if (status.kind === "error") {
+    return (
+      <View style={styles.panel}>
+        <Alert variant="error" size="sm" title="Check unavailable" description={status.message} />
+      </View>
+    );
+  }
+  const { file, findings } = status.result;
+  if (findings.length === 0) {
+    return (
+      <View style={styles.panel} testID="design-check-result">
+        <Alert
+          variant="success"
+          size="sm"
+          title="Check passed"
+          description={`${file} uses only theme tokens`}
+        />
+      </View>
+    );
+  }
+  return <FindingsAlert file={file} findings={findings} />;
+}
+
+function FindingsAlert({ file, findings }: DesignCheckResult) {
+  const description = useMemo(() => <FindingList findings={findings} />, [findings]);
+  return (
+    <View style={styles.panel} testID="design-check-result">
+      <Alert
+        variant="warning"
+        size="sm"
+        title={`${findings.length} finding${findings.length === 1 ? "" : "s"} in ${file}`}
+        description={description}
+      />
+    </View>
+  );
+}
+
+function FindingList({ findings }: { findings: DesignCheckFinding[] }) {
+  return (
+    <View style={styles.list}>
+      {findings.map((finding) => (
+        <Text key={`${finding.line}:${finding.column}:${finding.rule}`} style={styles.finding}>
+          {finding.line}:{finding.column} {finding.rule} — {finding.message}
+        </Text>
+      ))}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  panel: {
+    paddingHorizontal: theme.spacing[4],
+    paddingTop: theme.spacing[3],
+  },
+  list: {
+    gap: theme.spacing[1],
+  },
+  finding: {
+    color: theme.colors.foregroundMuted,
+    fontFamily: theme.fontFamily.mono,
+    fontSize: theme.fontSize.sm,
+  },
+}));
